{{- /* Antigravity provider settings for T3 Code. antigravity = false renders a
skip. Otherwise this adds providerInstances.antigravity only when that key is
absent. Homebrew installs agy in a later hook, so the first apply can skip and
the next chezmoi apply writes the setting. Do not execute agy. */ -}}
{{- $developer := includeTemplate "developer-settings" . | fromJson -}}
#!/usr/bin/env bash
# bash 3.2+ (stock macOS and current Linux).
# binaryPath is Homebrew's agy wrapper: the agy name in Homebrew's bin directory.
# T3 accepts that wrapper: isAntigravityCli matches a basename of agy or
# antigravity, including a shell script, and fromExternal keeps the launcher
# path. Checked on pingdotgg/t3code main in
# apps/server/src/provider/AntigravityInstallation.ts.
# Do not point binaryPath at a versioned Caskroom file.
# The merge never selects, prints, or sets apiKey or any other secret field.
# An existing providerInstances.antigravity value is left byte for byte.
# Invalid JSON is left untouched.
set -euo pipefail
{{ if not (get $developer "antigravity") }}
printf '%s\n' "Antigravity is turned off (antigravity = false). Skipping the T3 Code provider update. This does not uninstall an existing app or CLI. Remove them with: brew uninstall --cask antigravity antigravity-cli"
exit 0
{{ else }}
tmp=""
err_file=""
# Invoked by the EXIT trap. ShellCheck does not count that as a call.
# shellcheck disable=SC2329
cleanup() {
  if [[ -n "$tmp" ]]; then
    rm -f -- "$tmp"
    tmp=""
  fi
  if [[ -n "$err_file" ]]; then
    rm -f -- "$err_file"
    err_file=""
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

warn() {
  printf 'Warning: %s\n' "$1" >&2
}

skip() {
  printf '%s\n' "$1"
  exit 0
}

brew_bin=""
if [[ -n "${GROUNDWORK_TEST_BREW_BIN:-}" ]]; then
  brew_bin="${GROUNDWORK_TEST_BREW_BIN}"
else
  for candidate in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$candidate" ]]; then
      brew_bin="$candidate"
      break
    fi
  done
  if [[ -z "$brew_bin" ]]; then
    brew_bin="$(command -v brew 2>/dev/null || true)"
  fi
fi

if [[ -z "$brew_bin" || ! -x "$brew_bin" ]]; then
  skip "Skipping Antigravity provider settings because brew is not available, so agy is not at a Homebrew path. The next chezmoi apply will retry."
fi

prefix="$("$brew_bin" --prefix 2>/dev/null || true)"
prefix="${prefix##*$'\n'}"
prefix="${prefix%$'\r'}"
prefix="${prefix%/}"
case "$prefix" in
  /*) ;;
  *)
    skip "Skipping Antigravity provider settings because brew --prefix did not return an absolute path. The next chezmoi apply will retry."
    ;;
esac

agy="${prefix}/bin/agy"
if [[ ! -f "$agy" || ! -x "$agy" ]]; then
  skip "Skipping Antigravity provider settings because agy is not installed at ${agy}. The next chezmoi apply will retry."
fi

if ! command -v jq >/dev/null 2>&1; then
  skip "Skipping Antigravity provider settings because jq is not installed yet. The next chezmoi apply will retry."
fi

t3_home="${T3CODE_HOME:-${HOME}/.t3}"
settings="${t3_home}/userdata/settings.json"

if [[ -L "$settings" ]]; then
  warn "leaving ${settings} unchanged because it is a symbolic link."
  exit 0
fi
if [[ -e "$settings" && ! -f "$settings" ]]; then
  warn "leaving ${settings} unchanged because it is not a regular file."
  exit 0
fi

copy_mode() {
  local mode="" mode_probe=""
  # GNU stat first. GNU stat treats -f as filesystem status and succeeds with
  # the wrong output, so a BSD-first fallback never reaches the real mode.
  for mode_probe in "$(stat -c %a "$1" 2>/dev/null || true)" "$(stat -f %Lp "$1" 2>/dev/null || true)"; do
    if [[ "$mode_probe" =~ ^[0-7]+$ ]]; then
      mode="$mode_probe"
      break
    fi
  done
  if [[ -z "$mode" ]]; then
    return 1
  fi
  chmod "$mode" "$2"
}

# Shell words below are jq programs. $binaryPath is jq's --arg, not a shell expansion.
classify='
if type != "object" then "root"
elif (.providerInstances | type) == "null" then "missing"
elif (.providerInstances | type) != "object" then "providers"
elif (.providerInstances | has("antigravity")) then "present"
else "absent"
end
'

# $binaryPath is jq's --arg, not a shell expansion.
# shellcheck disable=SC2016
merge='
def instance:
  {
    driver: "antigravity",
    enabled: true,
    config: {binaryPath: $binaryPath}
  };
if (.providerInstances | type) == "null" then
  .providerInstances = {antigravity: instance}
elif (.providerInstances | has("antigravity")) then
  error("present")
else
  .providerInstances.antigravity = instance
end
'

# shellcheck disable=SC2016
create='
{
  providerInstances: {
    antigravity: {
      driver: "antigravity",
      enabled: true,
      config: {binaryPath: $binaryPath}
    }
  }
}
'

write_settings() {
  local filter="$1"
  local source="${2-}"
  local dir
  dir="$(dirname -- "$settings")"
  mkdir -p -- "$dir"
  tmp="$(mktemp "${dir}/.settings.json.XXXXXX")"
  if [[ -n "$source" ]]; then
    jq --arg binaryPath "$agy" "$filter" "$source" >"$tmp"
    if ! copy_mode "$source" "$tmp"; then
      warn "leaving ${settings} unchanged because its file mode could not be read."
      exit 0
    fi
  else
    jq -n --arg binaryPath "$agy" "$filter" >"$tmp"
    chmod 600 "$tmp"
  fi
  mv -f -- "$tmp" "$settings"
  tmp=""
}

if [[ ! -e "$settings" ]]; then
  write_settings "$create"
  printf 'Added the Antigravity provider to %s using Homebrew agy.\n' "$settings"
  exit 0
fi

err_file="$(mktemp)"
if ! jq empty "$settings" >/dev/null 2>"$err_file"; then
  if grep -q 'parse error' "$err_file"; then
    warn "leaving ${settings} unchanged because it is not valid JSON."
    exit 0
  fi
  warn "leaving ${settings} unchanged because it could not be read."
  exit 0
fi
rm -f -- "$err_file"
err_file=""

state="$(jq -r "$classify" "$settings")"
case "$state" in
  present)
    printf 'Antigravity provider settings already exist; leaving %s unchanged.\n' "$settings"
    ;;
  absent | missing)
    write_settings "$merge" "$settings"
    printf 'Added the Antigravity provider to %s using Homebrew agy.\n' "$settings"
    ;;
  root | providers)
    warn "leaving ${settings} unchanged because providerInstances.antigravity cannot be added safely."
    ;;
  *)
    warn "leaving ${settings} unchanged because its JSON shape was not recognized."
    ;;
esac
exit 0
{{ end -}}
