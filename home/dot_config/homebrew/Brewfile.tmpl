{{- $developer := includeTemplate "developer-settings" . | fromJson -}}
{{- $headless := false -}}
{{- if hasKey . "headless" }}{{- $headless = .headless -}}{{- end -}}
{{- $gameDev := false -}}
{{- if hasKey . "game_dev" }}{{- $gameDev = .game_dev -}}{{- end -}}
{{- $xcode := false -}}
{{- if hasKey . "xcode" }}{{- $xcode = .xcode -}}{{- end -}}
{{- $beta := false -}}
{{- if hasKey . "beta" }}{{- $beta = .beta -}}{{- end -}}
{{- $localInference := false -}}
{{- if and (hasKey . "local_inference") (kindIs "bool" .local_inference) }}{{- $localInference = .local_inference -}}{{- end -}}
{{- $pwManager := "none" -}}
{{- if hasKey . "password_manager" }}{{- $pwManager = .password_manager -}}{{- end -}}
{{- $terminalMultiplexer := includeTemplate "terminal-multiplexer-selection" (dict "root" . "missing" "tmux") | trim -}}
# Core
brew "git"
brew "gh"
brew "chezmoi"
brew "jq"
brew "yq"
brew "wget"
brew "age"

# Shell UX
# Groundwork owns the interactive shell runtime, not just its config: the same
# zsh family on macOS, Linux, and WSL2, upgraded by update-all like everything
# else it manages. The OS shell stays untouched as a recovery fallback; run
# groundwork-shell-adopt to make this zsh your login shell.
brew "zsh"
brew "starship"
brew "antidote"
brew "fzf"
brew "zoxide"
brew "atuin"

# Modern Unix replacements
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "git-delta"
brew "dust"
brew "duf"
brew "ncdu"                    # interactive disk-usage browser beside `largest`; same keys on macOS, Linux, and WSL
brew "btop"
brew "hyperfine"
brew "tokei"
brew "yazi"                    # visual file browser (the `y` function) over fd/rg/fzf/bat; previews the folder landscape so you stay in the terminal

# Dev workflow
# Keep Herdr available even when tmux is selected; selection controls the
# launcher, not whether the alternate multiplexer is installed.
brew "herdr"
{{ if or (eq $terminalMultiplexer "tmux") (eq $terminalMultiplexer "both") -}}
brew "tmux"
brew "sesh"
brew "tmuxp"
{{- end }}
brew "lazygit"
brew "neovim"
brew "vim"
brew "mise"
brew "uv"
brew "direnv"
brew "shellcheck"
brew "go"
brew "rustup"

# Security / auth
{{ if and (eq .chezmoi.os "darwin") (not $headless) -}}
brew "mas"
{{- end }}
{{ if eq $pwManager "1password" -}}
brew "1password-cli"
{{- else if eq $pwManager "bitwarden" -}}
brew "bitwarden-cli"
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# GNU timeout bounds official CLI installers on desktop and headless Macs.
brew "coreutils"
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
# Colima is the common Mac default. Existing Docker Desktop data is preserved.
{{ if eq (get $developer "docker_backend") "colima" -}}
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "docker-credential-helper"
{{- else if and (not $headless) (eq (get $developer "docker_backend") "docker-desktop") -}}
cask "docker-desktop"
{{- end }}

{{- end }}
{{ if and (eq .chezmoi.os "darwin") $headless -}}
# A headless Mac cannot approve the menu-bar app. This formula conflicts with the desktop cask.
brew "tailscale"
{{- end }}
{{ if eq .chezmoi.os "linux" -}}
brew "tailscale"
{{- end }}

{{ if and (eq .chezmoi.os "darwin") (not $headless) -}}
# macOS desktop apps, fonts, browsers, launchers, and App Store apps
cask "gitup-app"            # GitUp: fast native GUI for visualizing git history
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
{{ if eq $pwManager "1password" -}}
cask "1password"
{{- else if eq $pwManager "bitwarden" -}}
cask "bitwarden"
{{- end }}
cask "karabiner-elements"
cask "tailscale-app"          # standalone app owns its service and MagicDNS integration
brew "defaultbrowser"
# Brave is the managed browser on every desktop Mac. The cask is checksummed,
# and Sparkle owns later updates, so it stays in this Brewfile under
# --require-sha and is not a Homebrew upgrade lane.
{{ includeTemplate "browser-brewfile" . }}
cask "zoom"
cask "slack"
cask "raycast"                # keyboard-first launcher; Quicklinks jump to daily links
mas "Anybox", id: 1593408455  # native bookmarks: menu-bar mode + Anydock profiles (paid; buy in App Store first)
{{ if $xcode -}}
mas "Xcode", id: 497799835    # optional native Apple/iOS development; requires App Store sign-in/ownership
{{- end }}
{{ if and $xcode $beta -}}
brew "xcodes"                 # install/switch Xcode betas from the Apple Developer portal; App Store ships release only. You sign in and pick the version.
{{- end }}
cask "betterdisplay"          # display resolution presets, DDC brightness, layout protection, CLI/Shortcuts integration
{{ if eq .chezmoi.arch "arm64" -}}
cask "vorssaint"              # Apple Silicon menu-bar toolkit. macOS 14 or newer. Omarchy keeps its own bar.
{{- end }}

cask "t3-code@nightly"       # selected T3 Code train; provider sign-in remains local
# Developer desktop apps are installed on every desktop Mac.
cask "claude"
cask "chatgpt"
cask "visual-studio-code"
cask "cursor"
cask "opencode-desktop"
cask "zed"
{{ if get $developer "personal_apps" -}}
cask "obsidian"
{{ if not (and (eq .chezmoi.arch "arm64") $localInference) -}}
cask "ollama-app"            # menu-bar app for Smart Connections. Skipped when local_inference installs the formula; both provide ollama.
{{- end }}
cask "discord"               # communities / gaming / dev servers
cask "whatsapp"              # messaging
cask "iina"                  # modern media player (mpv-backed); plays what QuickTime won't
cask "appcleaner"            # remove plain dragged-in apps and their related files after checking the vendor/Homebrew path first
{{- end }}
{{ if $gameDev -}}
cask "unity-hub"             # optional game-dev track: installs Unity Hub; install Unity 6 LTS inside Hub
{{- end }}
{{- end }}

# Native coding CLIs use checksummed Homebrew artifacts on macOS and Linux,
# including WSL2 and headless setups. Provider authentication remains local.
cask "claude-code@latest"
cask "codex"
cask "grok-build"
brew "opencode"
{{ if and (eq .chezmoi.os "linux") (not $headless) -}}
cask "cursor"
{{- end }}
