{{- $developer := includeTemplate "developer-settings" . | fromJson -}}
{{- $headless := false -}}
{{- if hasKey . "headless" }}{{- $headless = .headless -}}{{- end -}}
{{- $gitFilterRepo := false -}}
{{- if and (hasKey . "git_filter_repo") (kindIs "bool" .git_filter_repo) }}{{- $gitFilterRepo = .git_filter_repo -}}{{- end -}}
{{- $localInference := false -}}
{{- if and (hasKey . "local_inference") (kindIs "bool" .local_inference) }}{{- $localInference = .local_inference -}}{{- end -}}
# Optional packages: wanted, but never worth failing an update over.
#
# Everything in the main Brewfile is required — a failure there means the
# machine is not set up and the run must stop. Nothing in THIS file is depended
# on by anything else, so a failure here is reported and the update still
# succeeds. It is retried on the next apply, so a package that cannot install
# today lands by itself once its blocker clears.
#
# Keep this file small and keep the rule literal: if something else would break
# without it, it belongs in the main Brewfile instead.
{{ if and (eq .chezmoi.os "darwin") (not $headless) (get $developer "personal_apps") -}}
# cliamp: terminal music player, recreational and not part of the agent
# workflow. Two reasons it is optional rather than required:
#
# 1. It is the only third-party tap Groundwork uses. The formula pins a
#    per-platform sha256, so --require-sha still holds, but that pin is
#    authored by the same single maintainer who builds the binary, in a repo
#    they can force-push. A checksum proves transfer integrity, not review.
# 2. The tap publishes no bottle, so Homebrew always builds it from source. On
#    macOS that needs developer tools Homebrew accepts for the running OS, and
#    an Xcode older than the current macOS fails the install outright — which
#    is common right after a major macOS upgrade. A music player must not hold
#    back git, chezmoi, or an editor while that is true.
#
# Its ffmpeg and yt-dlp dependencies are :recommended, so Homebrew installs
# them transitively; they are cliamp's footprint, not separately declared
# Groundwork tools.
tap "bjarneo/cliamp"
brew "cliamp"
{{- end }}
{{ if and (eq .chezmoi.os "darwin") (not $headless) (get $developer "personal_apps") -}}
# GrandPerspective: visual disk-usage map beside `largest` and ncdu on desktop
# Macs. Optional because nothing depends on it and its cask requires macOS 14
# or newer, so an older Mac reports it and the update still succeeds. Turn
# optional personal apps off in groundwork-configure to skip it.
cask "grandperspective"
{{- end }}
{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") $localInference -}}
# Ollama formula: opt-in Apple Silicon local inference. Nothing else depends on
# it, so a failure here is reported and the update still succeeds. The bottle
# does not download model weights. The menu-bar cask is omitted while this
# formula is selected because both provide the ollama command.
brew "ollama"
{{- end }}

{{ if and (eq .chezmoi.os "darwin") $gitFilterRepo -}}
# pipx: per-user installer for the opt-in git-filter-repo history-purge tool
# (groundwork-core docs/history-purge.md). Nothing else depends on it, so a
# failure here is reported and the update still succeeds. The git-filter-repo
# package itself comes from pipx in run_after_23-git-filter-repo.sh.tmpl, not
# from Homebrew, so no brew-installed copy can shadow the checked build.
brew "pipx"
{{- end }}
