{{- $terminalMultiplexer := includeTemplate "terminal-multiplexer-selection" (dict "root" . "missing" "tmux") | trim -}}
{{- $wsl := false -}}
{{- if hasKey .chezmoi "kernel" -}}
{{- if contains "microsoft" (lower (toString (get .chezmoi.kernel "osrelease"))) -}}
{{- $wsl = true -}}
{{- end -}}
{{- end }}
.DS_Store
{{ if or .headless $wsl }}
.local/bin/groundwork-remote-desktop
{{ end }}
{{ if or (ne .chezmoi.os "darwin") .headless }}
Library/**
.config/karabiner/**
vscode-extensions.txt
{{ end }}
{{- $developer := includeTemplate "developer-settings" . | fromJson }}
{{ if or (ne .chezmoi.os "darwin") (ne (get $developer "docker_backend") "colima") }}
.colima/**
{{ end }}
{{ if and (ne $terminalMultiplexer "tmux") (ne $terminalMultiplexer "both") }}
.config/tmux/**
.config/sesh/**
{{ end }}

{{ if or (ne .chezmoi.os "darwin") (ne (get $developer "docker_backend") "colima") }}
.docker/config.json
{{ end }}
