#!/usr/bin/env bash
# FreeTube pin: {{ include ".chezmoitemplates/freetube-release.json" | sha256sum }}
# Desktop Macs install the official FreeTube disk image. Homebrew disabled the
# freetube cask on 2026-09-01 because the app fails its Gatekeeper check:
# upstream does not notarize this open-source build. After the pinned checksum
# matches, this script removes only the com.apple.quarantine attribute from
# FreeTube.app. That bypasses Gatekeeper for this one app.
# It does not read or write ~/Library/Application Support/FreeTube.
# Bump version, URL, and sha256 together in .chezmoitemplates/freetube-release.json.
# version is CFBundleShortVersionString. update-all reruns this script when that
# pin changes. A download or checksum failure warns and leaves setup running; a
# checksum mismatch never mounts or copies the image.
set -euo pipefail
{{ if and (eq .chezmoi.os "darwin") (not .headless) -}}
{{- $release := include ".chezmoitemplates/freetube-release.json" | fromJson -}}
{{- $asset := index $release.assets .chezmoi.arch -}}
{{- if $asset }}
freetube_version={{ printf "%q" $release.version }}
freetube_url={{ printf "%q" $asset.url }}
freetube_sha256={{ printf "%q" $asset.sha256 }}

applications_dir="${GROUNDWORK_APPLICATIONS_DIR:-/Applications}"
dest="${applications_dir}/FreeTube.app"
work=""
mount_point=""
stage=""
previous=""

warn() {
  printf 'Groundwork: %s\n' "$1" >&2
}

clear_quarantine() {
  local target="$1" xattr_status=0 xattr_out
  if ! command -v xattr >/dev/null 2>&1; then
    warn "xattr is required to remove the FreeTube quarantine attribute."
    exit 1
  fi
  # Recursive so nested files lose quarantine too. No other attribute is cleared.
  # xattr exits non-zero when a file has no quarantine attribute; that is success.
  xattr_out="$(xattr -dr com.apple.quarantine "$target" 2>&1)" || xattr_status=$?
  if [[ "$xattr_status" -ne 0 && "$xattr_out" != *"No such xattr"* ]]; then
    warn "FreeTube quarantine could not be removed: ${xattr_out}"
    exit 1
  fi
}

cleanup() {
  if [[ -n "$mount_point" ]]; then
    hdiutil detach "$mount_point" >/dev/null 2>&1 \
      || hdiutil detach "$mount_point" -force >/dev/null 2>&1 \
      || true
    mount_point=""
  fi
  if [[ -n "$stage" && -d "$stage" ]]; then
    rm -rf "$stage"
    stage=""
  fi
  if [[ -n "$previous" && -d "$previous" ]]; then
    if [[ -d "$dest" ]]; then
      rm -rf "$previous"
    else
      mv "$previous" "$dest" || true
    fi
    previous=""
  fi
  if [[ -n "$work" && -d "$work" ]]; then
    rm -rf "$work"
    work=""
  fi
}
trap cleanup EXIT

if [[ -d "$dest" && ! -L "$dest" ]]; then
  installed_version="$(plutil -extract CFBundleShortVersionString raw "${dest}/Contents/Info.plist" 2>/dev/null || true)"
  if [[ "$installed_version" == "$freetube_version" ]]; then
    clear_quarantine "$dest"
    printf 'Groundwork: FreeTube %s is already installed.\n' "$freetube_version"
    exit 0
  fi
fi

if [[ ! -d "$applications_dir" || -L "$applications_dir" ]]; then
  printf 'Groundwork: %s is not an applications directory.\n' "$applications_dir" >&2
  exit 1
fi
if [[ -L "$dest" ]]; then
  printf 'Groundwork: %s is a symlink, so FreeTube was not replaced.\n' "$dest" >&2
  exit 1
fi

case "$freetube_url" in
  https://github.com/FreeTubeApp/FreeTube/releases/download/*) ;;
  *)
    warn "FreeTube URL is not the official GitHub release. Setup will continue without installing it."
    exit 0
    ;;
esac
if [[ ! "$freetube_sha256" =~ ^[0-9a-f]{64}$ ]]; then
  warn "FreeTube pin is not a sha256 checksum. Setup will continue without installing it."
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-freetube.XXXXXX")"
dmg="${work}/FreeTube.dmg"
# Deadline: 15 seconds to connect, 180 seconds for this transfer, three retries.
# Progress is curl's output. Ctrl-C runs the trap, which detaches a mounted
# image and deletes only the temporary download. An existing app stays in place
# until the checksum has matched and the new bundle is ready to replace it.
printf 'Groundwork: downloading FreeTube %s.\n' "$freetube_version"
if ! curl --proto '=https' --proto-redir '=https' --tlsv1.2 \
  --fail --location --retry 3 --retry-delay 2 \
  --connect-timeout 15 --max-time 180 \
  --output "$dmg" \
  "$freetube_url"; then
  warn "FreeTube download failed. Setup will continue, and this install will not retry until the pinned FreeTube release changes."
  exit 0
fi

actual_sha=""
if command -v sha256sum >/dev/null 2>&1; then
  actual_sha="$(sha256sum -- "$dmg" | awk 'NR==1 { print $1 }')"
elif command -v shasum >/dev/null 2>&1; then
  actual_sha="$(shasum -a 256 -- "$dmg" | awk 'NR==1 { print $1 }')"
else
  warn "FreeTube checksum tool is missing. Setup will continue without installing it."
  exit 0
fi
actual_sha="$(printf '%s' "$actual_sha" | tr '[:upper:]' '[:lower:]')"
if [[ "$actual_sha" != "$freetube_sha256" ]]; then
  warn "FreeTube checksum did not match the pinned release. The disk image was not installed."
  exit 0
fi

attach_plist="$(hdiutil attach "$dmg" -readonly -nobrowse -plist)"
mount_point="$(printf '%s\n' "$attach_plist" | awk '
  /<key>mount-point<\/key>/ {
    if (getline) {
      if (match($0, /<string>.*<\/string>/)) {
        print substr($0, RSTART + 8, RLENGTH - 17)
        exit
      }
    }
  }
')"
if [[ -z "$mount_point" || ! -d "$mount_point" ]]; then
  printf 'Groundwork: FreeTube disk image did not mount.\n' >&2
  exit 1
fi
src="${mount_point}/FreeTube.app"
if [[ ! -d "$src" || -L "$src" ]]; then
  printf 'Groundwork: the FreeTube disk image has no FreeTube.app bundle.\n' >&2
  exit 1
fi

stage="$(mktemp -d "${applications_dir}/.freetube-groundwork.XXXXXX")"
ditto "$src" "${stage}/FreeTube.app"
hdiutil detach "$mount_point" >/dev/null 2>&1 \
  || hdiutil detach "$mount_point" -force >/dev/null 2>&1 \
  || true
mount_point=""
if [[ -d "$dest" ]]; then
  previous="${applications_dir}/.freetube-groundwork-previous.$$"
  mv "$dest" "$previous"
fi
mv "${stage}/FreeTube.app" "$dest"
rmdir "$stage" 2>/dev/null || rm -rf "$stage"
stage=""
clear_quarantine "$dest"
printf 'Groundwork: installed FreeTube %s.\n' "$freetube_version"
{{- else }}
printf 'Groundwork: FreeTube has no pinned disk image for this Mac architecture. Setup will continue.\n' >&2
exit 0
{{- end }}
{{ else -}}
exit 0
{{ end -}}
