#!/usr/bin/env bash
set -euo pipefail

# Herdr stays installed and configured so either multiplexer can be selected
# later. Selection affects the launcher only.
# The source path is rendered by chezmoi and is intentionally outside this
# temporary rendered-file matrix.
# shellcheck disable=SC1091
source {{ joinPath .chezmoi.sourceDir "dot_local/lib/groundwork/herdr-config.sh" | quote }}
managed_target="$HOME/.config/herdr/config.toml"
effective_target="$(groundwork_herdr_effective_target)"
if [[ "$effective_target" != "$managed_target" ]]; then
  echo "Groundwork Herdr config: HERDR_CONFIG_PATH or XDG_CONFIG_HOME selects $effective_target." >&2
  echo "Groundwork manages $managed_target. Reconcile the override before applying." >&2
  exit 1
fi
groundwork_herdr_apply_owned \
  "$managed_target" \
  {{ joinPath .chezmoi.sourceDir ".chezmoitemplates/herdr.toml" | quote }} \
  "$HOME/.local/state/groundwork/herdr-config.sha256"
