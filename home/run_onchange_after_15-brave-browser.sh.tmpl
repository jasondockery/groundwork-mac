#!/usr/bin/env bash
# Offer Brave after the Brewfile has installed it. Policies come from
# groundwork-core v0.7.0 (core/browser/brave.json). The desktop render hashes
# that spec so a spec change re-runs this hook. Headless and Linux renders
# do not read it: those trees do not carry the core checkout, and they do
# not offer Brave. update-all sets GROUNDWORK_UPDATE_SCOPE, and --apply then
# writes the profile without prompting; the update runner prints the one notice.
set -euo pipefail
# Password manager: {{ .password_manager }}
# Environment role: {{ .environment_role }}
{{- if and (eq .chezmoi.os "darwin") (not .headless) }}
{{- $specPath := joinPath .chezmoi.workingTree "core/browser/brave.json" }}
# Brave spec hash: {{ output "cat" $specPath | sha256sum }}
if [[ ! -x "$HOME/.local/bin/groundwork-brave-browser" ]]; then
  echo "Groundwork: groundwork-brave-browser is not installed." >&2
  exit 1
fi
# Pass the spec and profile in. chezmoi apply still holds its state lock, so
# this hook must not call chezmoi again.
export GROUNDWORK_BRAVE_SPEC={{ $specPath | quote }}
export GROUNDWORK_BRAVE_PASSWORD_MANAGER={{ .password_manager | quote }}
export GROUNDWORK_BRAVE_ROLE={{ .environment_role | quote }}
export GROUNDWORK_BRAVE_HEADLESS=false
exec "$HOME/.local/bin/groundwork-brave-browser" --apply
{{- else }}
exit 0
{{- end }}
