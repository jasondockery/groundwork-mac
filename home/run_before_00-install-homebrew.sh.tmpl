#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" == Linux ]] && { command -v omarchy >/dev/null 2>&1 || [[ -d /usr/share/omarchy ]]; }; then
  echo "Omarchy owns this environment. Do not apply groundwork-mac here; use its dedicated environment repo." >&2
  exit 1
fi

{{ if .headless -}}
echo "headless profile; skipping Homebrew install."
exit 0
{{- else if eq .chezmoi.os "darwin" -}}
if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
  cat >&2 <<'MSG'
Apple Command Line Tools are not installed yet.

Run:
  xcode-select --install

Then re-run:
  chezmoi apply
MSG
  exit 1
fi

developer_dir="$(/usr/bin/xcode-select -p 2>/dev/null || true)"
if command -v /usr/bin/xcodebuild >/dev/null 2>&1; then
  if ! /usr/bin/xcodebuild -license check >/dev/null 2>&1; then
    license_output="$(/usr/bin/xcodebuild -license check 2>&1 || true)"
    if [[ "$license_output" != *"requires Xcode"* || "$developer_dir" != "/Library/Developer/CommandLineTools" ]]; then
      cat >&2 <<'MSG'
The active Xcode license has not been accepted yet.

Run:
  sudo xcodebuild -license accept

Then re-run:
  chezmoi apply
MSG
      exit 1
    fi
  fi
fi

if ! command -v brew >/dev/null 2>&1 && [[ ! -x /opt/homebrew/bin/brew && ! -x /usr/local/bin/brew ]]; then
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{- else if eq .chezmoi.os "linux" }}
{{ if ne .chezmoi.arch "amd64" -}}
echo "Homebrew unsupported on arm64 Linux; skipping brew install."
exit 0
{{- else }}

if command -v brew >/dev/null 2>&1 || [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  exit 0
fi

if command -v apt-get >/dev/null 2>&1; then
  if [[ "$(id -u)" -eq 0 ]]; then
    apt-get update
    apt-get install -y build-essential procps curl file git
  elif command -v sudo >/dev/null 2>&1; then
    # These packages are required before Homebrew can install. Ask once when
    # someone is here. When nobody is here, stop. Do not continue into the
    # Homebrew installer without them.
    if ! sudo -n true 2>/dev/null; then
      if [[ -r /dev/tty && -w /dev/tty ]] && : </dev/tty >/dev/null; then
        echo "Groundwork: Homebrew's Linux packages need an administrator password."
        echo "Enter your password when asked. This approval covers those packages."
        sudo_status=0
        # sudo -v reads the password on its own standard input. Point that prompt
        # at the terminal. These redirects are not a command run under sudo.
        # shellcheck disable=SC2024
        sudo -v </dev/tty >/dev/tty 2>/dev/tty || sudo_status=$?
        if [[ "$sudo_status" -ne 0 ]]; then
          echo "Groundwork: administrator permission was not granted, so no packages were installed." >&2
          echo "From a terminal on this machine, run chezmoi apply and enter your password when asked." >&2
          exit "$sudo_status"
        fi
      else
        echo "Groundwork: Homebrew's Linux packages need an administrator password, and no terminal is available to ask for it." >&2
        echo "Nothing was installed. From a terminal on this machine, run chezmoi apply and enter your password when asked." >&2
        exit 1
      fi
    fi
    sudo apt-get update
    sudo apt-get install -y build-essential procps curl file git
  else
    echo "Homebrew on Linux needs apt dependencies, but sudo is not available." >&2
    exit 1
  fi
fi

NONINTERACTIVE=1 /bin/bash -c \
  "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end }}
{{- end }}
