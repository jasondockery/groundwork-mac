{{- /* One compatibility boundary for independent developer preferences.
Environment profiles are retired (specs/release-posture.md). A stored work
flag, environment_role=managed, or profile_preset=work-managed is read here
once and never chooses anything new. The legacy seed (personal apps off,
infrastructure extensions on) is replaced by the common defaults. An explicit
divergence is kept. A stored work=true with no git_identity is the old email
selector: record git_identity=work so regeneration does not switch those
commits to the personal address. An explicit git_identity still wins. The
config template stops writing the retired keys, so this runs once. */ -}}
{{- $legacyWork := and (hasKey . "work") .work -}}
{{- $legacyManaged := or $legacyWork (and (hasKey . "environment_role") (eq (toString .environment_role) "managed")) (and (hasKey . "profile_preset") (eq (toString .profile_preset) "work-managed")) -}}
{{- $settings := dict "docker_backend" "colima" "git_identity" "personal" "personal_apps" true "work_extensions" false -}}
{{- range $key := list "docker_backend" "git_identity" "personal_apps" "work_extensions" -}}
{{- if hasKey $ $key -}}
{{- $_ := set $settings $key (index $ $key) -}}
{{- end -}}
{{- end -}}
{{- if and $legacyWork (not (hasKey . "git_identity")) -}}
{{- $_ := set $settings "git_identity" "work" -}}
{{- end -}}
{{- if and $legacyManaged (not (get $settings "personal_apps")) (get $settings "work_extensions") -}}
{{- $_ := set $settings "personal_apps" true -}}
{{- $_ := set $settings "work_extensions" false -}}
{{- end -}}
{{- if not (has (get $settings "docker_backend") (list "colima" "docker-desktop" "none")) -}}
{{- fail "Groundwork: docker_backend must be colima, docker-desktop, or none" -}}
{{- end -}}
{{- if not (has (get $settings "git_identity") (list "personal" "work")) -}}
{{- fail "Groundwork: git_identity must be personal or work" -}}
{{- end -}}
{{- range $key := list "personal_apps" "work_extensions" -}}
{{- if not (kindIs "bool" (get $settings $key)) -}}
{{- fail (printf "Groundwork: %s must be true or false" $key) -}}
{{- end -}}
{{- end -}}
{{- $settings | toJson -}}
