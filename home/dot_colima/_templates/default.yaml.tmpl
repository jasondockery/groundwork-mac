# Colima default template: used by `colima start` when creating a NEW
# instance. Use `colima start --edit` for an existing instance; deleting it
# destroys that instance's container data. See docs/docker-desktop-to-colima.md.
#
# Settings that differ from Colima's defaults are pinned, each with a reason.
# runtime and disk match those defaults and are still pinned: Colima reads this
# file as the whole configuration for a new instance, so an omitted key arrives
# empty or zero instead of the default. Containers should run at native speed:
# vz is Apple's virtualization framework (faster, lower energy than qemu),
# virtiofs is the fastest bind-mount option, and Rosetta, when it is already
# installed, accelerates the rare amd64-only image on Apple Silicon instead of
# falling back to QEMU.
# Pinned explicitly, not left to fall back. An omitted runtime is read as an
# empty one and `colima start` fails with "unsupported container runtime ''"
# rather than defaulting to docker.
runtime: docker
# Pinned to Colima's normal default: an omitted disk is read as 0 and creates a 0-byte data disk.
disk: 100
vmType: vz
mountType: virtiofs
mountInotify: true
{{ if eq .chezmoi.arch "arm64" -}}
{{ if stat "/Library/Apple/usr/libexec/oah/libRosettaRuntime" -}}
rosetta: true
{{ else -}}
# Rosetta is not installed, so rosetta is omitted. Colima warns on every start when rosetta is true and Rosetta is absent.
{{ end -}}
{{ end -}}
# Sized per machine at apply time: half the cores (a cap, not a
# reservation, so generous is fine), and a third of RAM clamped to 4-12 GB
# (VM memory is largely held once used, so this one stays conservative).
{{- $cores := output "sysctl" "-n" "hw.ncpu" | trim | atoi }}
{{- $memGiB := div (output "sysctl" "-n" "hw.memsize" | trim | atoi) 1073741824 }}
cpu: {{ max 2 (div $cores 2) }}
memory: {{ min 12 (max 4 (div $memGiB 3)) }}

# Engine (daemon.json) settings Colima applies inside the VM. Both cap
# unbounded disk growth — the two classic "Docker filled my disk" causes:
# the default json-file log driver never rotates, and build cache grows
# forever without a GC ceiling.
docker:
  log-driver: local
  builder:
    gc:
      enabled: true
      defaultKeepStorage: 20GB
