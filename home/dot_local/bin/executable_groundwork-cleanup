#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

usage() {
  cat <<'EOF'
Report or run Groundwork's supported package-manager maintenance.

Usage:
  groundwork-cleanup                read-only report; change no persistent state
  groundwork-cleanup --yes          run Homebrew and npm maintenance, plus pnpm when due
  groundwork-cleanup --yes --force  exceptional: attempt Homebrew/npm and every eligible pnpm candidate now
  groundwork-cleanup --yes --clear-pending <stage>
                                    acknowledge one unrepairable reminder only
  groundwork-cleanup -h|--help      show this help

Automatic maintenance is deliberately narrow:
  Homebrew  brew autoremove; brew cleanup --prune=all
  npm       npm cache verify
  pnpm      pnpm store prune for trusted stores selected by exact repository
            packageManager pins discovered through groundwork-repos

pnpm uses one machine-wide cadence: no recorded success, 30 days since the
last success, a pending repair, or a 20 GiB high-water threshold after a
seven-day attempt floor. A successful no-op advances that cadence.

Repository dependency installations such as node_modules are not modified.
Homebrew may remove installed orphan formula dependencies through autoremove;
requested formulae and casks are retained. Whole pnpm store generations,
custom untrusted stores, Docker data, Xcode data, and application or user data
are never deleted by this command.

Cleanup probes pnpm with networking and download prompts disabled. An uncached
Corepack version is review-only, not a VPN/router test. Records whose whole
store context matches (Corepack context, exact pin, filesystem, store
environment, pnpm configuration files, and lockfiles) share one observation,
and acting mode keeps exact-pin observations for later runs under
$XDG_STATE_HOME/groundwork. A run that may prune on cadence re-probes. Discovery
runs a bounded number of probes in parallel under one cumulative deadline and
reports progress. If it cannot finish, pnpm store
cleanup is skipped for that run with a warning: no store is touched, no repair
is recorded, and the next run tries again. Completed records keep their review
notes and private probe diagnostics. After three consecutive incomplete runs,
the skip also becomes an owner-review item. Discovery never lets Corepack or
mise download or install a tool.

Every observation is bounded. Each mutating package-manager command runs in
its own process group with a hard deadline, visible heartbeat, and cancellation
of that process tree.

update-all runs the --yes mode automatically after configuration and any
Homebrew upgrade complete successfully. A mise failure remains a final error
but does not suppress independent package-manager maintenance. Use --yes for a
maintenance-only retry without repeating upgrades. Use --force only to ignore
pnpm cadence deliberately, and update-all --skip-maintenance only for an
exceptional fast refresh.
EOF
}

act=0
force=0
clear_pending_stage=""
nested_update_transaction=0
while (($#)); do
  case "$1" in
    --yes) act=1 ;;
    --force) force=1 ;;
    --clear-pending)
      if [[ "$#" -lt 2 || "$2" == -* ]]; then
        echo "groundwork-cleanup: --clear-pending requires a stage." >&2
        exit 64
      fi
      clear_pending_stage="$2"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "groundwork-cleanup: unknown option: $1" >&2
      echo "Run 'groundwork-cleanup --help' for usage." >&2
      exit 64
      ;;
    *)
      echo "groundwork-cleanup: unexpected argument: $1 (this command takes no positional arguments)" >&2
      exit 64
      ;;
  esac
  shift
done
if [[ "$force" -eq 1 && "$act" -ne 1 ]]; then
  echo "groundwork-cleanup: --force requires --yes." >&2
  exit 64
fi
if [[ -n "$clear_pending_stage" ]]; then
  case "$clear_pending_stage" in
    homebrew | npm | pnpm | maintenance-helper) ;;
    *)
      echo "groundwork-cleanup: unsupported pending stage: $clear_pending_stage" >&2
      echo "Choose homebrew, npm, pnpm, or maintenance-helper." >&2
      exit 64
      ;;
  esac
  if [[ "$act" -ne 1 ]]; then
    echo "groundwork-cleanup: --clear-pending requires --yes." >&2
    exit 64
  fi
  if [[ "$force" -eq 1 ]]; then
    echo "groundwork-cleanup: --clear-pending cannot be combined with --force." >&2
    exit 64
  fi
fi

cleanup_receipt_fd="${GROUNDWORK_CLEANUP_RECEIPT_FD:-}"
if [[ -n "$cleanup_receipt_fd" ]]; then
  if [[ ! "$cleanup_receipt_fd" =~ ^[3-9]$ ||
    "${GROUNDWORK_UPDATE_LOCK_HELD:-}" != "1" ]]; then
    echo "groundwork-cleanup: the internal update receipt channel is invalid." >&2
    exit 64
  fi
fi

state_dir="$HOME/.local/state/groundwork"
pending_dir="$state_dir/update-all-pending"
pnpm_success="$state_dir/pnpm-prune-last-success"
pnpm_attempt="$state_dir/pnpm-prune-last-attempt"
pnpm_discovery_incomplete_runs="$state_dir/pnpm-discovery-incomplete-runs"
legacy_pending="$state_dir/homebrew-cleanup-pending"
deadline="${GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS:-1800}"
observe_deadline="${GROUNDWORK_MAINTENANCE_OBSERVE_DEADLINE_SECONDS:-120}"
discovery_deadline="${GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS:-120}"
discovery_jobs="${GROUNDWORK_PNPM_DISCOVERY_JOBS:-4}"
heartbeat="${GROUNDWORK_MAINTENANCE_HEARTBEAT_SECONDS:-60}"
cancel_grace="${GROUNDWORK_MAINTENANCE_CANCEL_GRACE_SECONDS:-2}"
poll_seconds="${GROUNDWORK_MAINTENANCE_POLL_SECONDS:-1}"
orphan_grace="${GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS:-5}"
monthly_days="${GROUNDWORK_PNPM_PRUNE_DAYS:-30}"
high_water_gib="${GROUNDWORK_PNPM_HIGH_WATER_GIB:-20}"
high_water_retry_days="${GROUNDWORK_PNPM_HIGH_WATER_RETRY_DAYS:-7}"

for numeric_setting in "$deadline" "$observe_deadline" "$discovery_deadline" "$discovery_jobs" "$heartbeat" "$cancel_grace" "$orphan_grace" "$monthly_days" \
  "$high_water_gib" "$high_water_retry_days"; do
  if [[ ! "$numeric_setting" =~ ^[0-9]+$ || "$numeric_setting" -lt 1 ]]; then
    echo "groundwork-cleanup: maintenance deadlines, cadence, and thresholds must be positive integers." >&2
    exit 64
  fi
done
if [[ "$discovery_jobs" -gt 16 ]]; then
  echo "groundwork-cleanup: pnpm discovery parallelism must be between 1 and 16." >&2
  exit 64
fi
if ! awk -v value="$poll_seconds" \
  'BEGIN { exit !(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 0.05 && value <= 1) }'; then
  echo "groundwork-cleanup: maintenance polling must be between 0.05 and 1 second." >&2
  exit 64
fi

maintenance_runner_lib="$HOME/.local/share/groundwork/lib/maintenance-runner.sh"
if [[ ! -r "$maintenance_runner_lib" ]]; then
  echo "groundwork-cleanup: the bounded maintenance runner is missing: $maintenance_runner_lib" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$maintenance_runner_lib"

store_selections=""
store_candidates=""
review_records=""
repository_records=""
group_records=""
probe_dir=""
discovery_cache_temporary=""
cleanup_exit() {
  local status=$?
  if type groundwork_lock_release >/dev/null 2>&1; then
    groundwork_lock_release || true
  fi
  [[ -z "$store_selections" ]] || rm -f -- "$store_selections" || true
  [[ -z "$store_candidates" ]] || rm -f -- "$store_candidates" || true
  [[ -z "$review_records" ]] || rm -f -- "$review_records" || true
  [[ -z "$repository_records" ]] || rm -f -- "$repository_records" || true
  [[ -z "$group_records" ]] || rm -f -- "$group_records" || true
  [[ -z "$probe_dir" ]] || rm -rf -- "$probe_dir" || true
  [[ -z "$discovery_cache_temporary" ]] || rm -f -- "$discovery_cache_temporary" || true
  exit "$status"
}
trap cleanup_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "$act" -eq 1 ]]; then
  lock_lib="$HOME/.local/lib/groundwork/update-lock.sh"
  if [[ ! -r "$lock_lib" ]]; then
    echo "groundwork-cleanup: the update lock helper is missing: $lock_lib" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$lock_lib"
  cleanup_operation="groundwork-cleanup --yes"
  if [[ -n "$clear_pending_stage" ]]; then
    cleanup_operation="$cleanup_operation --clear-pending $clear_pending_stage"
  elif [[ "$force" -eq 1 ]]; then
    cleanup_operation="$cleanup_operation --force"
  fi
  groundwork_lock_acquire "$cleanup_operation" || exit $?
  if [[ "${GROUNDWORK_UPDATE_LOCK_HELD:-}" == "1" &&
    "${groundwork_lock_owned:-0}" -eq 0 ]]; then
    nested_update_transaction=1
  fi
  if [[ -n "$cleanup_receipt_fd" ]]; then
    if [[ "$nested_update_transaction" -ne 1 ]] \
      || ! { : >&"$cleanup_receipt_fd"; } 2>/dev/null; then
      echo "groundwork-cleanup: the internal update receipt channel is unavailable." >&2
      exit 1
    fi
  fi
fi

if [[ -n "$clear_pending_stage" ]]; then
  pending_file="$pending_dir/$clear_pending_stage"
  if [[ ! -f "$pending_file" ]]; then
    echo "Groundwork: no pending $clear_pending_stage reminder is recorded; nothing changed."
    exit 0
  fi
  IFS= read -r pending_message <"$pending_file" || pending_message="repair state was recorded"
  mkdir -p "$state_dir"
  printf '%s stage=%q message=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$clear_pending_stage" "owner cleared reminder without running maintenance: $pending_message" \
    >>"$state_dir/update-all-pending-cleared.log"
  rm -f -- "$pending_file"
  rmdir "$pending_dir" 2>/dev/null || true
  printf 'Groundwork: cleared the %s reminder only.\n' "$clear_pending_stage"
  printf '  Recorded failure: %s\n' "$pending_message"
  echo "  No package-manager maintenance was performed; the audit note was preserved."
  exit 0
fi

store_selections="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-selections.XXXXXX")"
store_candidates="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-candidates.XXXXXX")"
review_records="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-review.XXXXXX")"
repository_records="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-repositories.XXXXXX")"
group_records="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-group.XXXXXX")"
probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-cleanup-probes.XXXXXX")"
: >"$probe_dir/errors"

format_bytes() {
  if [[ -z "$1" ]]; then
    printf 'unavailable\n'
    return
  fi
  awk -v bytes="$1" 'BEGIN {
    split("B KiB MiB GiB TiB", unit, " ")
    index_ = 1
    while (bytes >= 1024 && index_ < 5) { bytes /= 1024; index_++ }
    if (index_ == 1) printf "%d %s\n", bytes, unit[index_]
    else printf "%.1f %s\n", bytes, unit[index_]
  }'
}

canonical_dir() {
  cd "$1" 2>/dev/null && pwd -P
}

dir_bytes() {
  local path="$1" output blocks status=0
  [[ -d "$path" ]] || {
    printf '0\n'
    return 0
  }
  output="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-du.XXXXXX")"
  run_bounded_capture "measure $path" "$output" du -skH "$path" || status=$?
  if [[ "$status" -ne 0 ]]; then
    rm -f -- "$output"
    return "$status"
  fi
  blocks="$(awk 'NR == 1 {print $1}' "$output")"
  rm -f -- "$output"
  [[ "$blocks" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$((blocks * 1024))"
}

capture_dir_bytes() {
  local destination="$1" path="$2" pending_stage="${3:-}" value="" status=0
  value="$(dir_bytes "$path")" || status=$?
  case "$status" in
    125 | 129 | 130 | 143)
      if [[ -n "$pending_stage" ]]; then
        if [[ "$status" -eq 125 ]]; then
          mark_pending "$pending_stage" \
            "$pending_stage command completed, but its measurement process tree could not be fully stopped; final receipt was not completed"
        else
          mark_pending "$pending_stage" \
            "$pending_stage command completed, but post-maintenance measurement was interrupted (exit $status); final receipt was not completed"
        fi
      fi
      exit "$status"
      ;;
  esac
  printf -v "$destination" '%s' "$value"
  return "$status"
}

state_age_days() {
  local now recorded first
  [[ -f "$1" ]] || {
    printf '%s\n' "-1"
    return
  }
  IFS= read -r recorded <"$1" || recorded=""
  first="${recorded%% *}"
  [[ "$first" =~ ^[0-9]+$ ]] || {
    printf '%s\n' "-1"
    return
  }
  now="$(date +%s)"
  if [[ "$first" -le 0 || "$now" -lt "$first" ]]; then
    printf '%s\n' "-1"
  else
    printf '%s\n' "$(((now - first) / 86400))"
  fi
}

write_state() {
  local path="$1" value="${2:-}" temporary
  mkdir -p "$(dirname "$path")"
  temporary="${path}.tmp.$$"
  printf '%s\n' "$value" >"$temporary"
  mv -f -- "$temporary" "$path"
}

mark_pending() {
  local stage="$1" message="$2"
  write_state "$pending_dir/$stage" "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $message"
}

clear_pending() {
  rm -f -- "$pending_dir/$1"
  rmdir "$pending_dir" 2>/dev/null || true
}

has_pending() {
  local pending_file
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/*; do
    [[ -f "$pending_file" ]] && return 0
  done
  return 1
}

# The read-only report lists every pending file. Failure ignores only the two
# upgrade retries that share this directory: mac-app-store and homebrew-upgrade.
# Every other filename, including one this helper does not recognize, is
# package-manager maintenance.
package_manager_pending() {
  local pending_file stage
  [[ -f "$legacy_pending" ]] && return 0
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/*; do
    [[ -f "$pending_file" ]] || continue
    stage="${pending_file##*/}"
    case "$stage" in
      mac-app-store | homebrew-upgrade) ;;
      *) return 0 ;;
    esac
  done
  return 1
}

append_review() {
  printf '%s\t%s\n' "$1" "$2" >>"$review_records"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

has_terminal_control() {
  [[ "$(LC_ALL=C printf '%s' "$1" | tr -d '[:cntrl:]')" != "$1" ]]
}

expand_home() {
  local value="$1"
  # shellcheck disable=SC2088,SC2016
  case "$value" in
    "~") value="$HOME" ;;
    "~/"*) value="$HOME/${value#\~/}" ;;
    '$HOME') value="$HOME" ;;
    '$HOME/'*) value="$HOME/${value#\$HOME/}" ;;
  esac
  printf '%s' "$value"
}

trusted_store_roots=(
  "$HOME/Library/pnpm/store"
)
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
if [[ "$data_home" == /* ]]; then
  trusted_store_roots+=("$data_home/pnpm/store")
else
  append_review "XDG_DATA_HOME" "must be absolute before its pnpm store can be trusted automatically: $data_home"
fi
if [[ -n "${PNPM_HOME:-}" ]]; then
  if [[ "$PNPM_HOME" == /* ]]; then
    trusted_store_roots+=("$PNPM_HOME/store")
  else
    append_review "PNPM_HOME" "must be absolute before its pnpm store can be trusted automatically: $PNPM_HOME"
  fi
fi
parse_trusted_roots() {
  local file="$1" line key value expanded
  [[ -f "$file" ]] || return 0
  # review_records is a separate mktemp file; ShellCheck cannot see through
  # append_review and otherwise assumes it might append to this input file.
  # shellcheck disable=SC2094
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" == *=* ]] || continue
    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    [[ "$key" == "trusted_pnpm_store_root" && -n "$value" ]] || continue
    if has_terminal_control "$value"; then
      echo "groundwork-cleanup: ignored a trusted pnpm store root containing a control character." >&2
      append_review "$file" "trusted_pnpm_store_root contains a terminal control character and was ignored"
      continue
    fi
    expanded="$(expand_home "$value")"
    if [[ "$expanded" != /* ]]; then
      echo "groundwork-cleanup: ignored a relative trusted pnpm store root: $value" >&2
      append_review "$file" "trusted_pnpm_store_root must be absolute after home expansion: $value"
      continue
    fi
    trusted_store_roots+=("$expanded")
  done <"$file"
}

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
parse_trusted_roots "$config_home/groundwork/repos.conf"
parse_trusted_roots "$config_home/groundwork/repos.local.conf"

trusted_store_base() {
  local store="$1" root canonical_root parent generation seen=$'\n'
  parent="$(dirname "$store")"
  generation="$(basename "$store")"
  [[ "$generation" =~ ^v[0-9]+$ ]] || return 1
  for root in "${trusted_store_roots[@]}"; do
    [[ -d "$root" ]] || continue
    canonical_root="$(canonical_dir "$root" || true)"
    [[ -n "$canonical_root" ]] || continue
    case "$seen" in *$'\n'"$canonical_root"$'\n'*) continue ;; esac
    seen="$seen$canonical_root"$'\n'
    if [[ "$parent" == "$canonical_root" ]]; then
      printf '%s\n' "$canonical_root"
      return 0
    fi
  done
  return 1
}

# Offline discovery may launch pnpm through a mise shim or `mise exec`, and runs
# several probes at once. Neither Corepack nor mise may download or install a
# missing tool while it only observes.
offline_probe_env=(env COREPACK_ENABLE_NETWORK=0 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
  MISE_OFFLINE=1 MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0
  MISE_NOT_FOUND_AUTO_INSTALL=0 MISE_TASK_RUN_AUTO_INSTALL=0)

pnpm_store_path_at() {
  cd "$1"
  exec "${offline_probe_env[@]}" pnpm store path
}

pnpm_version_at() {
  cd "$1"
  exec "${offline_probe_env[@]}" pnpm --version
}

mise_npm_path_at_home() {
  cd "$HOME"
  exec mise which npm
}

npm_cache_with_mise() {
  cd "$HOME"
  exec mise exec -- npm config get cache
}

npm_cache_from_path() {
  cd "$HOME"
  exec npm config get cache
}

brew_cache_at_home() {
  cd "$HOME"
  exec brew --cache
}

observed_cache_path() {
  local file="$1" base="$2" label="$3" line_count value resolved canonical
  line_count="$(awk 'END {print NR + 0}' "$file")"
  if [[ "$line_count" -ne 1 ]]; then
    echo "groundwork-cleanup: $label cache query returned an unsupported multi-line value; size is unavailable." >&2
    return 1
  fi
  value="$(<"$file")"
  if [[ -z "$value" ]] || has_terminal_control "$value"; then
    echo "groundwork-cleanup: $label cache query returned an empty or control-bearing path; size is unavailable." >&2
    return 1
  fi
  value="$(expand_home "$value")"
  if [[ "$value" == /* ]]; then
    resolved="$value"
  else
    resolved="$base/$value"
  fi
  if has_terminal_control "$resolved"; then
    echo "groundwork-cleanup: $label cache path is unsafe to display; size is unavailable." >&2
    return 1
  fi
  canonical="$(canonical_dir "$resolved" || true)"
  if [[ -n "$canonical" ]]; then
    resolved="$canonical"
  fi
  printf '%s\n' "$resolved"
}

# Run in each record's directory, inside mise's environment when a shim
# launches pnpm. The first record holds the context paths; every exported
# variable follows, separated by \036. The variables only stream through a pipe
# to awk and a hash: they can hold credentials, so they are never stored.
# shellcheck disable=SC2016 # Expanded by the child shell.
pnpm_context_script='printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\036" "${COREPACK_HOME+x}:${COREPACK_HOME-}" "${XDG_CACHE_HOME+x}:${XDG_CACHE_HOME-}" "${LOCALAPPDATA+x}:${LOCALAPPDATA-}" "$HOME" "${COREPACK_ENV_FILE+x}:${COREPACK_ENV_FILE-}" "$(command -v pnpm)" "$(command -v node || true)" "${PNPM_HOME+x}:${PNPM_HOME-}" "${XDG_DATA_HOME+x}:${XDG_DATA_HOME-}" "${XDG_CONFIG_HOME+x}:${XDG_CONFIG_HOME-}"
# Bash cannot read a variable whose name is not an identifier; an npm or pnpm
# setting spelled that way is reported as unreadable, which refuses sharing.
if env | LC_ALL=C grep -iqE "^(npm|pnpm)_config_[^=]*[^A-Za-z0-9_=][^=]*="; then
  printf "unreadable\036"
fi
names="$(compgen -e)" || exit 1
for name in $names; do
  case "$name" in PWD | OLDPWD | SHLVL | _) continue ;; esac
  printf "%s=%s\036" "$name" "${!name}"
done'

# Read the context stream. The context file receives the paths line, the share
# verdict and the effective npm prefix; stdout
# receives hash material only: npm and pnpm configuration variables (including
# credentials, so they are hashed, not stored) and every variable whose value
# differs from this process's, which is what a per-directory mise [env] adds.
# Run this under offline_probe_env so the switches discovery itself injects
# compare equal.
# shellcheck disable=SC2016 # An awk program, not shell.
context_stream_awk='BEGIN { RS = "\036"; share = 1; environment_prefix = ""; config_prefix = "" }
NR == 1 { print > context; next }
{
  eq = index($0, "=")
  if (eq < 2) { share = 0; next }
  name = substr($0, 1, eq - 1)
  value = substr($0, eq + 1)
  # One line per entry for sort; the separator byte keeps embedded newlines distinct.
  hashed = value
  gsub(/\n/, "\035", hashed)
  seen[name] = 1
  lower = tolower(name)
  if (lower ~ /^(npm|pnpm)_config_/ || lower == "prefix") {
    print "config " name "=" hashed
    setting = lower
    sub(/^(npm|pnpm)_config_/, "", setting)
    gsub(/-/, "_", setting)
    if (setting ~ /^(userconfig|globalconfig|global_dir|workspace_dir|pnpmfile|global_pnpmfile)$/) share = 0
    if (setting == "store_dir" && (value !~ /^\// || value ~ /\$\{/)) share = 0
    if (lower == "prefix") environment_prefix = value
    else if (setting == "prefix") {
      if (config_prefix != "" && config_prefix != value) share = 0
      config_prefix = value
    }
  }
  if (lower == "destdir") share = 0
  if (name !~ /^__MISE_/ && (!(name in ENVIRON) || ENVIRON[name] != value)) print "directory " name "=" hashed
}
END {
  for (name in ENVIRON) {
    if (name in seen || name ~ /^__MISE_/) continue
    if (name == "PWD" || name == "OLDPWD" || name == "SHLVL" || name == "_" || name ~ /^AWK/) continue
    print "unset " name
  }
  if (environment_prefix != "" && config_prefix != "" && environment_prefix != config_prefix) share = 0
  prefix = config_prefix != "" ? config_prefix : environment_prefix
  if (prefix ~ /\n/) share = 0
  print "share " share > context
  print "prefix " prefix > context
}'

sha256_stream() {
  local digest
  case "$sha256_tool" in
    shasum) digest="$(shasum -a 256)" || return 1 ;;
    sha256sum) digest="$(sha256sum)" || return 1 ;;
    *) return 1 ;;
  esac
  digest="${digest%% *}"
  [[ "$digest" =~ ^[0-9a-f]+$ && "${#digest}" -eq 64 ]] || return 1
  printf '%s\n' "$digest"
}

path_device() {
  case "$stat_device_style" in
    gnu) stat -c %d "$1" ;;
    bsd) stat -f %d "$1" ;;
    *) return 1 ;;
  esac
}

# One store-selection input: absent, or a readable regular file whose store-dir
# settings are all literal absolute paths. A record never shares when its store
# could depend on something not fingerprinted here: a relative or computed
# store-dir, any configured pnpmfile or global-pnpmfile (pnpm runs their
# updateConfig hooks even for `store path`), configDependencies (their plugin
# pnpmfiles load the same way), a userconfig/globalconfig redirect, or a
# prefix setting (pnpm 10 and earlier derive global paths from it).
# Lockfiles configure nothing, so they are only hashed. A manifest is not
# hashed, because branches edit scripts and dependencies without changing
# store selection; any such setting mentioned in it refuses sharing.
# The label is location-independent for the record's own files and the
# absolute path for a shared ancestor's.
fingerprint_input() {
  local path="$1" kind="$2" label="$3" digest
  [[ -e "$path" || -L "$path" ]] || return 0
  [[ -f "$path" && -r "$path" ]] || return 1
  if [[ "$kind" == manifest ]]; then
    if grep -qiE 'store[-_]?dir|pnpmfile|configdependencies|userconfig|globalconfig' "$path"; then
      return 1
    fi
    return 0
  fi
  if [[ "$kind" == config ]]; then
    awk '
      { line = tolower($0) }
      line ~ /pnpmfile|configdependencies|userconfig|globalconfig/ { exit 1 }
      line ~ /^[[:space:]]*["\047]?prefix["\047]?[[:space:]]*[=:]/ { exit 1 }
      line ~ /store[-_]?dir/ {
        if (line !~ /^[[:space:]]*["\047]?store[-_]?dir["\047]?[[:space:]]*[=:][[:space:]]*["\047]?\// || line ~ /\$\{/) exit 1
      }' "$path" || return 1
  fi
  digest="$(sha256_stream <"$path")" || return 1
  printf '%s %s %s\n' "$kind" "$label" "$digest"
}

# Hash every file under a pnpm global configuration directory, following links;
# an entry that is not a readable regular file refuses sharing.
fingerprint_directory() {
  local directory="$1" listing entry
  [[ -e "$directory" || -L "$directory" ]] || return 0
  [[ -d "$directory" ]] || return 1
  listing="$(find -L "$directory" ! -type d -print 2>/dev/null | LC_ALL=C sort)" || return 1
  [[ -n "$listing" ]] || return 0
  while IFS= read -r entry; do
    [[ -e "$entry" || -L "$entry" ]] || return 1
    fingerprint_input "$entry" config "$entry" || return 1
  done <<<"$listing"
}

# Follow symlinks to the file npm sees as process.execPath; fail on a loop.
resolve_links() {
  local path="$1" target count=0
  while [[ -L "$path" ]]; do
    count=$((count + 1))
    [[ "$count" -le 16 ]] || return 1
    target="$(readlink "$path")" || return 1
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  printf '%s\n' "$path"
}

# Everything pnpm consults when it chooses a store, plus the exact pin (in the
# artifact key) and every lockfile from the record up to /: the user and npm
# global config files, every file in the pnpm config directories, the repo's
# writability, and the hashed environment. Records with the same key
# resolve the same store and version, so one observation serves all.
store_dedupe_key_at() {
  local repo="$1" artifact_key="$2" context_home="$3" config_home="$4" node="$5" context="$6" material="$7"
  local environment_digest directory name device label prefix resolved node_prefix
  device="$(path_device "$repo")" || return 1
  [[ "$device" =~ ^[0-9]+$ ]] || return 1
  environment_digest="$(sed -n 's/^environment //p' "$context")"
  [[ -n "$environment_digest" ]] || return 1
  prefix="$(sed -n 's/^prefix //p' "$context")"
  if [[ -n "$prefix" && "$prefix" != /* ]]; then
    return 1
  fi
  resolved="$(resolve_links "$node")" || return 1
  node_prefix="$(canonical_dir "$(dirname "$resolved")")" || return 1
  node_prefix="$(dirname "$node_prefix")"
  {
    printf 'groundwork pnpm store context v3\n%s\ndevice %s\nenvironment %s\n' \
      "$artifact_key" "$device" "$environment_digest"
    if [[ -w "$repo" ]]; then
      printf 'writable 1\n'
    else
      printf 'writable 0\n'
    fi
    directory="$repo"
    while :; do
      # pnpm loads a default pnpmfile and installed config-dependency plugin
      # pnpmfiles from the lockfile or workspace directory; either refuses.
      [[ ! -e "$directory/.pnpmfile.cjs" && ! -L "$directory/.pnpmfile.cjs" ]] || return 1
      [[ ! -e "$directory/.pnpmfile.mjs" && ! -L "$directory/.pnpmfile.mjs" ]] || return 1
      [[ ! -e "$directory/node_modules/.pnpm-config" && ! -L "$directory/node_modules/.pnpm-config" ]] || return 1
      if [[ -e "$directory/pnpm-workspace.yaml" || -L "$directory/pnpm-workspace.yaml" ]]; then
        # Workspace membership of a nested record depends on its path, and a
        # workspace file can include other YAML files (pnpm 12.15+) that may
        # carry storeDir; neither is fingerprinted, so both refuse.
        [[ "$directory" == "$repo" ]] || return 1
        [[ -f "$directory/pnpm-workspace.yaml" && -r "$directory/pnpm-workspace.yaml" ]] || return 1
        if grep -qi 'include' "$directory/pnpm-workspace.yaml"; then
          return 1
        fi
      fi
      for name in .npmrc pnpm-workspace.yaml package.json pnpm-lock.yaml; do
        label="$directory/$name"
        [[ "$directory" != "$repo" ]] || label="record/$name"
        case "$name" in
          pnpm-lock.yaml) fingerprint_input "$directory/$name" lockfile "$label" || return 1 ;;
          package.json) fingerprint_input "$directory/$name" manifest "$label" || return 1 ;;
          *) fingerprint_input "$directory/$name" config "$label" || return 1 ;;
        esac
      done
      [[ "$directory" != / ]] || break
      directory="$(dirname "$directory")"
    done
    # The user config applies even when the record is outside HOME.
    fingerprint_input "$context_home/.npmrc" config "$context_home/.npmrc" || return 1
    # npm's global config lives under its prefix: an explicit one, else two
    # levels above node, both as launched and as resolved.
    for directory in "$(dirname "$(dirname "$node")")" "$node_prefix" ${prefix:+"$prefix"}; do
      fingerprint_input "$directory/etc/npmrc" config "$directory/etc/npmrc" || return 1
    done
    fingerprint_directory "$config_home/pnpm" || return 1
    fingerprint_directory "$context_home/Library/Preferences/pnpm" || return 1
  } >"$material" || return 1
  sha256_stream <"$material"
}

# Write this record's Corepack artifact key, its within-run store dedupe key,
# and its cross-run cache key; each is empty when the record's context cannot
# be proven shareable. The environment is read per record, in the record's own
# directory, so a per-directory mise [env] difference splits the key.
record_probe_keys() {
  local index="$1" repo="$2" declaration="$3" launcher fields cache xdg_cache local_cache context_home env_file proxy node
  local pnpm_home data_home_field config_home_field target directory value key dedupe config_home canonical
  local context="$discovery_work/$index.context" environment_digest share
  : >"$discovery_work/$index.key"
  : >"$discovery_work/$index.dedupe"
  : >"$discovery_work/$index.cachekey"
  launcher="$(command -v pnpm || true)"
  if [[ "$launcher" == */mise/shims/pnpm ]]; then
    environment_digest="$(cd "$repo" && "${offline_probe_env[@]}" mise exec -- /bin/bash -c "$pnpm_context_script" 2>/dev/null |
      "${offline_probe_env[@]}" awk -v context="$context" "$context_stream_awk" | LC_ALL=C sort | sha256_stream)" || return 0
  else
    environment_digest="$(cd "$repo" && /bin/bash -c "$pnpm_context_script" |
      "${offline_probe_env[@]}" awk -v context="$context" "$context_stream_awk" | LC_ALL=C sort | sha256_stream)" || return 0
  fi
  [[ -f "$context" ]] || return 0
  IFS= read -r fields <"$context" || return 0
  awk -F'\t' 'NF != 10 { exit 1 }' <<<"$fields" || return 0
  IFS=$'\t' read -r cache xdg_cache local_cache context_home env_file proxy node \
    pnpm_home data_home_field config_home_field <<<"$fields"
  [[ "$context_home" == /* && "$proxy" == /* && "$node" == /* ]] || return 0
  # Bind every cache-location input without duplicating Corepack's fallback logic.
  # Relative/empty overrides have a cwd-dependent meaning, so never share them.
  for value in "$cache" "$xdg_cache" "$local_cache"; do
    case "$value" in : | x:/*) ;; *) return 0 ;; esac
  done
  [[ "$env_file" == x:0 || "$env_file" == : ]] || return 0
  if [[ "$env_file" != x:0 ]]; then
    directory="$repo"
    while :; do
      [[ ! -e "$directory/.corepack.env" && ! -L "$directory/.corepack.env" ]] || return 0
      [[ "$directory" != / ]] || break
      directory="$(dirname "$directory")"
    done
  fi
  target="$(readlink "$proxy" 2>/dev/null)" || return 0
  case "$target" in */corepack/dist/pnpm.js) ;; *) return 0 ;; esac
  key="$(printf '%q|%q' "$fields" "$declaration")"
  printf '%s\n' "$key" >"$discovery_work/$index.key"
  share="$(sed -n 's/^share //p' "$context")"
  [[ "$share" == 1 ]] || return 0
  for value in "$pnpm_home" "$data_home_field" "$config_home_field"; do
    case "$value" in : | x:/*) ;; *) return 0 ;; esac
  done
  printf 'environment %s\n' "$environment_digest" >>"$context"
  config_home="$context_home/.config"
  [[ "$config_home_field" == : ]] || config_home="${config_home_field#x:}"
  dedupe="$(store_dedupe_key_at "$repo" "$key" "$context_home" "$config_home" "$node" "$context" \
    "$discovery_work/$index.material")" || dedupe=''
  rm -f -- "$discovery_work/$index.material"
  [[ -n "$dedupe" ]] || return 0
  # Device numbers can be reused by another volume across runs, so the
  # cross-run key also binds the canonical record path. A record reached
  # through a symlink would need both paths walked, so it simply refuses.
  canonical="$(canonical_dir "$repo")" || return 0
  [[ "$canonical" == "$repo" ]] || return 0
  printf '%s\n' "$dedupe" >"$discovery_work/$index.dedupe"
  printf '%s\n%s\n' "$dedupe" "$canonical" | sha256_stream >"$discovery_work/$index.cachekey" || : >"$discovery_work/$index.cachekey"
}

# Discovery workers rebind this per record, as they do review_records and
# store_selections, so parallel probes never share an output path.
probe_errors="$probe_dir/errors"

record_pnpm_probe_error() {
  local repo="$1" operation="$2" diagnostic="$3"
  [[ -s "$diagnostic" ]] || return 0
  printf '\nRepository: %s\nProbe: %s\n' "$repo" "$operation" >>"$probe_errors"
  cat "$diagnostic" >>"$probe_errors"
}

# Observe one record's store and version offline and write the raw outcome.
# Interpretation is per record, so records sharing a store context can share
# this observation without sharing its conclusions.
observe_store_selection() {
  local index="$1" repo="$2" store version output diagnostic status=0
  local probe_errors="$discovery_work/$index.errors"
  local outcome="$discovery_work/$index.outcome"
  output="$discovery_work/$index.output"
  diagnostic="$discovery_work/$index.stderr"
  : >"$discovery_work/$index.probed"
  (pnpm_store_path_at "$repo") >"$output" 2>"$diagnostic" || status=$?
  record_pnpm_probe_error "$repo" 'store path' "$diagnostic"
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    rm -f -- "$output"
    if grep -qF "Network access disabled by the environment; can't reach " "$diagnostic"; then
      printf 'uncached\n' >"$outcome"
    else
      printf 'store-error\n' >"$outcome"
    fi
    return 0
  fi
  store="$(<"$output")"
  if [[ -z "$store" || "$store" != /* ]] || has_terminal_control "$store"; then
    rm -f -- "$output"
    printf 'bad-store\n' >"$outcome"
    return 0
  fi
  : >"$output"
  status=0
  (pnpm_version_at "$repo") >"$output" 2>"$diagnostic" || status=$?
  record_pnpm_probe_error "$repo" 'version' "$diagnostic"
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    rm -f -- "$output"
    printf 'version-error\n' >"$outcome"
    return 0
  fi
  version="$(<"$output")"
  rm -f -- "$output"
  if [[ -z "$version" ]] || has_terminal_control "$version"; then
    printf 'bad-version\n' >"$outcome"
    return 0
  fi
  printf 'ok\t%s\t%s\t%s\n' "$store" "$version" "$(date +%s)" >"$outcome"
}

# Apply an observed outcome (this record's own, or its store-context leader's)
# to one record. An exact-pin success becomes cacheable under the record's own
# cross-run key.
interpret_store_outcome() {
  local index="$1" repo="$2" package_manager="$3" source="$4" kind store version observed expected_version canonical cache_key
  local review_records="$discovery_work/$index.review"
  local store_selections="$discovery_work/$index.selection"
  IFS=$'\t' read -r kind store version observed <"$discovery_work/$source.outcome" || return 1
  expected_version="${package_manager#pnpm@}"
  expected_version="${expected_version%%+*}"
  case "$kind" in
    ok) ;;
    uncached)
      append_review "$repo" "$package_manager is uncached; cleanup is intentionally offline, not a connectivity test; no store was touched"
      return 0
      ;;
    store-error)
      append_review "$repo" "$package_manager could not resolve a store offline; see private probe diagnostics; no store was touched"
      return 0
      ;;
    bad-store)
      append_review "$repo" "$package_manager returned an unsupported store path; no store was touched"
      return 0
      ;;
    version-error)
      append_review "$repo" "$package_manager resolved a store but its pnpm version was unavailable; no automatic candidate was created"
      return 0
      ;;
    bad-version)
      append_review "$repo" "$package_manager returned an unsupported version value; no store was touched"
      return 0
      ;;
    *) return 1 ;;
  esac
  if [[ "$version" != "$expected_version" ]]; then
    append_review "$repo" "$package_manager resolved pnpm $version; launcher drift, no store was touched"
    return 0
  fi
  # Every record with a cross-run key keeps the age of the observation it used.
  IFS= read -r cache_key <"$discovery_work/$index.cachekey" || cache_key=''
  if [[ -n "$cache_key" && "$observed" =~ ^[0-9]+$ ]]; then
    printf '%s\t%s\t%s\t%s\n' "$cache_key" "$store" "$version" "$observed" >"$discovery_work/$index.cacheable"
  fi
  # pnpm reports where the store WOULD live, which is not a claim that it
  # exists. Quietly skip that ordinary state only after the lexical path proves
  # it is an exact v<number> child of a configured trusted root. `-e` is also
  # false for a dangling symlink, so test that case separately; neither a
  # dangling link nor an arbitrary absent path may bypass the trust boundary.
  if [[ ! -e "$store" ]]; then
    if [[ -L "$store" ]]; then
      append_review "$repo" "$package_manager returned a dangling store symlink; no store was touched: $store"
    elif trusted_store_base "$store" >/dev/null; then
      return 0
    else
      append_review "$repo" "$package_manager returned a nonexistent store outside the trusted v<number> layout; no store was touched: $store"
    fi
    return 0
  fi
  canonical="$(canonical_dir "$store" || true)"
  if [[ -z "$canonical" ]]; then
    append_review "$repo" "$package_manager returned an existing store path that could not be canonicalized: $store"
    return 0
  fi
  printf '%s\t%s\t%s\t%s\n' "$canonical" "$repo" "$version" "$package_manager" >>"$store_selections"
}

# A pinned record is complete only when its worker returns. Its notes and
# diagnostics are then whole, so they survive even an incomplete discovery.
probe_record() {
  local index="$1" repo="$2" package_manager="$3" key="$4" kind
  observe_store_selection "$index" "$repo"
  interpret_store_outcome "$index" "$repo" "$package_manager" "$index"
  IFS=$'\t' read -r kind _ <"$discovery_work/$index.outcome" || kind=''
  if [[ "$kind" == uncached && -n "$key" ]]; then
    : >"$discovery_work/$index.miss"
  fi
  : >"$discovery_work/$index.done"
}

# Classify one repository record without launching pnpm. Exact stable pins
# become probe tasks; everything else is decided here.
classify_record() {
  local index="$1" repo="$2" package_manager output version status=0
  local review_records="$discovery_work/$index.review"
  [[ -f "$repo/package.json" ]] || return 0
  output="$discovery_work/package-manager"
  "$jq_bin" -r '.packageManager // empty' "$repo/package.json" >"$output" || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    rm -f -- "$output"
    append_review "$repo/package.json" "invalid or unreadable JSON; pnpm selection was not inspected"
    return 0
  fi
  package_manager="$(<"$output")"
  rm -f -- "$output"
  if has_terminal_control "$package_manager"; then
    append_review "$repo/package.json" "packageManager contains a control character; pnpm selection was refused"
    return 0
  fi
  case "$package_manager" in
    pnpm@*)
      version="${package_manager#pnpm@}"
      version="${version%%+*}"
      if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        if has_terminal_control "$repo"; then
          echo "groundwork-cleanup: refused a repository selection containing a record control character." >&2
          return 1
        fi
        printf '%s\t%s\t%s\n' "$index" "$repo" "$package_manager" >>"$discovery_work/tasks"
        : >"$discovery_work/$index.task"
      elif [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+- ]]; then
        append_review "$repo/package.json" "prerelease pnpm pins are review-only for unattended maintenance: $package_manager"
      else
        append_review "$repo/package.json" "malformed pnpm packageManager declaration: $package_manager"
      fi
      ;;
  esac
}

# A FIFO pool of at most discovery_jobs background workers. Bash 3.2 has no
# `wait -n`; the probes are similar in cost, so waiting on the oldest is close
# to optimal. Workers stay in discovery's process group, so the cumulative
# deadline cancels them with it. Any worker failure makes discovery incomplete.
discovery_pool_start() {
  while [[ $((discovery_pool_tail - discovery_pool_head)) -ge "$discovery_jobs" ]]; do
    discovery_pool_reap
  done
  "$@" &
  discovery_pool_pids[discovery_pool_tail]=$!
  discovery_pool_tail=$((discovery_pool_tail + 1))
}

discovery_pool_reap() {
  local status=0
  wait "${discovery_pool_pids[discovery_pool_head]}" || status=$?
  discovery_pool_head=$((discovery_pool_head + 1))
  discovery_pool_done=$((discovery_pool_done + 1))
  case "$status" in
    0) ;;
    125 | 129 | 130 | 143) discovery_pool_terminal="$status" discovery_pool_failed=1 ;;
    *) discovery_pool_failed=1 ;;
  esac
  if [[ $((discovery_pool_done % 25)) -eq 0 ]]; then
    printf '  Offline pnpm discovery: %s %s/%s.\n' "$discovery_pool_label" "$discovery_pool_done" "$discovery_pool_total"
  fi
}

discovery_pool_run() {
  discovery_pool_label="$1"
  discovery_pool_total="$2"
  discovery_pool_done=0
  shift 2
  "$@"
  while [[ "$discovery_pool_tail" -gt "$discovery_pool_head" ]]; do
    discovery_pool_reap
  done
  exit_if_terminal_status "$discovery_pool_terminal"
  [[ "$discovery_pool_failed" -eq 0 ]]
}

queue_artifact_keys() {
  local index repo package_manager
  while IFS=$'\t' read -r index repo package_manager; do
    [[ "$discovery_pool_failed" -eq 0 ]] || break
    discovery_pool_start record_probe_keys "$index" "$repo" "$package_manager"
  done <"$discovery_work/tasks"
}

# Records with the same store dedupe key share one observation: the first is
# its leader, served from the result cache when possible, and the rest are
# shared. Among records that probe, each distinct non-empty Corepack key has
# one leader so a same-run miss is observed once. Records without a key never
# share an observation.
plan_probe_waves() {
  local index repo package_manager key dedupe leader position cached cache_key
  local leader_keys=() leader_indexes=() dedupe_keys=() dedupe_indexes=()
  : >"$discovery_work/leaders"
  : >"$discovery_work/followers"
  : >"$discovery_work/cached"
  : >"$discovery_work/shared"
  while IFS=$'\t' read -r index repo package_manager; do
    IFS= read -r dedupe <"$discovery_work/$index.dedupe" || dedupe=''
    if [[ -n "$dedupe" ]]; then
      leader=""
      position=0
      while [[ "$position" -lt "${#dedupe_keys[@]}" ]]; do
        if [[ "${dedupe_keys[position]}" == "$dedupe" ]]; then
          leader="${dedupe_indexes[position]}"
          break
        fi
        position=$((position + 1))
      done
      if [[ -n "$leader" ]]; then
        printf '%s\t%s\t%s\t%s\n' "$index" "$repo" "$package_manager" "$leader" >>"$discovery_work/shared"
        continue
      fi
      dedupe_keys[${#dedupe_keys[@]}]="$dedupe"
      dedupe_indexes[${#dedupe_indexes[@]}]="$index"
      IFS= read -r cache_key <"$discovery_work/$index.cachekey" || cache_key=''
      cached=""
      if [[ -n "$cache_key" ]]; then
        cached="$(awk -F'\t' -v key="$cache_key" '$1 == key { printf "ok\t%s\t%s\t%s\n", $2, $3, $4; exit }' \
          "$discovery_work/result-cache")"
      fi
      if [[ -n "$cached" ]]; then
        printf '%s\n' "$cached" >"$discovery_work/$index.outcome"
        printf '%s\t%s\t%s\n' "$index" "$repo" "$package_manager" >>"$discovery_work/cached"
        continue
      fi
    fi
    IFS= read -r key <"$discovery_work/$index.key" || key=''
    leader=""
    if [[ -n "$key" ]]; then
      position=0
      while [[ "$position" -lt "${#leader_keys[@]}" ]]; do
        if [[ "${leader_keys[position]}" == "$key" ]]; then
          leader="${leader_indexes[position]}"
          break
        fi
        position=$((position + 1))
      done
    fi
    if [[ -n "$leader" ]]; then
      printf '%s\t%s\t%s\t%s\n' "$index" "$repo" "$package_manager" "$leader" >>"$discovery_work/followers"
      continue
    fi
    if [[ -n "$key" ]]; then
      leader_keys[${#leader_keys[@]}]="$key"
      leader_indexes[${#leader_indexes[@]}]="$index"
    fi
    printf '%s\t%s\t%s\n' "$index" "$repo" "$package_manager" >>"$discovery_work/leaders"
  done <"$discovery_work/tasks"
}

discovery_pool_drain() {
  while [[ "$discovery_pool_tail" -gt "$discovery_pool_head" ]]; do
    discovery_pool_reap
  done
}

# Leaders finish first so a follower can reuse only an observed miss; every
# other follower still probes its own repository. Cached and shared records
# are applied last, once every observation they reuse exists.
queue_store_probes() {
  local index repo package_manager leader key
  while IFS=$'\t' read -r index repo package_manager; do
    [[ "$discovery_pool_failed" -eq 0 ]] || return 0
    IFS= read -r key <"$discovery_work/$index.key" || key=''
    discovery_pool_start probe_record "$index" "$repo" "$package_manager" "$key"
  done <"$discovery_work/leaders"
  discovery_pool_drain
  while IFS=$'\t' read -r index repo package_manager leader; do
    [[ "$discovery_pool_failed" -eq 0 ]] || return 0
    if [[ -e "$discovery_work/$leader.miss" ]]; then
      printf '%s\t%s\n' "$repo" "$package_manager is uncached in this Corepack context (same-run observation); cleanup is intentionally offline, not a connectivity test; no store was touched" \
        >>"$discovery_work/$index.review"
      printf 'uncached\n' >"$discovery_work/$index.outcome"
      : >"$discovery_work/$index.reused"
      : >"$discovery_work/$index.done"
      discovery_pool_done=$((discovery_pool_done + 1))
      continue
    fi
    IFS= read -r key <"$discovery_work/$index.key" || key=''
    discovery_pool_start probe_record "$index" "$repo" "$package_manager" "$key"
  done <"$discovery_work/followers"
  discovery_pool_drain
  [[ "$discovery_pool_failed" -eq 0 ]] || return 0
  [[ ! -s "$discovery_work/cached" ]] || : >"$discovery_work/cache-used"
  while IFS=$'\t' read -r index repo package_manager; do
    interpret_store_outcome "$index" "$repo" "$package_manager" "$index"
    : >"$discovery_work/$index.cached"
    : >"$discovery_work/$index.done"
    discovery_pool_done=$((discovery_pool_done + 1))
  done <"$discovery_work/cached"
  while IFS=$'\t' read -r index repo package_manager leader; do
    [[ -e "$discovery_work/$leader.done" ]] || return 1
    interpret_store_outcome "$index" "$repo" "$package_manager" "$leader"
    : >"$discovery_work/$index.shared"
    : >"$discovery_work/$index.done"
    discovery_pool_done=$((discovery_pool_done + 1))
  done <"$discovery_work/shared"
}

# Read the cross-run result cache once. Any malformed byte makes it empty.
# Rows older than the time-to-live are ignored, so a vanished Corepack
# artifact or store cannot be trusted for long.
load_result_cache() {
  : >"$discovery_work/result-cache"
  [[ -f "$discovery_cache" && ! -L "$discovery_cache" ]] || return 0
  if [[ "$discovery_cache_read" -ne 1 ]]; then
    echo '  Offline pnpm discovery: pnpm maintenance may run, so every store context is probed fresh.'
    return 0
  fi
  if awk -F'\t' -v header="$discovery_cache_header" '
      NR == 1 { if ($0 != header) bad = 1; next }
      NF != 4 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || $2 !~ /^\// || $2 ~ /[[:cntrl:]]/ ||
        $3 !~ /^[0-9]+\.[0-9]+\.[0-9]+$/ || $4 !~ /^[0-9]+$/ { bad = 1 }
      END { exit (bad || NR == 0) }' "$discovery_cache" 2>/dev/null; then
    awk -F'\t' -v now="$(date +%s)" -v ttl="$((discovery_cache_ttl_days * 86400))" \
      'NR > 1 && $4 <= now + 60 && now - $4 < ttl' "$discovery_cache" >"$discovery_work/result-cache"
  else
    echo '  Offline pnpm discovery: ignored an unreadable result cache; every store context is probed again.'
  fi
}

discover_exact_selections() {
  local repos_command jq_bin repo _ status=0 count=0 total index task_count
  local probe_count=0 reused_misses=0 shared_count=0 cached_count=0
  local discovery_work="$probe_dir/discovery"
  local discovery_pool_pids=() discovery_pool_head=0 discovery_pool_tail=0 discovery_pool_done=0
  local discovery_pool_failed=0 discovery_pool_terminal=0 discovery_pool_label="" discovery_pool_total=0
  # Workers must stay in this supervised process group.
  set +m
  repos_command="$HOME/.local/bin/groundwork-repos"
  if [[ ! -x "$repos_command" ]]; then
    append_review "Repository discovery" "groundwork-repos is unavailable; pnpm automatic maintenance is incomplete"
    return 1
  fi
  "$repos_command" --strict --no-cache list >"$repository_records" || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    append_review "Repository discovery" "canonical no-cache discovery failed or timed out; pnpm automatic maintenance is incomplete"
    return 1
  fi
  jq_bin="$(command -v jq 2>/dev/null || true)"
  if [[ ! -x "$jq_bin" ]]; then
    append_review "Repository discovery" "jq is unavailable; exact packageManager pins were not inspected and no pnpm store is automatic"
    return 1
  fi
  status=0
  "$jq_bin" --version >"$probe_dir/jq-version" || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    append_review "Repository discovery" "jq failed its bounded self-check; exact packageManager pins were not inspected and no pnpm store is automatic"
    return 1
  fi
  mkdir "$discovery_work"
  : >"$discovery_work/tasks"
  total="$(awk 'END {print NR + 0}' "$repository_records")"
  printf '  Offline pnpm discovery: %s repository/worktree records; deadline %ss; up to %s parallel probes.\n' \
    "$total" "$discovery_deadline" "$discovery_jobs"
  load_result_cache
  while IFS=$'\t' read -r repo _; do
    count=$((count + 1))
    classify_record "$count" "$repo"
  done <"$repository_records"
  task_count="$(awk 'END {print NR + 0}' "$discovery_work/tasks")"
  printf '  Offline pnpm discovery: classified %s/%s records; %s exact pnpm pins to resolve.\n' \
    "$count" "$total" "$task_count"
  discovery_pool_run 'resolved Corepack contexts' "$task_count" queue_artifact_keys || return 1
  plan_probe_waves
  discovery_pool_run 'probed pinned records' "$task_count" queue_store_probes || return 1
  index=0
  while [[ "$index" -lt "$count" ]]; do
    index=$((index + 1))
    [[ ! -e "$discovery_work/$index.probed" ]] || probe_count=$((probe_count + 1))
    [[ ! -e "$discovery_work/$index.reused" ]] || reused_misses=$((reused_misses + 1))
    [[ ! -e "$discovery_work/$index.shared" ]] || shared_count=$((shared_count + 1))
    [[ ! -e "$discovery_work/$index.cached" ]] || cached_count=$((cached_count + 1))
  done
  printf '  Offline pnpm discovery: inspected %s/%s repository records; %s store probes for %s pinned records; %s shared in this run, %s from the result cache, %s known misses reused; complete.\n' \
    "$count" "$total" "$probe_count" "$task_count" "$shared_count" "$cached_count" "$reused_misses"
}

# Merge per-record results in inventory order so reports stay deterministic.
# Only complete records contribute: one never queued for a probe, or one whose
# worker finished. Store selections are merged only from a complete discovery,
# because a partial inventory cannot prove the absence of a conflicting selector.
merge_discovery_records() {
  local include_selections="$1" discovery_work="$probe_dir/discovery" index=0 total
  [[ -d "$discovery_work" ]] || return 0
  total="$(awk 'END {print NR + 0}' "$repository_records")"
  while [[ "$index" -lt "$total" ]]; do
    index=$((index + 1))
    [[ ! -e "$discovery_work/$index.task" || -e "$discovery_work/$index.done" ]] || continue
    [[ ! -f "$discovery_work/$index.review" ]] || cat "$discovery_work/$index.review" >>"$review_records"
    [[ ! -f "$discovery_work/$index.errors" ]] || cat "$discovery_work/$index.errors" >>"$probe_dir/errors"
    if [[ "$include_selections" -eq 1 && -f "$discovery_work/$index.selection" ]]; then
      cat "$discovery_work/$index.selection" >>"$store_selections"
    fi
  done
}

# Persist exact-pin store observations for the next run, keyed by store
# context. Called only after a complete discovery in acting mode; a partial
# inventory never feeds the cache. Rewriting drops contexts no longer seen.
write_discovery_cache() {
  local discovery_work="$probe_dir/discovery" index=0 total temporary
  [[ -d "$discovery_work" ]] || return 0
  total="$(awk 'END {print NR + 0}' "$repository_records")" || return 1
  mkdir -p "$(dirname "$discovery_cache")" || return 1
  temporary="$discovery_cache.tmp.$$"
  discovery_cache_temporary="$temporary"
  {
    printf '%s\n' "$discovery_cache_header"
    while [[ "$index" -lt "$total" ]]; do
      index=$((index + 1))
      [[ ! -f "$discovery_work/$index.cacheable" ]] || cat "$discovery_work/$index.cacheable"
    done
  } | awk -F'\t' 'NR == 1 || !seen[$1]++' >"$temporary" || {
    rm -f -- "$temporary"
    return 1
  }
  mv -f -- "$temporary" "$discovery_cache" || {
    rm -f -- "$temporary"
    return 1
  }
  discovery_cache_temporary=""
}

select_representative() {
  awk -F'\t' '
    function wins(maj, min, patch, stable, repo) {
      return !seen || maj > bmaj ||
        (maj == bmaj && min > bmin) ||
        (maj == bmaj && min == bmin && patch > bpatch) ||
        (maj == bmaj && min == bmin && patch == bpatch && stable > bstable) ||
        (maj == bmaj && min == bmin && patch == bpatch && stable == bstable && repo < brepo)
    }
    {
      split($3, version, /[.-]/)
      stable = ($3 !~ /-/)
      if (wins(version[1] + 0, version[2] + 0, version[3] + 0, stable, $2)) {
        best = $0
        bmaj = version[1] + 0
        bmin = version[2] + 0
        bpatch = version[3] + 0
        bstable = stable
        brepo = $2
        seen = 1
      }
    }
    END { if (seen) print best }
  ' "$group_records"
}

finalize_store_group() {
  local store majors major_count representative repo version source selector_count details trusted_summary store_base
  [[ -s "$group_records" ]] || return 0
  store="$(awk -F'\t' 'NR == 1 {print $1}' "$group_records")"
  majors="$(awk -F'\t' '{split($3, v, "."); print v[1]}' "$group_records" | sort -u | paste -sd, -)"
  major_count="$(awk -F, '{print NF}' <<<"$majors")"
  selector_count="$(awk 'END {print NR + 0}' "$group_records")"
  details="$(awk -F'\t' '{printf "%s%s (%s)", (NR == 1 ? "" : "; "), $2, $3}' "$group_records")"
  if [[ "$major_count" -gt 1 ]]; then
    append_review "$store" "conflicting pnpm majors ($majors) select this store: $details; automatic prune refused"
    return 0
  fi
  if ! store_base="$(trusted_store_base "$store")"; then
    trusted_summary="$(printf '%s; ' "${trusted_store_roots[@]}")"
    trusted_summary="${trusted_summary%; }"
    append_review "$store" "custom store root is not trusted for automatic cleanup (trusted parents: $trusted_summary); selected by: $details"
    return 0
  fi
  representative="$(select_representative)"
  IFS=$'\t' read -r store repo version source <<<"$representative"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$store" "$repo" "$version" "$source" "$selector_count" "$store_base" >>"$store_candidates"
}

build_candidates() {
  local sorted store repo version source current_store=""
  sorted="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-sorted.XXXXXX")"
  LC_ALL=C sort -t $'\t' -k1,1 -k2,2 "$store_selections" >"$sorted"
  : >"$group_records"
  while IFS=$'\t' read -r store repo version source; do
    [[ -n "$store" ]] || continue
    if [[ -n "$current_store" && "$store" != "$current_store" ]]; then
      finalize_store_group
      : >"$group_records"
    fi
    current_store="$store"
    printf '%s\t%s\t%s\t%s\n' "$store" "$repo" "$version" "$source" >>"$group_records"
  done <"$sorted"
  finalize_store_group
  rm -f -- "$sorted"
}

# Earlier releases recorded this pnpm reminder for an incomplete discovery, when no
# store was touched. It never described a repair, so acting mode retires it
# instead of letting it keep pnpm due and failing on every run.
discovery_only_pending="exact repository discovery is unavailable; no pnpm store was touched"
retired_discovery_pending=0
if [[ "$act" -eq 1 && -f "$pending_dir/pnpm" ]]; then
  IFS= read -r pending_message <"$pending_dir/pnpm" || pending_message=""
  if [[ "${pending_message#* }" == "$discovery_only_pending" ]]; then
    clear_pending "pnpm"
    retired_discovery_pending=1
  fi
fi

# Consecutive incomplete discoveries escalate from a per-run warning to an
# owner-review item, so a discovery that always times out is not a silent
# permanent skip.
discovery_escalation_runs=3
pnpm_discovery_failed=0
pnpm_discovery_reason=""
selections_from_cache=0
# Cross-run store observations, keyed by the full store context. A run that
# may prune on cadence, is forced, or carries a pending pnpm repair re-probes
# every context, so a scheduled prune and its repair always act on fresh
# observations.
state_home="${XDG_STATE_HOME:-}"
[[ "$state_home" == /* ]] || state_home="$HOME/.local/state"
discovery_cache="$state_home/groundwork/pnpm-discovery-cache.tsv"
discovery_cache_header="groundwork pnpm discovery cache v2"
discovery_cache_ttl_days=7
# Cadence ages are read once, here, and reused by the due decision after
# discovery, so a day boundary crossed mid-run cannot make the two disagree.
last_success_days="$(state_age_days "$pnpm_success")"
last_attempt_days="$(state_age_days "$pnpm_attempt")"
discovery_cache_read=1
if [[ -f "$pending_dir/pnpm" || "$force" -eq 1 ||
  "$last_success_days" -lt 0 || "$last_success_days" -ge "$monthly_days" ]]; then
  discovery_cache_read=0
fi
sha256_tool=""
if command -v shasum >/dev/null 2>&1; then
  sha256_tool="shasum"
elif command -v sha256sum >/dev/null 2>&1; then
  sha256_tool="sha256sum"
fi
stat_device_style=""
if stat -c %d / >/dev/null 2>&1; then
  stat_device_style="gnu"
elif stat -f %d / >/dev/null 2>&1; then
  stat_device_style="bsd"
fi
incomplete_discovery_runs=0
if [[ -f "$pnpm_discovery_incomplete_runs" ]]; then
  IFS= read -r incomplete_discovery_runs <"$pnpm_discovery_incomplete_runs" || incomplete_discovery_runs=0
  # No leading zeros: Bash arithmetic would read 08 or 09 as invalid octal.
  [[ "$incomplete_discovery_runs" =~ ^(0|[1-9][0-9]{0,5})$ ]] || incomplete_discovery_runs=0
fi
if command -v pnpm >/dev/null 2>&1; then
  # All observation children share one supervised group and cumulative deadline.
  # A partial inventory cannot prove absence of conflicting selectors.
  run_pnpm_discovery() {
    local deadline="$discovery_deadline"
    run_bounded 'discover offline pnpm store selections' discover_exact_selections
  }
  discovery_status=0
  run_pnpm_discovery || discovery_status=$?
  exit_if_terminal_status "$discovery_status"
  if [[ "$discovery_status" -ne 0 ]]; then
    pnpm_discovery_failed=1
    : >"$store_selections"
    merge_discovery_records 0
    if [[ "$discovery_status" -eq 124 ]]; then
      pnpm_discovery_reason="repository discovery exceeded its ${discovery_deadline}s deadline"
    else
      pnpm_discovery_reason="repository discovery did not complete (exit $discovery_status)"
    fi
    append_review 'Repository discovery' "offline selection incomplete (exit $discovery_status); completed records' notes and diagnostics kept; partial candidates discarded; pnpm store cleanup skipped; no store was touched; independent maintenance continues"
    # Report mode shows the recorded count; only an acting run adds itself.
    if [[ "$act" -eq 1 ]]; then
      incomplete_discovery_runs=$((incomplete_discovery_runs + 1))
      write_state "$pnpm_discovery_incomplete_runs" "$incomplete_discovery_runs"
    fi
    if [[ "$incomplete_discovery_runs" -ge "$discovery_escalation_runs" ]]; then
      append_review 'Repository discovery' "pnpm stores have not been cleaned for $incomplete_discovery_runs runs: offline discovery has been incomplete $incomplete_discovery_runs consecutive times; raise GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS (now $discovery_deadline) or GROUNDWORK_PNPM_DISCOVERY_JOBS (now $discovery_jobs, at most 16), or fix the reported discovery failure"
    fi
  else
    merge_discovery_records 1
    [[ ! -e "$probe_dir/discovery/cache-used" ]] || selections_from_cache=1
    incomplete_discovery_runs=0
    if [[ "$act" -eq 1 ]]; then
      rm -f -- "$pnpm_discovery_incomplete_runs"
      write_discovery_cache || echo "  Offline pnpm discovery: the result cache could not be saved; the next run probes every store context." >&2
    fi
  fi
  if [[ -s "$probe_dir/errors" ]]; then
    if [[ "$act" -eq 1 ]]; then
      mkdir -p "$state_dir/logs"
      probe_log="$(mktemp "$state_dir/logs/pnpm-offline-probes.XXXXXX")"
      chmod 600 "$probe_log"
      cat "$probe_dir/errors" >"$probe_log"
      printf '  Private offline pnpm diagnostics: %s\n' "$probe_log"
    else
      echo '  Offline pnpm diagnostics were temporary in report mode; --yes retains a private log.'
    fi
  fi
  build_candidates
fi

pnpm_total=0
pnpm_sizes_complete=1
pnpm_sizes_measured=0
measure_pnpm_candidates() {
  local store _ size
  pnpm_total=0
  pnpm_sizes_complete=1
  while IFS=$'\t' read -r store _; do
    [[ -n "$store" ]] || continue
    size=""
    capture_dir_bytes size "$store" || true
    if [[ -z "$size" ]]; then
      pnpm_sizes_complete=0
    else
      pnpm_total=$((pnpm_total + size))
    fi
  done <"$store_candidates"
  pnpm_sizes_measured=1
}

pnpm_due=0
pnpm_due_reason=""
if [[ "$pnpm_discovery_failed" -ne 0 ]]; then
  pnpm_due_reason="$pnpm_discovery_reason; pnpm store cleanup is skipped until discovery completes"
elif [[ -f "$pending_dir/pnpm" ]]; then
  pnpm_due=1
  pnpm_due_reason="a previous pnpm maintenance attempt is pending repair"
elif [[ ! -s "$store_candidates" ]]; then
  pnpm_due_reason="no exact pinned repository selected a trusted automatic store"
elif [[ "$force" -eq 1 ]]; then
  pnpm_due=1
  pnpm_due_reason="forced for this invocation"
elif [[ "$last_success_days" -lt 0 ]]; then
  pnpm_due=1
  pnpm_due_reason="no machine-wide successful prune has been recorded"
elif [[ "$last_success_days" -ge "$monthly_days" ]]; then
  pnpm_due=1
  pnpm_due_reason="machine-wide success was ${last_success_days} days ago"
elif [[ "$last_attempt_days" -lt 0 || "$last_attempt_days" -ge "$high_water_retry_days" ]]; then
  measure_pnpm_candidates
  if [[ "$pnpm_sizes_complete" -eq 1 &&
    "$pnpm_total" -ge $((high_water_gib * 1024 * 1024 * 1024)) ]]; then
    pnpm_due=1
    pnpm_due_reason="automatic stores exceed the ${high_water_gib} GiB high-water mark"
  elif [[ "$pnpm_sizes_complete" -ne 1 ]]; then
    pnpm_due_reason="machine-wide success was ${last_success_days} days ago; high-water measurement was incomplete"
  else
    pnpm_due_reason="machine-wide success was ${last_success_days} days ago"
  fi
else
  pnpm_due_reason="machine-wide success was ${last_success_days} days ago"
fi
# Pre-prune revalidation passes --store-dir, so it cannot notice that a cached
# selection now resolves elsewhere. Whatever made a prune due, never act on
# cached selections: defer, drop the cache, and let the next run probe fresh.
if [[ "$pnpm_due" -eq 1 && "$selections_from_cache" -eq 1 ]]; then
  pnpm_due=0
  pnpm_due_reason="$pnpm_due_reason, but some selections came from the result cache; the prune is deferred to the next run, which probes every store context fresh"
  if [[ "$act" -eq 1 ]]; then
    rm -f -- "$discovery_cache"
  fi
fi
if [[ "$act" -eq 0 ||
  ("$pnpm_due" -eq 1 && -s "$store_candidates") ]] && [[ "$pnpm_sizes_measured" -eq 0 ]]; then
  measure_pnpm_candidates
fi

brew_cache=""
brew_present=0
observation_status=0
if command -v brew >/dev/null 2>&1; then
  brew_present=1
  observation="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-brew.XXXXXX")"
  observation_status=0
  run_bounded_capture "query Homebrew cache" "$observation" brew_cache_at_home || observation_status=$?
  exit_if_terminal_status "$observation_status"
  if [[ "$observation_status" -eq 0 ]]; then
    brew_cache="$(observed_cache_path "$observation" "$HOME" "Homebrew" || true)"
  fi
  rm -f -- "$observation"
fi

npm_cache=""
npm_provider=""
if command -v mise >/dev/null 2>&1; then
  observation="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-mise.XXXXXX")"
  observation_status=0
  run_bounded_capture "resolve mise-owned npm" "$observation" mise_npm_path_at_home || observation_status=$?
  exit_if_terminal_status "$observation_status"
  if [[ "$observation_status" -eq 0 ]]; then
    npm_provider="mise"
  fi
  rm -f -- "$observation"
fi
if [[ -z "$npm_provider" ]] && command -v npm >/dev/null 2>&1; then
  npm_provider="PATH"
fi
if [[ "$npm_provider" == "mise" ]]; then
  observation="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-npm.XXXXXX")"
  observation_status=0
  run_bounded_capture "query npm cache" "$observation" npm_cache_with_mise || observation_status=$?
  exit_if_terminal_status "$observation_status"
  if [[ "$observation_status" -eq 0 ]]; then
    npm_cache="$(observed_cache_path "$observation" "$HOME" "npm" || true)"
  fi
  rm -f -- "$observation"
elif [[ "$npm_provider" == "PATH" ]]; then
  observation="$(mktemp "${TMPDIR:-/tmp}/groundwork-cleanup-npm.XXXXXX")"
  observation_status=0
  run_bounded_capture "query npm cache" "$observation" npm_cache_from_path || observation_status=$?
  exit_if_terminal_status "$observation_status"
  if [[ "$observation_status" -eq 0 ]]; then
    npm_cache="$(observed_cache_path "$observation" "$HOME" "npm" || true)"
  fi
  rm -f -- "$observation"
fi

print_candidates() {
  local store repo version source selector_count store_base size selected_repo selected_version
  if [[ ! -s "$store_candidates" ]]; then
    echo "  None."
    return
  fi
  while IFS=$'\t' read -r store repo version source selector_count store_base; do
    size=""
    capture_dir_bytes size "$store" || true
    printf '  %s\n' "$store"
    printf '    Size: %s\n' "$(format_bytes "$size")"
    printf '    Representative: %s\n' "$repo"
    printf '    pnpm: %s (%s)\n' "$version" "$source"
    printf '    Selectors: %s\n' "$selector_count"
    printf '    Enforced store base: %s\n' "$store_base"
    while IFS=$'\t' read -r _ selected_repo selected_version _; do
      [[ "$selected_repo" == "$repo" && "$selected_version" == "$version" ]] && continue
      printf '      Also selected by: %s (pnpm %s)\n' "$selected_repo" "$selected_version"
    done < <(awk -F'\t' -v target="$store" '$1 == target' "$store_selections")
    printf '    Accepted: exact pin + canonical Git repository + trusted store root\n'
  done <"$store_candidates"
}

review_item_count=0
print_review() {
  local source message generation generation_name root canonical matched generation_size generation_bytes
  local seen_roots=$'\n' found=0
  while IFS=$'\t' read -r source message; do
    [[ -n "$source" ]] || continue
    found=1
    review_item_count=$((review_item_count + 1))
    printf '  %s\n    %s\n' "$source" "$message"
  done <"$review_records"
  for root in "${trusted_store_roots[@]}"; do
    [[ -d "$root" ]] || continue
    root="$(canonical_dir "$root" || printf '%s' "$root")"
    case "$seen_roots" in *$'\n'"$root"$'\n'*) continue ;; esac
    seen_roots="$seen_roots$root"$'\n'
    for generation in "$root"/v*; do
      generation_name="$(basename "$generation")"
      if has_terminal_control "$generation_name"; then
        found=1
        review_item_count=$((review_item_count + 1))
        printf '  %s\n    A store-generation entry containing terminal controls was not inspected.\n' "$root"
        continue
      fi
      [[ "$generation_name" =~ ^v[0-9]+$ ]] || continue
      if [[ -L "$generation" ]]; then
        found=1
        review_item_count=$((review_item_count + 1))
        printf '  %s\n    Store-generation symlinks are not followed.\n' "$generation"
        continue
      fi
      [[ -d "$generation" ]] || continue
      canonical="$(canonical_dir "$generation" || printf '%s' "$generation")"
      matched="$(awk -F'\t' -v path="$canonical" '$1 == path {print "yes"; exit}' "$store_candidates")"
      [[ "$matched" == "yes" ]] && continue
      found=1
      review_item_count=$((review_item_count + 1))
      if [[ "$act" -eq 0 ]]; then
        generation_bytes=""
        capture_dir_bytes generation_bytes "$generation" || true
        generation_size="$(format_bytes "$generation_bytes")"
      else
        generation_size="not measured in automatic mode"
      fi
      printf '  pnpm %s store: %s\n' "$generation_name" "$generation_size"
      printf '    No accepted automatic candidate matched it. Groundwork did not remove it; whole-generation retirement requires owner confirmation.\n'
    done
  done
  [[ "$found" -eq 1 ]] || echo "  None."
}

print_pending() {
  local pending_file pending_message
  [[ -d "$pending_dir" ]] || return 0
  for pending_file in "$pending_dir"/*; do
    [[ -f "$pending_file" ]] || continue
    IFS= read -r pending_message <"$pending_file" || pending_message="repair state is recorded"
    printf '  %s\n    %s\n' "$(basename "$pending_file")" "$pending_message"
  done
}

if [[ "$act" -eq 0 ]]; then
  brew_report_size=""
  npm_report_size=""
  if [[ -n "$brew_cache" ]]; then
    capture_dir_bytes brew_report_size "$brew_cache" || true
  fi
  if [[ -n "$npm_cache" ]]; then
    capture_dir_bytes npm_report_size "$npm_cache" || true
  fi
  echo "Package-manager maintenance report"
  if [[ -d "$state_dir/update-all.lock" ]]; then
    echo
    echo "Snapshot note"
    echo "  A mutating update or maintenance run holds the shared lock."
    echo "  Sizes and pending state may change while this read-only report is collected."
  fi
  if [[ "$brew_present" -eq 1 ]]; then
    printf '\nHomebrew\n  Cache: %s\n  Next automatic action: brew autoremove; brew cleanup --prune=all\n' \
      "$(if [[ -n "$brew_cache" ]]; then format_bytes "$brew_report_size"; else printf 'unavailable'; fi)"
  fi
  if [[ -n "$npm_provider" ]]; then
    printf '\nnpm\n  Cache via %s: %s\n  Next automatic action: npm cache verify\n' \
      "$npm_provider" \
      "$(if [[ -n "$npm_cache" ]]; then format_bytes "$npm_report_size"; else printf 'path unavailable'; fi)"
  fi
  echo
  echo "pnpm"
  echo "  Cadence: machine-wide"
  printf '  Automatic candidates: %s\n' "$(awk 'END {print NR + 0}' "$store_candidates")"
  printf '  Automatic total: %s\n' \
    "$(if [[ "$pnpm_sizes_complete" -eq 1 ]]; then format_bytes "$pnpm_total"; else printf 'unavailable'; fi)"
  printf '  Maintenance: %s (%s)\n' \
    "$(if [[ "$pnpm_due" -eq 1 ]]; then printf 'due'; else printf 'not due'; fi)" "$pnpm_due_reason"
  echo
  echo "Resolved automatic candidates"
  print_candidates
  echo
  echo "Review recommended"
  print_review
  if has_pending; then
    echo
    echo "Pending repair"
    print_pending
  fi
  echo
  echo "No persistent state was changed. update-all performs due maintenance automatically."
  exit 0
fi

if [[ -f "$legacy_pending" && ! -f "$pending_dir/homebrew" ]]; then
  legacy_message="$(head -n 1 "$legacy_pending" 2>/dev/null || true)"
  mark_pending "homebrew" "legacy Homebrew cleanup remains pending${legacy_message:+: $legacy_message}"
fi

echo "Package-manager maintenance"
maintenance_failed=0
maintenance_exit_status=0
brew_status=0
npm_status=0
pnpm_status=0
homebrew_receipt_status="not-installed"
npm_receipt_status="not-installed"
pnpm_receipt_status="unknown"

record_maintenance_failure_status() {
  local status="$1"
  if [[ "$status" -ne 0 && "$maintenance_exit_status" -eq 0 ]]; then
    maintenance_exit_status="$status"
  fi
}

brew_before=""
[[ -z "$brew_cache" ]] || capture_dir_bytes brew_before "$brew_cache" || true
if [[ "$brew_present" -eq 1 ]]; then
  echo
  echo "Homebrew"
  mark_pending "homebrew" \
    "Homebrew maintenance started, but its commands and final receipt have not completed"
  run_bounded "brew autoremove" brew autoremove || brew_status=$?
  case "$brew_status" in
    125)
      mark_pending "homebrew" "brew autoremove could not stop its complete process tree"
      exit 125
      ;;
    129 | 130 | 143)
      mark_pending "homebrew" "brew autoremove was interrupted (exit $brew_status)"
      exit "$brew_status"
      ;;
  esac
  cleanup_status=0
  run_bounded "brew cleanup --prune=all" brew cleanup --prune=all || cleanup_status=$?
  case "$cleanup_status" in
    125)
      mark_pending "homebrew" "brew cleanup --prune=all could not stop its complete process tree"
      exit 125
      ;;
    129 | 130 | 143)
      mark_pending "homebrew" "brew cleanup --prune=all was interrupted (exit $cleanup_status)"
      exit "$cleanup_status"
      ;;
  esac
  cleanup_command_status="$cleanup_status"
  [[ "$brew_status" -eq 0 ]] || cleanup_status="$brew_status"
  brew_after=""
  [[ -z "$brew_cache" ]] || capture_dir_bytes brew_after "$brew_cache" homebrew || true
  if [[ "$cleanup_status" -eq 0 ]]; then
    echo "  Cleanup completed"
  else
    brew_status="$cleanup_status"
    maintenance_failed=1
    record_maintenance_failure_status "$brew_status"
    if [[ "$cleanup_command_status" -ne 0 ]]; then
      homebrew_failure="brew cleanup --prune=all was incomplete (exit $cleanup_command_status): some cached files may have been removed and others left behind"
    else
      homebrew_failure="brew autoremove was incomplete (exit $brew_status); brew cleanup still ran independently"
    fi
    mark_pending "homebrew" "$homebrew_failure"
    echo "  $homebrew_failure" >&2
  fi
  echo "Homebrew cleanup (brew autoremove; brew cleanup --prune=all)"
  printf '  Cache before:    %s\n' "$(format_bytes "$brew_before")"
  printf '  Cache after:     %s\n' "$(format_bytes "$brew_after")"
  if [[ -n "$brew_before" && -n "$brew_after" && "$brew_after" -lt "$brew_before" ]]; then
    printf '  Cache reclaimed: %s\n' "$(format_bytes "$((brew_before - brew_after))")"
  elif [[ -n "$brew_before" && -n "$brew_after" && "$brew_after" -eq "$brew_before" ]]; then
    echo "  Cache reclaimed: nothing to reclaim"
  elif [[ -n "$brew_before" && -n "$brew_after" ]]; then
    printf '  Cache reclaimed: indeterminate — the cache grew by %s during cleanup\n' \
      "$(format_bytes "$((brew_after - brew_before))")"
  else
    echo "  Cache reclaimed: not measured (cache size unavailable)"
  fi
  echo "  Requested formulae and casks stay installed. autoremove may remove installed orphan formula dependencies; cleanup removes reproducible cached and superseded state."
  if [[ "$cleanup_status" -eq 0 ]]; then
    clear_pending "homebrew"
    homebrew_receipt_status="completed"
  else
    homebrew_receipt_status="failed"
  fi
fi

verify_npm_with_mise() {
  cd "$HOME"
  exec mise exec -- npm cache verify
}
verify_npm_from_path() {
  cd "$HOME"
  exec npm cache verify
}

if [[ -n "$npm_provider" ]]; then
  echo
  echo "npm"
  npm_before=""
  [[ -z "$npm_cache" ]] || capture_dir_bytes npm_before "$npm_cache" || true
  mark_pending "npm" \
    "npm maintenance started, but its command and final receipt have not completed"
  if [[ "$npm_provider" == "mise" ]]; then
    run_bounded "npm cache verify" verify_npm_with_mise || npm_status=$?
  else
    run_bounded "npm cache verify" verify_npm_from_path || npm_status=$?
  fi
  case "$npm_status" in
    125)
      mark_pending "npm" "npm cache verify could not stop its complete process tree"
      exit 125
      ;;
    129 | 130 | 143)
      mark_pending "npm" "npm cache verify was interrupted (exit $npm_status)"
      exit "$npm_status"
      ;;
  esac
  npm_after=""
  [[ -z "$npm_cache" ]] || capture_dir_bytes npm_after "$npm_cache" npm || true
  if [[ "$npm_status" -eq 0 ]]; then
    echo "  Cache verified"
  else
    maintenance_failed=1
    record_maintenance_failure_status "$npm_status"
    mark_pending "npm" "npm cache verification failed (exit $npm_status)"
    echo "  Cache verification incomplete (exit $npm_status)" >&2
  fi
  printf '  Reclaimed: %s\n' \
    "$(if [[ -n "$npm_before" && -n "$npm_after" && "$npm_after" -le "$npm_before" ]]; then format_bytes "$((npm_before - npm_after))"; else printf 'not measured'; fi)"
  if [[ "$npm_status" -eq 0 ]]; then
    clear_pending "npm"
    npm_receipt_status="completed"
  else
    npm_receipt_status="failed"
  fi
fi

prune_pnpm_store() {
  local directory="$1" expected_store="$2" expected_version="$3" store_base="$4"
  local actual_store actual_version
  cd "$directory"
  actual_store="$("${offline_probe_env[@]}" pnpm --store-dir "$store_base" store path 2>/dev/null)" || return 1
  actual_store="$(canonical_dir "$actual_store" || printf '%s' "$actual_store")"
  actual_version="$("${offline_probe_env[@]}" pnpm --version 2>/dev/null)" || return 1
  if [[ "$actual_store" != "$expected_store" || "$actual_version" != "$expected_version" ]]; then
    echo "groundwork-cleanup: pnpm selection changed before prune (expected $expected_version at $expected_store; found $actual_version at $actual_store)." >&2
    return 1
  fi
  exec "${offline_probe_env[@]}" pnpm --store-dir "$store_base" store prune
}

echo
echo "pnpm"
if [[ "$retired_discovery_pending" -eq 1 ]]; then
  echo "  Retired an earlier pnpm reminder that recorded only incomplete discovery; no store had been touched, so there was nothing to repair."
fi
if [[ "$pnpm_discovery_failed" -ne 0 && -f "$pending_dir/pnpm" ]]; then
  # A real earlier repair (a prune that started or failed) stays pending and
  # still fails; this run could not select stores to retry it.
  pnpm_receipt_status="failed"
  maintenance_failed=1
  echo "  Maintenance incomplete: an earlier pnpm repair is still pending, and $pnpm_discovery_reason, so it could not be retried; no pnpm store was touched" >&2
elif [[ "$pnpm_discovery_failed" -ne 0 ]]; then
  # Discovery is read-only. Skipping touches no store, records no repair, and
  # leaves the cadence state alone, so the next run simply tries again.
  pnpm_receipt_status="discovery-incomplete"
  echo "  Warning: pnpm store cleanup skipped this run because $pnpm_discovery_reason."
  echo "  No pnpm store was touched, no repair is pending, and the pnpm cadence is unchanged; the next run retries discovery."
  printf '  Discovery limits: GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS=%s, GROUNDWORK_PNPM_DISCOVERY_JOBS=%s (at most 16).\n' \
    "$discovery_deadline" "$discovery_jobs"
  if [[ "$incomplete_discovery_runs" -ge "$discovery_escalation_runs" ]]; then
    printf '  Warning: pnpm stores have not been cleaned for %s runs; discovery has been incomplete every time. See Review recommended.\n' \
      "$incomplete_discovery_runs"
  else
    printf '  Consecutive incomplete discoveries: %s (owner review after %s).\n' \
      "$incomplete_discovery_runs" "$discovery_escalation_runs"
  fi
elif [[ "$pnpm_due" -eq 0 ]]; then
  pnpm_receipt_status="not-due"
  echo "  Maintenance not due: $pnpm_due_reason"
  if [[ -s "$store_candidates" ]]; then
    echo "  Next machine-wide pnpm maintenance: approximately $((monthly_days - last_success_days)) days"
  else
    echo "  Next pnpm maintenance: after an exact pin selects a trusted store"
  fi
elif [[ ! -s "$store_candidates" ]]; then
  pnpm_receipt_status="failed"
  maintenance_failed=1
  mark_pending "pnpm" "pnpm maintenance is pending but no trusted exact-pinned store can be resolved"
  echo "  Maintenance incomplete: no trusted exact-pinned store can be resolved" >&2
else
  echo "  Maintenance due: $pnpm_due_reason"
  echo "  Groundwork will run pnpm's supported store-prune operation on the exact candidates listed below."
  echo "  Repository dependency installations such as node_modules are not modified."
  print_candidates
  mark_pending "pnpm" \
    "pnpm maintenance started, but its commands and final receipt have not completed"
  write_state "$pnpm_attempt" "$(date +%s) $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  stores_pruned=0
  pnpm_before="$pnpm_total"
  while IFS=$'\t' read -r store directory version source _ store_base <&3; do
    [[ -n "$store" ]] || continue
    one_status=0
    run_bounded "pnpm store prune: $store" \
      prune_pnpm_store "$directory" "$store" "$version" "$store_base" || one_status=$?
    case "$one_status" in
      125)
        mark_pending "pnpm" "pnpm store prune could not stop its complete process tree"
        exit 125
        ;;
      129 | 130 | 143)
        mark_pending "pnpm" "pnpm store prune was interrupted (exit $one_status)"
        exit "$one_status"
        ;;
    esac
    if [[ "$one_status" -eq 0 ]]; then
      stores_pruned=$((stores_pruned + 1))
    else
      pnpm_status="$one_status"
      maintenance_failed=1
      record_maintenance_failure_status "$one_status"
    fi
  done 3<"$store_candidates"
  pnpm_after=0
  pnpm_after_complete=1
  while IFS=$'\t' read -r store _; do
    size=""
    capture_dir_bytes size "$store" pnpm || true
    if [[ -z "$size" ]]; then
      pnpm_after_complete=0
    else
      pnpm_after=$((pnpm_after + size))
    fi
  done <"$store_candidates"
  if [[ "$pnpm_status" -eq 0 ]]; then
    write_state "$pnpm_success" "$(date +%s) $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "  Stores pruned: $stores_pruned"
    printf '  Reclaimed: %s\n' \
      "$(if [[ "$pnpm_sizes_complete" -eq 1 && "$pnpm_after_complete" -eq 1 && "$pnpm_after" -le "$pnpm_before" ]]; then format_bytes "$((pnpm_before - pnpm_after))"; else printf 'not measured'; fi)"
    echo "  Next machine-wide pnpm maintenance: approximately $monthly_days days"
    clear_pending "pnpm"
    pnpm_receipt_status="completed"
  else
    mark_pending "pnpm" "pnpm store maintenance failed (exit $pnpm_status)"
    echo "  Store maintenance incomplete (exit $pnpm_status)" >&2
    pnpm_receipt_status="failed"
  fi
fi

echo
echo "Review recommended"
print_review

rm -f -- "$legacy_pending"
if [[ "$maintenance_failed" -eq 0 ]]; then
  clear_pending "maintenance-helper"
fi
package_manager_pending && maintenance_failed=1

if [[ -n "$cleanup_receipt_fd" ]]; then
  printf 'homebrew\t%s\nnpm\t%s\npnpm\t%s\nowner-review\t%s\n' \
    "$homebrew_receipt_status" "$npm_receipt_status" "$pnpm_receipt_status" \
    "$review_item_count" >&"$cleanup_receipt_fd"
fi

if [[ "$maintenance_failed" -ne 0 ]]; then
  if [[ "$nested_update_transaction" -eq 0 ]]; then
    cat >&2 <<'EOF'

Groundwork: package-manager maintenance is incomplete.
Completed updates and cleanup are preserved. Pending stages will keep the
shell reminder active.

Run update-all again to retry the normal maintenance transaction.

To retry maintenance without repeating upgrades:
  groundwork-cleanup --yes

See `groundwork-cleanup --help` for exceptional overrides.
EOF
  fi
  [[ "$maintenance_exit_status" -ne 0 ]] || maintenance_exit_status=1
  exit "$maintenance_exit_status"
fi

echo
echo "Package-manager maintenance completed."
