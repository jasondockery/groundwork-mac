{{- $terminalMultiplexer := includeTemplate "terminal-multiplexer-selection" (dict "root" . "missing" "tmux") | trim -}}
#!/usr/bin/env bash
set -euo pipefail

prog="groundwork-herdr-integrations"
selection={{ $terminalMultiplexer | quote }}

usage() {
  cat <<'EOF'
Usage:
  groundwork-herdr-integrations status
  groundwork-herdr-integrations install --yes
  groundwork-herdr-integrations uninstall --yes

Inspect or explicitly install/remove Herdr session-identity hooks for the
Groundwork agent CLIs Herdr supports on this machine: Claude Code (claude),
Codex (codex), OpenCode (opencode), and Grok (grok). Cursor is included only
when cursor-agent is present. Uninstall still finds Claude Code, Codex,
OpenCode, and Grok from their config directories after the CLI is gone, and
finds Cursor from cursor-agent or from Herdr's hook file. The Cursor desktop
app alone is not enough. Install and uninstall delegate to Herdr's own
integration lifecycle; they never run during chezmoi apply. The exact --yes
is required because agent configuration changes.
EOF
}

action="${1:-}"
case "$action" in
  -h | --help) [[ "$#" -eq 1 ]] || exit 64; usage; exit 0 ;;
  status) [[ "$#" -eq 1 ]] || { usage >&2; exit 64; } ;;
  install | uninstall)
    [[ "$#" -eq 2 && "$2" == --yes ]] || {
      echo "$prog: $action requires the exact command '$prog $action --yes'." >&2
      exit 64
    }
    ;;
  *) usage >&2; exit 64 ;;
esac

case "$selection" in
  herdr | both) ;;
  *)
    echo "$prog: Herdr is not selected (terminal_multiplexer=$selection)." >&2
    echo "Change the selection with groundwork-configure before managing integrations." >&2
    exit 1
    ;;
esac
command -v herdr >/dev/null 2>&1 || {
  echo "$prog: Herdr is selected but not installed; run 'chezmoi apply' first." >&2
  exit 1
}

if [[ "$action" == status ]]; then
  exec herdr integration status
fi

agent_selected() {
  local agent="$1"
  local cursor_dir grok_dir
  case "$action" in
    install)
      case "$agent" in
        claude | codex | opencode | grok)
          if command -v "$agent" >/dev/null 2>&1; then
            return 0
          fi
          ;;
        cursor)
          if command -v cursor-agent >/dev/null 2>&1; then
            return 0
          fi
          ;;
      esac
      return 1
      ;;
    uninstall)
      case "$agent" in
        claude)
          if [[ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]]; then
            return 0
          fi
          ;;
        codex)
          if [[ -d "${CODEX_HOME:-$HOME/.codex}" ]]; then
            return 0
          fi
          ;;
        opencode)
          if [[ -d "$HOME/.config/opencode" ]]; then
            return 0
          fi
          ;;
        grok)
          if [[ -n "${GROK_CONFIG_DIR:-}" ]]; then
            grok_dir="$GROK_CONFIG_DIR"
          else
            grok_dir="${GROK_HOME:-$HOME/.grok}"
          fi
          if [[ -d "$grok_dir" ]]; then
            return 0
          fi
          ;;
        cursor)
          if command -v cursor-agent >/dev/null 2>&1; then
            return 0
          fi
          cursor_dir="${CURSOR_CONFIG_DIR:-$HOME/.cursor}"
          if [[ -f "$cursor_dir/herdr-agent-state.sh" ]]; then
            return 0
          fi
          ;;
      esac
      return 1
      ;;
    *) return 1 ;;
  esac
}

agents=(claude codex opencode grok cursor)
selected_agents=()
for agent in "${agents[@]}"; do
  if agent_selected "$agent"; then
    selected_agents+=("$agent")
  fi
done

if ((${#selected_agents[@]} == 0)); then
  echo "$prog: no Claude Code, Codex, OpenCode, Grok, or Cursor Agent CLI installation was detected; nothing changed."
  exit 0
fi

for agent in "${selected_agents[@]}"; do
  printf '%s %s integration: %s\n' "$action" "$agent" "herdr integration $action $agent"
done
failed_agents=""
succeeded_agents=""
for agent in "${selected_agents[@]}"; do
  if herdr integration "$action" "$agent"; then
    succeeded_agents="${succeeded_agents}${succeeded_agents:+, }$agent"
  else
    failed_agents="${failed_agents}${failed_agents:+, }$agent"
    printf '%s: Herdr %s failed for %s; continuing to report final integration status.\n' "$prog" "$action" "$agent" >&2
  fi
done
status_rc=0
herdr integration status || status_rc=$?
if [[ -n "$failed_agents" ]]; then
  [[ -z "$succeeded_agents" ]] || printf '%s: completed for: %s\n' "$prog" "$succeeded_agents" >&2
  printf '%s: failed for: %s\n' "$prog" "$failed_agents" >&2
  printf "%s: rerun '%s %s --yes' to repair the partial state; successful integrations are idempotent.\n" "$prog" "$prog" "$action" >&2
  exit 1
fi
exit "$status_rc"
