#!/usr/bin/env python3
"""Keep a desktop Mac from idling to sleep while it is on power.

This is the one place Groundwork changes `pmset -c sleep`. A stored reason
asks for it: stay_awake_on_power, or the imessage_gateway role. While any
reason is on, apply sets system sleep on power to 0 and records the earlier
value once. When no reason is left, apply restores that value. Display sleep,
battery sleep, and disablesleep are never changed.
"""
import argparse
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys


PMSET_READ = ['pmset', '-g', 'custom']
PMSET_SLEEP_ZERO = ['sudo', 'pmset', '-c', 'sleep', '0']
STATE_FILENAME = 'stay-awake-ac-sleep'
# The iMessage gateway role wrote its own record before this command existed.
LEGACY_STATE_FILENAME = 'imessage-gateway-ac-sleep'
RECORDED_VALUE = re.compile(r'^(0|[1-9][0-9]{0,5})$')
REASONS = (
    ('stay_awake_on_power', 'Stay awake on power'),
    ('imessage_gateway', 'iMessage gateway'),
)
DATA_BOOL = re.compile(r'^(headless|stay_awake_on_power|imessage_gateway)\s*=\s*(true|false)\s*(?:#.*)?$')
LID_NOTE = (
    'Only system sleep on power is managed. Display sleep and battery sleep stay as macOS has them. '
    'A closed lid still sleeps unless an external display is attached.'
)

SUDO_PREPARE_SCRIPT = r'''
lib="${HOME}/.local/share/groundwork/lib/sudo-preflight.sh"
if [[ ! -r "$lib" ]]; then
  printf 'Groundwork: administrator-permission helper is missing: %s\n' "$lib" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$lib"
groundwork_sudo_prepare
exit $?
'''


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f'{self.prog}: error: {message}', file=sys.stderr)
        self.exit(64)


def run(command, *, timeout=15, capture=True):
    kwargs = {'text': True, 'env': dict(os.environ, LC_ALL='C')}
    if timeout is not None:
        kwargs['timeout'] = timeout
    if capture:
        kwargs['capture_output'] = True
    return subprocess.run(command, **kwargs)


def pmset_restore(value):
    return ['sudo', 'pmset', '-c', 'sleep', value]


def is_wsl():
    path = Path('/proc/sys/kernel/osrelease')
    return path.exists() and 'microsoft' in path.read_text(encoding='utf-8', errors='replace').lower()


def config_path():
    root = Path(os.environ['XDG_CONFIG_HOME']) if os.environ.get('XDG_CONFIG_HOME') else Path.home() / '.config'
    return root / 'chezmoi' / 'chezmoi.toml'


def state_dir():
    root = Path(os.environ['XDG_STATE_HOME']) if os.environ.get('XDG_STATE_HOME') else Path.home() / '.local' / 'state'
    return root / 'groundwork'


def state_path():
    return state_dir() / STATE_FILENAME


def legacy_state_path():
    return state_dir() / LEGACY_STATE_FILENAME


def parse_settings(text):
    section = None
    found = {}
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith('[') and line.endswith(']') and '#' not in line:
            section = line[1:-1].strip()
            continue
        if section != 'data':
            continue
        match = DATA_BOOL.match(line)
        if match:
            found[match.group(1)] = match.group(2) == 'true'
    return found


def load_settings():
    # None means the config could not be read, which is not the same as off.
    try:
        text = config_path().read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError):
        return None
    return parse_settings(text)


def wanted_reasons(settings):
    if settings.get('headless') is not False:
        return []
    return [label for key, label in REASONS if settings.get(key) is True]


def parse_pmset(text):
    section = None
    ac_sleep = None
    battery_sleep = None
    for raw in text.splitlines():
        line = raw.strip().lstrip('*').strip()
        if line in {'AC Power:', 'Battery Power:'}:
            section = 'ac' if line.startswith('AC') else 'battery'
            continue
        if line.endswith(':') and not raw.startswith((' ', '\t')):
            section = None
            continue
        parts = line.split()
        if section and len(parts) >= 2 and parts[0] == 'sleep' and parts[1].isdigit():
            value = int(parts[1])
            if section == 'ac':
                ac_sleep = value
            else:
                battery_sleep = value
    return ac_sleep, battery_sleep


def platform_block():
    if is_wsl():
        return 1, 'WSL has no Mac power settings. Nothing was changed.'
    if shutil.which('omarchy'):
        return 1, 'Use groundwork-omarchy-mac-arm64; never apply this engine on Omarchy. Nothing was changed.'
    if platform.system() != 'Darwin':
        return 1, 'Stay awake on power applies only on a desktop Mac. Nothing was changed.'
    return None


def read_custom():
    result = run(PMSET_READ)
    if result.returncode != 0:
        return None
    return result.stdout or ''


def read_sleep():
    text = read_custom()
    if text is None:
        return None, None
    return parse_pmset(text)


def sudo_prepare():
    # No capture and no short timeout: the password prompt uses the terminal,
    # and sudo's own cancel (130) or "no terminal" (10) is the bound.
    result = run(['bash', '-c', SUDO_PREPARE_SCRIPT], timeout=None, capture=False)
    return result.returncode


def minutes(value):
    return 'not listed' if value is None else str(value)


def ensure_record_destination(path):
    if path.is_symlink():
        raise RuntimeError(f'the recorded AC sleep path is a symlink: {path}.')
    if path.exists() and not path.is_file():
        raise RuntimeError(f'the recorded AC sleep path is not a regular file: {path}.')
    parent = path.parent
    if parent.exists() and not parent.is_dir():
        raise RuntimeError(f'the state directory is not a directory: {parent}.')


def move_record_aside(path):
    # Rename the final component. os.replace does not follow a symlink there,
    # so a planted path cannot redirect the move onto another file.
    for attempt in range(100):
        candidate = path.with_name(f'.{path.name}.aside.{os.getpid()}.{attempt}')
        if candidate.exists() or candidate.is_symlink():
            continue
        os.replace(path, candidate)
        return candidate
    raise RuntimeError(f'could not move the recorded AC sleep path aside: {path}.')


def record_previous(path, value):
    # False means this call did not create the record. An existing path is
    # left as it is, and sleep must not change unless that file is already valid.
    if path.exists() or path.is_symlink():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f'.{path.name}.{os.getpid()}.tmp')
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        os.write(descriptor, f'{value}\n'.encode())
    finally:
        os.close(descriptor)
    try:
        os.replace(temporary, path)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    return True


def read_recorded(path):
    if not path.exists() and not path.is_symlink():
        return None
    if path.is_symlink() or not path.is_file():
        return 'unreadable'
    try:
        text = path.read_text(encoding='utf-8').strip()
    except UnicodeDecodeError:
        return 'unreadable'
    if not RECORDED_VALUE.match(text):
        return 'unreadable'
    return text


def adopt_legacy_record():
    # Move the gateway's old record to the shared name so there is one record.
    # When the shared record already exists it wins, and the old file is set
    # aside so a later apply can never restore its obsolete value.
    legacy = legacy_state_path()
    destination = state_path()
    if not (legacy.exists() or legacy.is_symlink()):
        return
    if destination.exists() or destination.is_symlink():
        if read_recorded(destination) == 'unreadable':
            # Keep both files; the shared record's own check reports it.
            return
        aside = move_record_aside(legacy)
        print(f'Set aside the earlier iMessage gateway sleep record at {aside}; {destination} is the record now.')
        return
    if read_recorded(legacy) == 'unreadable':
        raise RuntimeError(
            f'the earlier iMessage gateway sleep record at {legacy} cannot be restored. '
            'Check the value, then remove the file or replace it with one integer.'
        )
    os.replace(legacy, destination)
    print(f'Moved the earlier iMessage gateway sleep record to {destination}.')


def report_sudo_refusal(status, action):
    if status == 10:
        print(f'Groundwork: {action} needs an administrator password.')
        print('Nothing was changed. From a terminal on this machine, run chezmoi apply and enter your password when asked.')
        return 0
    if status == 130:
        print('Groundwork: the password prompt was cancelled. Nothing was changed.', file=sys.stderr)
        return 130
    print(f'Groundwork: administrator permission was not granted (exit {status}). Nothing was changed.', file=sys.stderr)
    return status


def keep_awake(reasons):
    destination = state_path()
    ac_sleep, battery_sleep = read_sleep()
    if ac_sleep is None:
        print('Stay awake: AC sleep could not be read from `pmset -g custom`. Nothing was changed.', file=sys.stderr)
        return 1
    wanted = ', '.join(reasons)
    if ac_sleep == 0:
        print(f'AC sleep is already 0 ({wanted}). Battery sleep was not changed ({minutes(battery_sleep)}).')
        return 0
    try:
        ensure_record_destination(destination)
    except RuntimeError as error:
        print(f'Stay awake: {error} Nothing was changed.', file=sys.stderr)
        return 1
    record_absent_before_prompt = not (destination.exists() or destination.is_symlink())
    if not record_absent_before_prompt and read_recorded(destination) == 'unreadable':
        print(
            f'Stay awake: the recorded AC sleep value at {destination} cannot be restored. '
            'Check the value, then remove the file or replace it with one integer. Nothing was changed.',
            file=sys.stderr,
        )
        return 1
    status = sudo_prepare()
    if status != 0:
        return report_sudo_refusal(status, 'changing AC sleep')
    # The password prompt is a gap. A new file created while it waits is
    # not the previous sleep value, even when its text looks valid.
    unchanged = 'AC sleep was not changed. Battery sleep was not changed.'
    try:
        ensure_record_destination(destination)
    except RuntimeError as error:
        print(f'Stay awake: {error} {unchanged}', file=sys.stderr)
        return 1
    if record_absent_before_prompt and destination.is_file():
        aside = move_record_aside(destination)
        print(
            f'Stay awake: a file appeared at the sleep record during the password prompt and was moved to {aside}. {unchanged}',
            file=sys.stderr,
        )
        return 1
    if not record_absent_before_prompt and read_recorded(destination) in (None, 'unreadable'):
        print(f'Stay awake: the recorded AC sleep value at {destination} cannot be restored. Check the value, then remove the file or replace it with one integer. {unchanged}', file=sys.stderr)
        return 1
    wrote = record_previous(destination, ac_sleep)
    if record_absent_before_prompt and not wrote:
        print(f'Stay awake: the previous AC sleep value was not recorded at {destination}. {unchanged}', file=sys.stderr)
        return 1
    result = run(PMSET_SLEEP_ZERO)
    if result.returncode != 0:
        print(unchanged, file=sys.stderr)
        if wrote:
            print(f'The previous AC sleep value {ac_sleep} is recorded at {destination}.', file=sys.stderr)
        return 1
    if wrote:
        print(f'Recorded the previous AC sleep value {ac_sleep} at {destination}.')
    print(f'AC sleep is now 0 while on power ({wanted}). Battery sleep was not changed ({minutes(battery_sleep)}).')
    return 0


def restore():
    destination = state_path()
    recorded = read_recorded(destination)
    if recorded is None:
        print('Stay awake on power is off, and no earlier AC sleep value is recorded. Nothing was changed.')
        return 0
    if recorded == 'unreadable':
        print(f'Stay awake: the recorded AC sleep value at {destination} cannot be restored. Check the value, then remove the file or replace it with one integer. Nothing was changed.', file=sys.stderr)
        return 1
    ac_sleep, _battery = read_sleep()
    if ac_sleep is None:
        print('Stay awake: AC sleep could not be read from `pmset -g custom`. Nothing was changed.', file=sys.stderr)
        return 1
    value = int(recorded)
    if ac_sleep == value:
        destination.unlink()
        print(f'AC sleep is already {value}. Removed the record at {destination}.')
        return 0
    if ac_sleep != 0:
        # Someone changed it since Groundwork set 0. Their value wins.
        destination.unlink()
        print(f'AC sleep is {ac_sleep}, not 0, so it was left as it is. Removed the recorded value {value} at {destination}.')
        return 0
    status = sudo_prepare()
    if status != 0:
        return report_sudo_refusal(status, 'restoring AC sleep')
    if read_recorded(destination) != recorded:
        print(f'Stay awake: the record at {destination} changed during the password prompt. AC sleep was not changed.', file=sys.stderr)
        return 1
    result = run(pmset_restore(recorded))
    if result.returncode != 0:
        print(f'AC sleep was not changed. The earlier value {value} is still recorded at {destination}.', file=sys.stderr)
        return 1
    destination.unlink()
    print(f'Restored AC sleep to {value}. Removed the record at {destination}.')
    return 0


def apply():
    block = platform_block()
    if block:
        print(block[1], file=sys.stderr)
        return block[0]
    settings = load_settings()
    if settings is None:
        print(f'Stay awake: the chezmoi config at {config_path()} could not be read. Nothing was changed.', file=sys.stderr)
        return 1
    try:
        adopt_legacy_record()
    except RuntimeError as error:
        print(f'Stay awake: {error} Nothing was changed.', file=sys.stderr)
        return 1
    # A Mac that is not a desktop never wants sleep held at 0, but it still
    # restores a value recorded while it was one.
    reasons = wanted_reasons(settings)
    if reasons:
        return keep_awake(reasons)
    return restore()


def stored(value):
    return 'on' if value is True else 'off' if value is False else 'unset'


def status():
    block = platform_block()
    if block:
        print(block[1], file=sys.stderr)
        return block[0]
    settings = load_settings()
    known = settings is not None
    if not known:
        print(f'Stay awake: the chezmoi config at {config_path()} could not be read; the stored reasons are unknown.', file=sys.stderr)
        settings = {}
    for key, label in REASONS:
        print(f'{label}: {stored(settings.get(key))} ({key})')
    reasons = wanted_reasons(settings)
    if not known:
        print('Wanted here: unknown (config unreadable)')
    elif settings.get('headless') is not False:
        print('Wanted here: no (not a desktop Mac)')
    elif reasons:
        print('Wanted here: yes (' + ', '.join(reasons) + ')')
    else:
        print('Wanted here: no')
    for path in (state_path(), legacy_state_path()):
        recorded = read_recorded(path)
        if recorded is not None:
            print(f'Recorded previous AC sleep: {recorded} ({path})')
            if known and not reasons and recorded != 'unreadable':
                print(f'The next apply restores AC sleep to {recorded} unless it was changed by hand.')
            break
    else:
        print(f'Recorded previous AC sleep: not recorded ({state_path()})')
    text = read_custom()
    if text is None:
        print('Stay awake: `pmset -g custom` could not be read. The report is incomplete.', file=sys.stderr)
        return 1
    print('pmset -g custom:')
    for line in text.splitlines():
        print('  ' + line)
    print(LID_NOTE)
    return 0


def build_parser():
    parser = Parser(
        prog='groundwork-stay-awake',
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Actions:
  status   Report the stored reasons, the recorded earlier AC sleep value, and `pmset -g custom`. Changes nothing. This is the default.
  apply    Run by a desktop apply. While a reason is on, set AC sleep to 0 and record the earlier value once. When none is on, restore that value. A non-interactive apply defers the administrator prompt instead of aborting.

Turn stay_awake_on_power on or off with groundwork-configure. Linux, WSL, and Omarchy do not apply it. A headless Mac never holds sleep at 0, but it still restores a value recorded while it was a desktop.
'''.strip(),
    )
    parser.add_argument('action', nargs='?', default='status', choices=('status', 'apply'))
    return parser


def main(argv=None):
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        code = exc.code
        return 0 if code is None else int(code)
    try:
        if args.action == 'apply':
            return apply()
        return status()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('Stay awake: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
