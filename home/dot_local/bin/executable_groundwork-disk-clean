#!/usr/bin/env bash
set -euo pipefail
# Target: bash 3.2+ (stock macOS /bin/bash) and GNU or BSD userland.

# On-demand front door for freeing disk space (specs/storage-hygiene.md).
# Package-manager and Docker cleanup stay with their owners: this command shows
# their read-only or dry-run output and, after confirmation, runs
# `groundwork-cleanup --yes` and `groundwork-docker-cache-tidy --yes`. It owns
# only mise version pruning and the Colima disk trim. update-all never invokes
# it, and it refuses to run inside an update-all transaction.

usage() {
  cat <<'EOF'
Preview the disk space Groundwork's tools can free, then free it only after
you confirm each category.

Usage:
  groundwork-disk-clean            preview, then ask before each category
  groundwork-disk-clean --dry-run  preview only; never asks, never deletes
  groundwork-disk-clean -h|--help  show this help

Categories (each appears only when its tool is installed):
  Package managers    Preview: Homebrew's own dry runs of the two commands
                      below plus the read-only groundwork-cleanup report.
                      Confirmed: runs groundwork-cleanup --yes, which runs
                      brew autoremove (uninstalls orphaned formula dependencies
                      that no installed formula or cask needs), then
                      brew cleanup --prune=all, npm cache verify, and pnpm
                      store prune when its report says that is due.
  mise                mise uninstall of the exact versions that
                      `mise ls --prunable` reports: versions that no tracked
                      config and no running process uses.
  Docker              Preview: the groundwork-docker-cache-tidy dry run.
                      Confirmed: runs groundwork-docker-cache-tidy --yes,
                      which is daemon-wide: every project's stopped
                      containers, dangling images, and builder cache toward
                      its retention target. It refuses a remote endpoint or
                      builder.
  Colima disk         colima ssh -- sudo fstrim -a: returns unused blocks in
                      the running Colima VM to the host disk.

Never touched: your files and projects (node_modules, .venv, and other build
output), application data, requested formulae and casks, Docker volumes,
running containers, and tagged images.

Without a terminal on stdin and stderr, or with --dry-run, this command only
previews. No flag deletes without asking. Nothing runs until every question
is answered, and the machine maintenance lock is taken only then. Homebrew
and mise are checked again just before they act and skipped if their plan
changed; Docker is checked again and skipped if acting is no longer allowed.
It refuses to run inside update-all, and update-all never runs it. Docker and
Colima are never started for you.

Every step has a deadline and stops on Ctrl-C. The receipt at the end says
what ran, what failed, and what was left.

Advanced: GROUNDWORK_DISK_CLEAN_DEADLINE_SECONDS (each mise or Colima step,
default 1800) and GROUNDWORK_DISK_CLEAN_OBSERVE_DEADLINE_SECONDS (each
preview query, default 120) accept whole seconds from 1 through 3600. The
delegated commands keep their own deadlines.

More help:
  groundwork-help disk
  https://jasondockery.github.io/groundwork/shell.html#disk-clean
EOF
}

die_usage() {
  echo "groundwork-disk-clean: $1" >&2
  echo "Run 'groundwork-disk-clean --help' for usage." >&2
  exit 64
}

dry_run=0
while (($#)); do
  case "$1" in
    --dry-run) dry_run=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die_usage "unknown option: $1" ;;
    *) die_usage "unexpected argument: $1 (this command takes no positional arguments)" ;;
  esac
  shift
done

op_deadline="${GROUNDWORK_DISK_CLEAN_DEADLINE_SECONDS:-1800}"
observe_deadline="${GROUNDWORK_DISK_CLEAN_OBSERVE_DEADLINE_SECONDS:-120}"
for disk_clean_deadline in "$op_deadline" "$observe_deadline"; do
  if [[ ! "$disk_clean_deadline" =~ ^[0-9]{1,4}$ ]] \
    || ((10#$disk_clean_deadline < 1 || 10#$disk_clean_deadline > 3600)); then
    die_usage "deadlines must be whole seconds from 1 through 3600."
  fi
done
unset disk_clean_deadline
op_deadline=$((10#$op_deadline))
observe_deadline=$((10#$observe_deadline))

if [[ -n "${GROUNDWORK_UPDATE_LOCK_HELD:-}" || -n "${GROUNDWORK_UPDATE_LOCK_TOKEN:-}" ]]; then
  echo "groundwork-disk-clean: refusing to run inside update-all or another Groundwork maintenance run." >&2
  echo "Run it on its own after that run finishes. No change was made." >&2
  exit 75
fi

platform="$("$HOME/.local/bin/groundwork-platform" 2>/dev/null || echo unknown)"
case "$platform" in
  darwin | linux | wsl2) ;;
  wsl1)
    echo "groundwork-disk-clean: WSL1 is unsupported; Groundwork requires WSL2. No change was made." >&2
    exit 1
    ;;
  wsl-unknown)
    echo "groundwork-disk-clean: could not verify WSL2. From PowerShell, run \`wsl --list --verbose\`. No change was made." >&2
    exit 1
    ;;
  unknown)
    echo "groundwork-disk-clean: the platform helper is missing or failed: $HOME/.local/bin/groundwork-platform" >&2
    echo "Restore it with: chezmoi apply --exclude=scripts ~/.local/bin/groundwork-platform" >&2
    exit 1
    ;;
  *)
    echo "groundwork-disk-clean: unsupported platform: $platform. No change was made." >&2
    exit 1
    ;;
esac

cleanup_command="$HOME/.local/bin/groundwork-cleanup"
docker_tidy_command="$HOME/.local/bin/groundwork-docker-cache-tidy"
lib_dir="$HOME/.local/share/groundwork/lib"
runner_lib="$lib_dir/maintenance-runner.sh"
colima_lib="$lib_dir/colima-home.sh"
lock_lib="$HOME/.local/lib/groundwork/update-lock.sh"
if [[ ! -r "$runner_lib" ]]; then
  echo "groundwork-disk-clean: the bounded maintenance runner is missing: $runner_lib" >&2
  echo "Restore it with: chezmoi apply --exclude=scripts ~/.local/share/groundwork" >&2
  exit 1
fi
# Globals read by the sourced bounded runner.
deadline="$op_deadline"
heartbeat=30
cancel_grace=2
poll_seconds=0.2
orphan_grace=5
# shellcheck disable=SC2034 # Read dynamically by the sourced bounded runner.
: "$deadline" "$heartbeat" "$cancel_grace" "$poll_seconds" "$orphan_grace" "$observe_deadline"
# shellcheck source=/dev/null
source "$runner_lib"

interactive=0
preview_reason=""
if [[ "$dry_run" -eq 1 ]]; then
  preview_reason="--dry-run was given"
elif [[ -t 0 && -t 2 ]]; then
  interactive=1
else
  preview_reason="stdin and stderr are not both a terminal, so nothing can be confirmed"
fi

categories="packages mise docker colima"
work=""
acting=0
lock_held=0
final_status=0

category_title() {
  case "$1" in
    packages) printf 'Package managers' ;;
    mise) printf 'mise' ;;
    docker) printf 'Docker' ;;
    colima) printf 'Colima disk' ;;
  esac
}

record() { # category outcome
  printf '%s\t%s\n' "$(category_title "$1")" "$2" >>"$work/receipt"
}

# shellcheck disable=SC2329 # Called from the EXIT trap handler.
print_receipt() {
  local title outcome
  echo
  echo "Receipt"
  if [[ ! -s "$work/receipt" ]]; then
    echo "  Nothing was removed."
    return 0
  fi
  while IFS=$'\t' read -r title outcome; do
    printf '  %-17s %s\n' "$title" "$outcome"
  done <"$work/receipt"
}

# shellcheck disable=SC2329 # Invoked by the EXIT trap below.
on_exit() {
  local status=$?
  trap - EXIT
  if [[ "$acting" -eq 1 && -n "$work" ]]; then
    print_receipt || true
  elif [[ -n "$work" ]]; then
    case "$status" in
      124 | 125 | 129 | 130 | 143)
        echo >&2
        echo "groundwork-disk-clean: stopped (exit $status) before anything was removed." >&2
        ;;
    esac
  fi
  if [[ "$lock_held" -eq 1 ]] && type groundwork_lock_release >/dev/null 2>&1; then
    groundwork_lock_release || true
  fi
  [[ -z "$work" ]] || rm -rf -- "$work" || true
  exit "$status"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

work="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-disk-clean.XXXXXX")"
: >"$work/receipt"

format_bytes() {
  awk -v bytes="$1" 'BEGIN {
    split("B KiB MiB GiB TiB", unit, " ")
    index_ = 1
    while (bytes >= 1024 && index_ < 5) { bytes /= 1024; index_++ }
    if (index_ == 1) printf "%d %s", bytes, unit[index_]
    else printf "%.1f %s", bytes, unit[index_]
  }'
}

describe_bytes() {
  printf '%s (%s bytes)' "$(format_bytes "$1")" "$1"
}

has_control() {
  [[ "$(LC_ALL=C printf '%s' "$1" | tr -d '[:cntrl:]')" != "$1" ]]
}

# state file: status<TAB>reason. Status is ready, empty, unavailable, or skipped.
set_state() { # dir status reason
  printf '%s\t%s\n' "$2" "${3:-}" >"$1/state"
}

state_of() {
  cut -f 1 "$1/state"
}

reason_of() {
  cut -f 2- "$1/state"
}

total_of() { # items file
  awk -F '\t' '{ sum += $2 } END { printf "%.0f", sum + 0 }' "$1"
}

count_of() {
  awk 'END { print NR + 0 }' "$1"
}

finish_state() { # dir; ready when items exist, otherwise empty
  if [[ -s "$1/items" ]]; then
    set_state "$1" ready
  else
    set_state "$1" empty "nothing to free"
  fi
}

ids_of() {
  cut -f 1 "$1" | LC_ALL=C sort
}

indent() { # file
  sed 's/^/    /' "$1"
}

# shellcheck disable=SC2329 # Run through run_bounded_capture.
du_paths() {
  local list="$1" path
  while IFS= read -r path; do
    printf '%s\0' "$path"
  done <"$list" | xargs -0 du -sk --
}

# Measure each listed path in one bounded pass and write path<TAB>bytes for
# every path du could measure. A path that vanished is simply not listed.
measure_paths() { # list output
  local list="$1" output="$2" raw="$work/du.$RANDOM" status=0
  : >"$output"
  [[ -s "$list" ]] || return 0
  run_bounded_capture "measure $(count_of "$list") path(s)" "$raw" du_paths "$list" 2>/dev/null || status=$?
  exit_if_terminal_status "$status"
  case "$status" in
    0 | 1 | 123) ;;
    *)
      rm -f -- "$raw"
      return "$status"
      ;;
  esac
  awk -F '\t' 'NR == FNR { wanted[$0] = 1; next }
    {
      blocks = $1
      path = substr($0, length($1) + 2)
      if ((path in wanted) && blocks ~ /^[0-9]+$/) printf "%s\t%.0f\n", path, blocks * 1024
    }' "$list" "$raw" >"$output"
  rm -f -- "$raw"
}

# ---- Package managers (owner: groundwork-cleanup) ----------------------------

# shellcheck disable=SC2329 # Run through run_bounded_capture.
brew_autoremove_dry_run() {
  cd "$HOME"
  exec brew autoremove --dry-run
}

# shellcheck disable=SC2329 # Run through run_bounded_capture.
brew_cleanup_dry_run() {
  cd "$HOME"
  exec brew cleanup --prune=all --dry-run
}

# Read one Homebrew dry run. Every non-empty stdout line must match a form
# Homebrew's cleanup code prints (Library/Homebrew/cleanup.rb and
# cmd/cleanup.rb); anything else fails closed. Appends formula names to
# names, display lines to lines, and size-free comparison keys to keys.
parse_brew_dry_run() { # raw dir
  local raw="$1" dir="$2" line in_names=0 esc
  esc="$(printf '\033')"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(printf '%s' "$line" | sed "s/${esc}\[[0-9;]*m//g")"
    if has_control "$line"; then
      printf 'a line with terminal control characters\n' >"$dir/unrecognised"
      return 1
    fi
    [[ -n "$line" ]] || continue
    if [[ "$in_names" -eq 1 && "$line" =~ ^[A-Za-z0-9][A-Za-z0-9@+._/-]*$ ]]; then
      printf '%s\n' "$line" >>"$dir/names"
      printf 'autoremove\t%s\n' "$line" >>"$dir/keys"
      continue
    fi
    in_names=0
    case "$line" in
      "==> Would autoremove "*" unneeded formula:" | "==> Would autoremove "*" unneeded formulae:")
        in_names=1
        ;;
      "Would remove (broken link): /"* | "Would remove (empty directory): /"*)
        printf '%s\n' "$line" >>"$dir/lines"
        printf 'remove\t%s\n' "$line" >>"$dir/keys"
        ;;
      "Would remove: /"*" ("*")")
        printf '%s\n' "$line" >>"$dir/lines"
        printf 'remove\t%s\n' "${line% (*}" >>"$dir/keys"
        ;;
      "Would prune "*" from: /"*)
        printf '%s\n' "$line" >>"$dir/lines"
        printf 'prune\t%s\n' "${line##* from: }" >>"$dir/keys"
        ;;
      "Would remove "[!:\(]*)
        # git clean -nx output for superseded portable-Ruby bundler paths.
        printf '%s\n' "$line" >>"$dir/lines"
        printf 'remove\t%s\n' "$line" >>"$dir/keys"
        ;;
      "==> This operation would free approximately "*" of disk space.")
        printf '%s\n' "${line#==> }" >"$dir/summary"
        ;;
      *)
        printf '%s\n' "$line" >"$dir/unrecognised"
        return 1
        ;;
    esac
  done <"$raw"
}

plan_packages() {
  local dir="$1" status=0
  : >"$dir/names"
  : >"$dir/lines"
  : >"$dir/keys"
  if [[ ! -x "$cleanup_command" ]]; then
    set_state "$dir" unavailable "groundwork-cleanup is missing: $cleanup_command"
    return 0
  fi
  "$cleanup_command" </dev/null >"$dir/report" 2>"$dir/report.err" || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    set_state "$dir" unavailable "the groundwork-cleanup report failed (exit $status)"
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    status=0
    run_bounded_capture "brew autoremove --dry-run" "$dir/autoremove.raw" brew_autoremove_dry_run || status=$?
    exit_if_terminal_status "$status"
    if [[ "$status" -ne 0 ]]; then
      set_state "$dir" unavailable "brew autoremove --dry-run failed (exit $status)"
      return 0
    fi
    status=0
    run_bounded_capture "brew cleanup --prune=all --dry-run" "$dir/cleanup.raw" brew_cleanup_dry_run || status=$?
    exit_if_terminal_status "$status"
    if [[ "$status" -ne 0 ]]; then
      set_state "$dir" unavailable "brew cleanup --dry-run failed (exit $status)"
      return 0
    fi
    if ! parse_brew_dry_run "$dir/autoremove.raw" "$dir" \
      || ! parse_brew_dry_run "$dir/cleanup.raw" "$dir"; then
      set_state "$dir" unavailable "a Homebrew dry run printed a line Groundwork does not recognise ($(cat "$dir/unrecognised")); nothing will run"
      return 0
    fi
    LC_ALL=C sort -u -o "$dir/names" "$dir/names"
    LC_ALL=C sort -u -o "$dir/keys" "$dir/keys"
  fi
  cut -f 2- "$dir/keys" | awk '{ printf "%s\t0\t%s\n", $0, $0 }' >"$dir/items"
  set_state "$dir" ready
}

print_packages() {
  local dir="$1"
  if command -v brew >/dev/null 2>&1; then
    if [[ -s "$dir/names" ]]; then
      printf '  brew autoremove would uninstall %s orphaned formula(e) that no installed formula or cask needs:\n' \
        "$(count_of "$dir/names")"
      indent "$dir/names"
    else
      echo "  brew autoremove: no orphaned formulae."
    fi
    if [[ -s "$dir/lines" ]]; then
      echo "  brew cleanup --prune=all would remove (sizes as Homebrew reports them):"
      indent "$dir/lines"
      [[ ! -s "$dir/summary" ]] || printf '    %s\n' "$(cat "$dir/summary")"
    else
      echo "  brew cleanup --prune=all: nothing to remove."
    fi
  else
    echo "  Homebrew is not installed."
  fi
  echo "  groundwork-cleanup report (read-only):"
  indent "$dir/report"
  if [[ -s "$dir/report.err" ]]; then
    echo "  groundwork-cleanup messages:"
    indent "$dir/report.err"
  fi
  echo "  Runs:  groundwork-cleanup --yes (brew autoremove; brew cleanup --prune=all;"
  echo "         npm cache verify; pnpm store prune only when the report says due)"
}

execute_packages() {
  local dir="$1" fresh="$2" status=0
  mkdir -p "$fresh"
  plan_packages "$fresh"
  if [[ "$(state_of "$fresh")" != ready ]]; then
    record packages "not run: no longer ready ($(reason_of "$fresh")); nothing was removed"
    return 0
  fi
  if [[ "$(cat "$dir/keys")" != "$(cat "$fresh/keys")" ]]; then
    record packages "not run: Homebrew's plan changed after the preview; nothing was removed. Run groundwork-disk-clean again."
    return 0
  fi
  echo "  Running: groundwork-cleanup --yes (it bounds and reports each of its own steps)"
  "$cleanup_command" --yes </dev/null || status=$?
  case "$status" in
    0) record packages "groundwork-cleanup --yes completed; its receipt is above" ;;
    129 | 130 | 143)
      record packages "groundwork-cleanup --yes was interrupted (exit $status); its output above says what finished"
      exit "$status"
      ;;
    *)
      record packages "groundwork-cleanup --yes exited $status; its output above names what is pending. Retry: groundwork-cleanup --yes"
      final_status=1
      ;;
  esac
}

# ---- mise ----------------------------------------------------------------------

# shellcheck disable=SC2329 # Run through run_bounded_capture.
mise_prunable() {
  cd "$HOME"
  exec mise ls --prunable --json
}

# shellcheck disable=SC2329 # Run through run_bounded.
mise_uninstall() {
  cd "$HOME"
  exec mise uninstall "$@"
}

plan_mise() {
  local dir="$1" status=0
  if ! command -v mise >/dev/null 2>&1; then
    set_state "$dir" unavailable "mise is not installed"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    set_state "$dir" unavailable "jq is required to read mise's version list"
    return 0
  fi
  run_bounded_capture "mise ls --prunable --json" "$dir/raw" mise_prunable || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    set_state "$dir" unavailable "mise ls --prunable failed (exit $status)"
    return 0
  fi
  if ! jq -r 'if type == "object" then . else error("not an object") end
      | to_entries[] | .key as $tool | .value[]
      | select(.installed == true)
      | if (.version | type) == "string" and (.install_path | type) == "string"
        then [($tool + "@" + .version), .install_path] | @tsv
        else error("incomplete record") end' \
    "$dir/raw" >"$dir/pairs" 2>/dev/null; then
    set_state "$dir" unavailable "mise returned a version list Groundwork could not verify"
    return 0
  fi
  if awk -F '\t' '$2 !~ /^\// || NF != 2 { bad = 1 } END { exit !bad }' "$dir/pairs" \
    || has_control "$(tr -d '\t\n' <"$dir/pairs")"; then
    set_state "$dir" unavailable "mise listed an install path Groundwork cannot display safely"
    return 0
  fi
  cut -f 2 "$dir/pairs" >"$dir/paths"
  status=0
  measure_paths "$dir/paths" "$dir/sizes" || status=$?
  if [[ "$status" -ne 0 ]]; then
    set_state "$dir" unavailable "measuring mise install folders failed (exit $status)"
    return 0
  fi
  awk -F '\t' 'NR == FNR { size[$1] = $2; next }
    ($2 in size) { printf "%s\t%s\t%s  %s\n", $1, size[$2], $1, $2 }' \
    "$dir/sizes" "$dir/pairs" >"$dir/items"
  finish_state "$dir"
}

execute_mise() {
  local dir="$1" fresh="$2" status=0 versions=() id path bytes removed=0 removed_bytes=0 left=0
  replan_matches mise "$dir" "$fresh" || return 0
  while IFS=$'\t' read -r id _ _; do
    versions+=("$id")
  done <"$fresh/items"
  run_bounded "mise uninstall (${#versions[@]} version(s))" mise_uninstall "${versions[@]}" || status=$?
  terminal_outcome mise "$status" || true
  while IFS=$'\t' read -r id path; do
    bytes="$(awk -F '\t' -v id="$id" '$1 == id { print $2; exit }' "$fresh/items")"
    [[ -n "$bytes" ]] || continue
    if [[ -e "$path" ]]; then
      left=$((left + 1))
    else
      removed=$((removed + 1))
      removed_bytes=$((removed_bytes + bytes))
    fi
  done <"$fresh/pairs"
  if [[ "$status" -eq 0 && "$left" -eq 0 ]]; then
    record mise "uninstalled $removed version(s), freed $(describe_bytes "$removed_bytes")"
  else
    record mise "incomplete (exit $status): uninstalled $removed version(s), freed $(describe_bytes "$removed_bytes"); $left left"
    final_status=1
  fi
}

# ---- Docker (owner: groundwork-docker-cache-tidy) ----------------------------

plan_docker() {
  local dir="$1" status=0 reason
  if [[ ! -x "$docker_tidy_command" ]]; then
    set_state "$dir" unavailable "groundwork-docker-cache-tidy is missing: $docker_tidy_command"
    return 0
  fi
  "$docker_tidy_command" </dev/null >"$dir/report" 2>"$dir/report.err" || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    reason="$(sed '/^$/d' "$dir/report.err" "$dir/report" | tail -n 1)"
    set_state "$dir" skipped "the groundwork-docker-cache-tidy dry run exited $status: ${reason:-no message}"
    return 0
  fi
  if grep -Eq '^  acting +--yes is allowed: ' "$dir/report"; then
    printf 'docker\t0\tgroundwork-docker-cache-tidy --yes\n' >"$dir/items"
    set_state "$dir" ready
    return 0
  fi
  reason="$(sed -n 's/^  acting  *--yes would refuse: //p' "$dir/report" | head -n 1)"
  if [[ -n "$reason" ]]; then
    set_state "$dir" unavailable "groundwork-docker-cache-tidy --yes would refuse: $reason"
  else
    reason="$(sed '/^$/d' "$dir/report" | tail -n 1)"
    set_state "$dir" skipped "the groundwork-docker-cache-tidy dry run reached no acting check: ${reason:-no output}"
  fi
}

print_docker() {
  echo "  groundwork-docker-cache-tidy dry run (read-only):"
  indent "$1/report"
  if [[ -s "$1/report.err" ]]; then
    echo "  groundwork-docker-cache-tidy messages:"
    indent "$1/report.err"
  fi
  echo "  Runs:  groundwork-docker-cache-tidy --yes (daemon-wide, every project: stopped"
  echo "         containers, dangling images, builder cache toward the target above)"
}

execute_docker() {
  local dir="$1" fresh="$2" status=0
  mkdir -p "$fresh"
  plan_docker "$fresh"
  if [[ "$(state_of "$fresh")" != ready ]]; then
    record docker "not run: $(reason_of "$fresh"); nothing was removed"
    return 0
  fi
  echo "  Running: groundwork-docker-cache-tidy --yes (it bounds each of its own steps)"
  "$docker_tidy_command" --yes </dev/null || status=$?
  case "$status" in
    0) record docker "groundwork-docker-cache-tidy --yes completed; its before and after report is above" ;;
    129 | 130 | 143)
      record docker "groundwork-docker-cache-tidy --yes was interrupted (exit $status); some prunes may have finished"
      exit "$status"
      ;;
    *)
      record docker "groundwork-docker-cache-tidy --yes exited $status; see its output above"
      final_status=1
      ;;
  esac
}

# ---- Colima --------------------------------------------------------------------

# shellcheck disable=SC2329 # Run through run_bounded_capture.
colima_status() {
  exec colima --profile="$GW_COLIMA_PROFILE" status
}

# shellcheck disable=SC2329 # Run through run_bounded.
colima_trim() {
  exec colima --profile="$GW_COLIMA_PROFILE" ssh -- sudo fstrim -a
}

plan_colima() {
  local dir="$1" status=0 candidate
  if ! command -v colima >/dev/null 2>&1; then
    set_state "$dir" unavailable "Colima is not installed"
    return 0
  fi
  if [[ ! -r "$colima_lib" ]]; then
    set_state "$dir" unavailable "the Colima home library is missing: $colima_lib"
    return 0
  fi
  # shellcheck source=/dev/null
  source "$colima_lib"
  if ! gw_colima_resolve; then
    set_state "$dir" unavailable "the Colima home or profile could not be resolved safely"
    return 0
  fi
  run_bounded_capture "colima status" "$dir/raw" colima_status >/dev/null 2>&1 || status=$?
  exit_if_terminal_status "$status"
  if [[ "$status" -ne 0 ]]; then
    set_state "$dir" skipped "Colima profile $GW_COLIMA_PROFILE is not running; Groundwork does not start it here (Colima also returns unused space when it starts)"
    return 0
  fi
  : >"$dir/paths"
  for candidate in "$GW_COLIMA_DATADISK" "$GW_COLIMA_LIMA_HOME/$GW_COLIMA_PROFILE_ID/diffdisk"; do
    if [[ -f "$candidate" && ! -L "$candidate" ]] && ! has_control "$candidate"; then
      printf '%s\n' "$candidate" >>"$dir/paths"
    fi
  done
  if [[ ! -s "$dir/paths" ]]; then
    set_state "$dir" unavailable "the running profile's disk files were not found under $GW_COLIMA_LIMA_HOME"
    return 0
  fi
  status=0
  measure_paths "$dir/paths" "$dir/sizes" || status=$?
  if [[ "$status" -ne 0 ]]; then
    set_state "$dir" unavailable "measuring the Colima disk failed (exit $status)"
    return 0
  fi
  awk -F '\t' '{ printf "%s\t%s\t%s (on disk now)\n", $1, $2, $1 }' "$dir/sizes" >"$dir/items"
  finish_state "$dir"
}

execute_colima() {
  local dir="$1" fresh="$2" status=0 before after measure_status=0
  replan_matches colima "$dir" "$fresh" || return 0
  before="$(total_of "$fresh/items")"
  run_bounded "colima ssh -- sudo fstrim -a" colima_trim || status=$?
  terminal_outcome colima "$status" || true
  measure_paths "$fresh/paths" "$fresh/after" || measure_status=$?
  if [[ "$measure_status" -ne 0 || ! -s "$fresh/after" ]]; then
    record colima "receipt incomplete: trim exited $status and the disk could not be measured afterwards"
    final_status=1
    return 0
  fi
  after="$(total_of "$fresh/after")"
  if [[ "$status" -ne 0 ]]; then
    record colima "failed (exit $status); on disk $(format_bytes "$before") before, $(format_bytes "$after") after"
    final_status=1
  elif [[ "$after" -lt "$before" ]]; then
    record colima "trimmed; returned $(describe_bytes "$((before - after))") to the host disk"
  else
    record colima "trimmed; no change in on-disk size was measured ($(format_bytes "$after"))"
  fi
}

# ---- Preview -------------------------------------------------------------------

plan_category() { # category dir
  mkdir -p "$2"
  : >"$2/items"
  case "$1" in
    packages) plan_packages "$2" ;;
    mise) plan_mise "$2" ;;
    docker) plan_docker "$2" ;;
    colima) plan_colima "$2" ;;
  esac
}

print_owned_items() { # category dir
  local bytes display
  printf '%s: %s item(s), %s\n' "$(category_title "$1")" "$(count_of "$2/items")" \
    "$(describe_bytes "$(total_of "$2/items")")"
  while IFS=$'\t' read -r _ bytes display; do
    printf '  %10s  %s\n' "$(format_bytes "$bytes")" "$display"
  done <"$2/items"
  case "$1" in
    mise)
      echo "  Runs:  mise uninstall <each version listed>"
      echo "  Keeps: versions a tracked config or running process uses. A removed version reinstalls on demand."
      ;;
    colima)
      printf '  Runs:  colima --profile=%s ssh -- sudo fstrim -a\n' "${GW_COLIMA_PROFILE:-default}"
      echo "  Keeps: every file in the VM. The space returned depends on free space inside the VM and is measured after."
      ;;
  esac
}

print_preview() {
  local category dir state ready=0
  echo "groundwork-disk-clean: what Groundwork's tools can free"
  for category in $categories; do
    dir="$work/plan/$category"
    state="$(state_of "$dir")"
    echo
    case "$state:$category" in
      ready:packages)
        echo "Package managers (owner: groundwork-cleanup)"
        print_packages "$dir"
        ;;
      ready:docker)
        echo "Docker (owner: groundwork-docker-cache-tidy)"
        print_docker "$dir"
        ;;
      ready:*) print_owned_items "$category" "$dir" ;;
      empty:*) printf '%s: nothing to free\n' "$(category_title "$category")" ;;
      *) printf '%s: not offered (%s)\n' "$(category_title "$category")" "$(reason_of "$dir")" ;;
    esac
    [[ "$state" != ready ]] || ready=$((ready + 1))
  done
  echo
  echo "Never touched: your files and projects, application data, requested"
  echo "formulae and casks, Docker volumes, running containers, and tagged images."
  ready_count="$ready"
}

# ---- Confirmation --------------------------------------------------------------

ask() { # question; 0 yes, 1 no, 2 input ended
  local answer normalized
  while true; do
    printf '%s [y/N] ' "$1" >&2
    if ! IFS= read -r answer; then
      echo >&2
      return 2
    fi
    normalized="$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')"
    case "$normalized" in
      y | yes | t | true | 1) return 0 ;;
      "" | n | no | f | false | 0) return 1 ;;
      *) echo "Please answer y or n." >&2 ;;
    esac
  done
}

question_for() { # category dir
  local orphans
  case "$1" in
    packages)
      orphans="$(count_of "$2/names")"
      printf 'Run groundwork-cleanup --yes: brew autoremove (uninstalls the %s orphaned formula(e) listed), brew cleanup --prune=all (removes the %s item(s) listed), npm cache verify, and pnpm prune if due?' \
        "$orphans" "$(count_of "$2/lines")"
      ;;
    mise) printf 'Uninstall the %s mise version(s) listed above, %s?' "$(count_of "$2/items")" "$(describe_bytes "$(total_of "$2/items")")" ;;
    docker) printf 'Run groundwork-docker-cache-tidy --yes, daemon-wide: prune every project'"'"'s stopped containers, dangling images, and builder cache as its dry run above describes?' ;;
    colima) printf 'Trim the running Colima disk (%s on disk now at %s)?' "$(describe_bytes "$(total_of "$2/items")")" "$(cut -f 1 "$2/items" | paste -sd, -)" ;;
  esac
}

# ---- Execution -----------------------------------------------------------------

terminal_outcome() { # category status
  case "$2" in
    125) record "$1" "stopped, but its process tree could not be confirmed stopped; some items may already be removed" ;;
    129 | 130 | 143) record "$1" "interrupted (exit $2); some items may already be removed" ;;
    *) return 1 ;;
  esac
  exit "$2"
}

# Re-plan immediately before acting. Refuse when the item set changed.
replan_matches() { # category confirmed-dir fresh-dir
  plan_category "$1" "$3"
  if [[ "$(state_of "$3")" != ready ]]; then
    record "$1" "not run: no longer ready ($(reason_of "$3")); nothing was removed"
    return 1
  fi
  if [[ "$(ids_of "$2/items")" != "$(ids_of "$3/items")" ]]; then
    record "$1" "not run: the plan changed after the preview; nothing was removed. Run groundwork-disk-clean again."
    return 1
  fi
  return 0
}

# ---- Main ----------------------------------------------------------------------

mkdir -p "$work/plan" "$work/fresh"
echo "Checking what Groundwork's tools can free (read-only)..."
for category in $categories; do
  plan_category "$category" "$work/plan/$category"
done
ready_count=0
print_preview

if [[ "$interactive" -eq 0 ]]; then
  echo
  echo "Preview only: nothing was deleted ($preview_reason)."
  echo "Run groundwork-disk-clean in a terminal to choose what to free."
  exit 0
fi

if [[ "$ready_count" -eq 0 ]]; then
  echo
  echo "Nothing to free. Nothing was deleted."
  exit 0
fi

echo
echo "Answer each question; the default is no. Nothing runs until every"
echo "question is answered."
: >"$work/confirmed"
for category in $categories; do
  dir="$work/plan/$category"
  [[ "$(state_of "$dir")" == ready ]] || continue
  answer_status=0
  ask "$(question_for "$category" "$dir")" || answer_status=$?
  case "$answer_status" in
    0) printf '%s\n' "$category" >>"$work/confirmed" ;;
    1) record "$category" "declined; nothing was removed" ;;
    *)
      echo "Input ended before every question was answered. Nothing was deleted." >&2
      exit 1
      ;;
  esac
done

acting=1
if [[ ! -s "$work/confirmed" ]]; then
  exit 0
fi

# Prompts never hold the machine lock: take it only now, after every answer.
if [[ ! -r "$lock_lib" ]]; then
  echo "groundwork-disk-clean: the update lock helper is missing: $lock_lib. Nothing was removed." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$lock_lib"
lock_status=0
groundwork_lock_acquire "groundwork-disk-clean" || lock_status=$?
if [[ "$lock_status" -ne 0 ]]; then
  echo "groundwork-disk-clean: another maintenance run holds the lock. Nothing was removed." >&2
  exit "$lock_status"
fi
lock_held=1

while IFS= read -r category <&3; do
  echo
  category_title "$category"
  echo
  case "$category" in
    packages) execute_packages "$work/plan/$category" "$work/fresh/$category" ;;
    mise) execute_mise "$work/plan/$category" "$work/fresh/$category" ;;
    docker) execute_docker "$work/plan/$category" "$work/fresh/$category" ;;
    colima) execute_colima "$work/plan/$category" "$work/fresh/$category" ;;
  esac
done 3<"$work/confirmed"

exit "$final_status"
