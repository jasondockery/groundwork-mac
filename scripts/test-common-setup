#!/usr/bin/env python3
"""Exercise the common rendered setup, legacy migration, and private Docker merge."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import tomllib
import unittest

REPO = Path(__file__).resolve().parents[1]


class CommonSetupTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="groundwork-common-")
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.config = self.root / "empty.toml"
        self.config.touch()
        self.data = dict(name="CI", email_personal="ci@example.com", email_work="work@example.com",
                         code_dir="~/code", reset_existing_configs=False, password_manager="none",
                         signingkey="", obsidian_vault_name="", game_dev=False, xcode=False,
                         headless=False, terminal_multiplexer="herdr", key_repeat="fast",
                         chezmoi=dict(os="darwin", arch="arm64", osRelease={"ID": "ubuntu"}))

    def render(self, path, init=False, **data):
        effective = dict(self.data, **data)
        command = ["chezmoi", "--config", str(self.config), "--source", str(REPO),
                   "--override-data", json.dumps(effective), "execute-template"]
        if init:
            command += ["--init"]
        return subprocess.run(command, input=(REPO / path).read_text(), text=True,
                              capture_output=True, timeout=15)

    def text(self, path, **data):
        result = self.render(path, **data)
        self.assertEqual(result.returncode, 0, result.stderr)
        return result.stdout

    def test_ai_tools_and_tailscale_across_platform_architecture_and_legacy_role(self):
        for platform in ("darwin", "linux"):
            for arch in ("arm64", "amd64"):
                for work in (False, True):
                    for headless in (False, True):
                        with self.subTest(platform=platform, arch=arch, work=work, headless=headless):
                            source = self.text("home/dot_config/homebrew/Brewfile.tmpl", work=work,
                                               headless=headless, chezmoi=dict(os=platform, arch=arch))
                            for line in ('cask "codex"', 'cask "claude-code@latest"', 'cask "grok-build"', 'brew "opencode"'):
                                self.assertIn(line, source)
                            self.assertIn('cask "tailscale-app"' if platform == "darwin" and not headless else 'brew "tailscale"', source)
                            if platform == "darwin":
                                self.assertIn('brew "colima"', source)
                                self.assertNotIn('cask "docker-desktop"', source)
                            if platform == "darwin" and not headless:
                                for line in ('cask "chatgpt"', 'cask "claude"', 'cask "cursor"'):
                                    self.assertIn(line, source)
                            if headless:
                                for app in ("chatgpt", "claude", "cursor", "docker-desktop"):
                                    self.assertNotIn(f'cask "{app}"\n', source)
                            self.assertNotIn('cask "freetube"', source)
                            if platform == "linux":
                                self.assertNotIn('cask "chatgpt"', source)
                                self.assertNotIn('cask "claude"\n', source)

    def freetube_pin(self):
        return json.loads((REPO / "home/.chezmoitemplates/freetube-release.json").read_text())

    def test_freetube_pin_locks_the_verified_release(self):
        pin = self.freetube_pin()
        self.assertEqual(pin["version"], "0.25.3")
        self.assertEqual(
            pin["assets"]["arm64"],
            {
                "url": "https://github.com/FreeTubeApp/FreeTube/releases/download/v0.25.3-beta/freetube-0.25.3-beta-mac-arm64.dmg",
                "sha256": "2b445d64f5e56a873debea50c785cd41400bdabc387f0d67fc7be745b2b9146e",
            },
        )
        self.assertEqual(
            pin["assets"]["amd64"],
            {
                "url": "https://github.com/FreeTubeApp/FreeTube/releases/download/v0.25.3-beta/freetube-0.25.3-beta-mac-x64.dmg",
                "sha256": "40fb6c671ec75905e035968ec0c14bfe717643730af80536e625d191455f49bf",
            },
        )

    def test_freetube_dmg_renders_for_desktop_macs_before_personal_apps(self):
        pin = self.freetube_pin()
        desktop = self.text("home/run_onchange_after_15-freetube-dmg.sh.tmpl", personal_apps=False)
        self.assertIn(pin["assets"]["arm64"]["url"], desktop)
        self.assertIn(pin["assets"]["arm64"]["sha256"], desktop)
        self.assertNotIn(pin["assets"]["amd64"]["url"], desktop)
        self.assertIn("com.apple.quarantine", desktop)
        self.assertNotIn('cask "freetube"', desktop)
        for line in desktop.splitlines():
            if "Application Support/FreeTube" in line:
                self.assertTrue(line.lstrip().startswith("#"), line)
        intel = self.text(
            "home/run_onchange_after_15-freetube-dmg.sh.tmpl",
            chezmoi=dict(os="darwin", arch="amd64"),
        )
        self.assertIn(pin["assets"]["amd64"]["url"], intel)
        self.assertIn(pin["assets"]["amd64"]["sha256"], intel)
        self.assertNotIn(pin["assets"]["arm64"]["url"], intel)
        for headless, platform in ((True, "darwin"), (False, "linux"), (True, "linux")):
            with self.subTest(platform=platform, headless=headless):
                skipped = self.text(
                    "home/run_onchange_after_15-freetube-dmg.sh.tmpl",
                    headless=headless,
                    chezmoi=dict(os=platform, arch="arm64"),
                )
                self.assertNotIn("freetube-0.25.3-beta", skipped)
                self.assertNotIn("hdiutil", skipped)
                self.assertNotIn(pin["version"], skipped)
        brewfile = self.text("home/dot_config/homebrew/Brewfile.tmpl", work=False, personal_apps=False)
        self.assertNotIn('cask "freetube"', brewfile)
        self.assertNotIn('cask "obsidian"', brewfile)
        self.assertNotIn('cask "iina"', brewfile)

    def write_executable(self, name, body):
        path = self.root / "bin" / name
        path.parent.mkdir(exist_ok=True)
        path.write_text(body)
        path.chmod(0o755)
        return path

    def test_freetube_dmg_checksum_failure_does_not_install(self):
        script = self.text("home/run_onchange_after_15-freetube-dmg.sh.tmpl")
        apps = self.root / "Applications"
        apps.mkdir()
        hdiutil_calls = self.root / "hdiutil-calls"
        xattr_calls = self.root / "xattr-calls"
        self.write_executable("curl", '''#!/bin/sh
out=""
while [ $# -gt 0 ]; do
  if [ "$1" = "--output" ]; then
    out="$2"
    shift 2
    continue
  fi
  shift
done
printf 'not-a-dmg' > "$out"
''')
        self.write_executable("hdiutil", '#!/bin/sh\nprintf "%s\\n" "$*" >> "$FIXTURE_HDIUTIL"\nexit 99\n')
        self.write_executable("ditto", '#!/bin/sh\nprintf ditto >> "$FIXTURE_XATTR"\nexit 99\n')
        self.write_executable("xattr", '#!/bin/sh\nprintf xattr >> "$FIXTURE_XATTR"\nexit 99\n')
        environment = dict(
            os.environ,
            PATH=f"{self.root / 'bin'}:/usr/bin:/bin",
            HOME=str(self.root),
            GROUNDWORK_APPLICATIONS_DIR=str(apps),
            FIXTURE_HDIUTIL=str(hdiutil_calls),
            FIXTURE_XATTR=str(xattr_calls),
        )
        result = subprocess.run(["/bin/bash"], input=script, env=environment, text=True,
                                capture_output=True, timeout=15)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn("checksum did not match", result.stderr)
        self.assertIn("not installed", result.stderr)
        self.assertFalse(hdiutil_calls.exists())
        self.assertFalse(xattr_calls.exists())
        self.assertFalse((apps / "FreeTube.app").exists())
        self.assertEqual(list(apps.iterdir()), [])

    def test_freetube_dmg_skips_when_installed_version_matches_pin(self):
        pin = self.freetube_pin()
        script = self.text("home/run_onchange_after_15-freetube-dmg.sh.tmpl")
        apps = self.root / "Applications"
        bundle = apps / "FreeTube.app" / "Contents"
        bundle.mkdir(parents=True)
        (bundle / "Info.plist").write_text("fixture")
        curl_calls = self.root / "curl-calls"
        hdiutil_calls = self.root / "hdiutil-calls"
        self.write_executable("curl", '#!/bin/sh\nprintf curl >> "$FIXTURE_CURL"\nexit 1\n')
        self.write_executable("hdiutil", '#!/bin/sh\nprintf hdiutil >> "$FIXTURE_HDIUTIL"\nexit 99\n')
        self.write_executable("plutil", '#!/bin/sh\nprintf "%s\\n" "$FIXTURE_VERSION"\n')
        self.write_executable("xattr", "#!/bin/sh\nexit 0\n")
        environment = dict(
            os.environ,
            PATH=f"{self.root / 'bin'}:/usr/bin:/bin",
            HOME=str(self.root),
            GROUNDWORK_APPLICATIONS_DIR=str(apps),
            FIXTURE_CURL=str(curl_calls),
            FIXTURE_HDIUTIL=str(hdiutil_calls),
            FIXTURE_VERSION=pin["version"],
        )
        result = subprocess.run(["/bin/bash"], input=script, env=environment, text=True,
                                capture_output=True, timeout=15)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn("already installed", result.stdout)
        self.assertFalse(curl_calls.exists())
        self.assertFalse(hdiutil_calls.exists())
        self.assertTrue((apps / "FreeTube.app").is_dir())

    def test_configuration_only_apply_keeps_existing_nightly_but_installs_missing_cli(self):
        hook = self.text('home/run_after_21-t3-code.sh.tmpl')
        for path in ['/opt/homebrew/bin/brew', '/home/linuxbrew/.linuxbrew/bin/brew', '/usr/local/bin/brew']:
            hook = hook.replace(path, str(self.root / 'no-brew'))
        home = self.root / 'home'
        binaries = self.root / 'bin'
        installed = home / '.local/bin/t3'
        installed.parent.mkdir(parents=True)
        binaries.mkdir()
        calls = self.root / 't3-installer-calls'
        version = '#!/bin/sh\necho t3-v0.0.1-nightly.fixture\n'
        fresh = self.root / 'fresh-t3'
        fresh.write_text('#!/bin/sh\necho t3-v0.0.1-nightly.installed\n')
        installer = binaries / 'curl'
        installer.write_text(r'''#!/usr/bin/env python3
import os, pathlib, sys
pathlib.Path(os.environ['FIXTURE_CALLS']).write_text('installer requested')
output = pathlib.Path(sys.argv[sys.argv.index('-o') + 1])
output.write_text('#!/bin/sh\ncp "$FIXTURE_T3" "$HOME/.local/bin/t3"\nchmod +x "$HOME/.local/bin/t3"\n')
''')
        installer.chmod(0o755)
        for tool in ['timeout', 'gtimeout']:
            path = binaries / tool
            path.write_text('#!/bin/sh\nshift\nshift\nexec "$@"\n')
            path.chmod(0o755)
        uname = binaries / 'uname'
        uname.write_text('#!/bin/sh\nif [ "$1" = -s ]; then echo "$FIXTURE_OS"; else echo aarch64; fi\n')
        uname.chmod(0o755)
        for os_name in ['Linux', 'Darwin']:
            for scope, present, expect_install in [('configuration', True, False),
                                                    ('configuration', False, True),
                                                    ('maintenance', True, True)]:
                with self.subTest(os=os_name, scope=scope, present=present):
                    if calls.exists():
                        calls.unlink()
                    if present:
                        installed.write_text(version)
                        installed.chmod(0o755)
                    elif installed.exists():
                        installed.unlink()
                    environment = dict(os.environ, HOME=str(home), PATH=f'{binaries}:/usr/bin:/bin',
                                       GROUNDWORK_UPDATE_SCOPE=scope, FIXTURE_OS=os_name,
                                       FIXTURE_CALLS=str(calls), FIXTURE_T3=str(fresh),
                                       T3CODE_INSTALL_BIN_DIR=str(installed.parent))
                    result = subprocess.run(['/bin/bash'], input=hook, env=environment,
                                            text=True, capture_output=True, timeout=10)
                    self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
                    self.assertEqual(calls.exists(), expect_install)
                    if not expect_install:
                        self.assertEqual(installed.read_text(), version)

        calls.unlink()
        custom = self.root / 'custom-bin/t3'
        custom.parent.mkdir()
        custom.write_text(version)
        custom.chmod(0o755)
        environment.update(GROUNDWORK_UPDATE_SCOPE='configuration', T3CODE_INSTALL_BIN_DIR=str(custom.parent))
        result = subprocess.run(['/bin/bash'], input=hook, env=environment,
                                text=True, capture_output=True, timeout=10)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('shadowing', result.stderr)
        self.assertFalse(calls.exists())
        self.assertEqual(custom.read_text(), version)

        # A separately installed Nightly is not evidence that our intended
        # executable exists. Install that missing executable, then verify it.
        installed.unlink()
        outside = binaries / 't3'
        outside.write_text(version)
        outside.chmod(0o755)
        environment['T3CODE_INSTALL_BIN_DIR'] = str(installed.parent)
        result = subprocess.run(['/bin/bash'], input=hook, env=environment,
                                text=True, capture_output=True, timeout=10)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertTrue(calls.exists())
        self.assertIn('nightly.installed', installed.read_text())

    def test_headless_linux_bootstrap_installs_homebrew_on_both_architectures(self):
        binaries = self.root / "bin"
        binaries.mkdir()
        stubs = {
            "uname": "printf 'Linux\\n'",
            "id": "printf '0\\n'",
            "apt-get": 'printf "%s\\n" "$*" >> "$FIXTURE_CALLS"',
            "curl": "printf '%s\\n' 'printf installed > \"$FIXTURE_INSTALLED\"'",
        }
        for name, body in stubs.items():
            path = binaries / name
            path.write_text("#!/bin/sh\n" + body + "\n")
            path.chmod(0o755)
        env = dict(os.environ, PATH=f"{binaries}:/usr/bin:/bin",
                   FIXTURE_CALLS=str(self.root / "calls"), FIXTURE_INSTALLED=str(self.root / "installed"))
        for arch in ("amd64", "arm64"):
            source = self.text("home/run_before_00-install-homebrew.sh.tmpl", headless=True,
                               chezmoi=dict(os="linux", arch=arch))
            source = source.replace("/home/linuxbrew/.linuxbrew/bin/brew", str(self.root / "absent-brew"))
            result = subprocess.run(["/bin/bash"], input=source, env=env, text=True,
                                    capture_output=True, timeout=15)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual((self.root / "installed").read_text(), "installed")
            (self.root / "installed").unlink()
        self.assertEqual((self.root / "calls").read_text().splitlines(),
                         ["update", "install -y build-essential procps curl file git"] * 2)
        (self.root / "calls").unlink()
        source = self.text("home/run_before_00-install-homebrew.sh.tmpl", headless=True,
                           chezmoi=dict(os="linux", arch="riscv64"))
        result = subprocess.run(["/bin/bash"], input=source, env=env, text=True,
                                capture_output=True, timeout=15)
        self.assertNotEqual(result.returncode, 0)
        self.assertFalse((self.root / "calls").exists())
        self.assertFalse((self.root / "installed").exists())

    def test_preferences_override_legacy_role_independently(self):
        source = self.text("home/dot_config/homebrew/Brewfile.tmpl", work=True,
                           docker_backend="docker-desktop", personal_apps=True)
        self.assertIn('cask "docker-desktop"', source)
        self.assertIn('cask "obsidian"', source)
        self.assertNotIn('brew "colima"', source)
        headless = self.text("home/dot_config/homebrew/Brewfile.tmpl", headless=True,
                             docker_backend="docker-desktop")
        self.assertNotIn('cask "docker-desktop"', headless)
        git = self.text("home/dot_gitconfig.tmpl", work=True, git_identity="personal")
        self.assertIn("email = ci@example.com", git)
        git = self.text("home/dot_gitconfig.tmpl", work=False, git_identity="work")
        self.assertIn("email = work@example.com", git)

    def test_remote_desktop_hook_excludes_headless_and_wsl(self):
        for system, headless, kernel, invokes in [
            ('darwin', False, '', True), ('darwin', True, '', False),
            ('linux', False, '7.1.12', True), ('linux', True, '7.1.12', False),
            ('linux', False, '6.6.87-microsoft-standard-WSL2', False),
        ]:
            with self.subTest(system=system, headless=headless, kernel=kernel):
                data = dict(headless=headless, chezmoi=dict(os=system, arch='arm64', kernel=dict(osrelease=kernel)))
                source = self.text('home/run_after_32-remote-desktop.sh.tmpl', **data)
                parsed = subprocess.run(['bash', '-n'], input=source, text=True, capture_output=True, timeout=5)
                self.assertEqual(parsed.returncode, 0, parsed.stderr)
                self.assertEqual('groundwork-remote-desktop" prepare' in source, invokes)
                ignored = self.text('home/.chezmoiignore', **data)
                self.assertEqual('.local/bin/groundwork-remote-desktop' in ignored, not invokes)

    def test_migration_persists_explicit_answers(self):
        result = self.render("home/.chezmoi.toml.tmpl", init=True, work=True,
                             docker_backend="none", personal_apps=True, work_extensions=False,
                             git_identity="personal", environment_role="managed", release_posture="preview")
        self.assertEqual(result.returncode, 0, result.stderr)
        data = tomllib.loads(result.stdout)["data"]
        self.assertEqual({key: data[key] for key in ("docker_backend", "personal_apps", "work_extensions", "git_identity")},
                         dict(docker_backend="none", personal_apps=True, work_extensions=False, git_identity="personal"))
        self.assertTrue(data["work"])
        self.assertEqual(data["release_posture"], "preview")

    def test_invalid_preferences_fail_before_rendering_a_manifest(self):
        for values in (dict(docker_backend="typo"), dict(personal_apps="false"), dict(git_identity="typo")):
            result = self.render("home/dot_config/homebrew/Brewfile.tmpl", **values)
            self.assertNotEqual(result.returncode, 0)
            self.assertEqual(result.stdout, "")

    def test_docker_config_merge_preserves_credentials_context_and_plugins(self):
        brew = self.root / "brew"
        brew.write_text("#!/bin/sh\nprintf '%s\\n' '/fixture/homebrew'\n")
        brew.chmod(0o755)
        source = self.text("home/dot_docker/modify_private_config.json.tmpl")
        source = source.replace('Path("/opt/homebrew/bin/brew"), Path("/usr/local/bin/brew")', f'Path({str(brew)!r}),')
        managed = self.root / "source/dot_docker"
        managed.mkdir(parents=True)
        (managed / "modify_private_config.json").write_text(source)
        destination = self.root / "destination"
        (destination / ".docker").mkdir(parents=True)
        target = destination / ".docker/config.json"
        original = {"credsStore": "desktop", "currentContext": "desktop-linux", "cliPluginsExtraDirs": ["/my/plugins"], "auths": {"example.test": {}}, "custom": "私の設定"}
        target.write_text(json.dumps(original))
        command = ["chezmoi", "--config", str(self.config), "--source", str(managed.parent),
                   "--destination", str(destination), "apply", "--force"]
        result = subprocess.run(command, text=True, capture_output=True, timeout=15)
        self.assertEqual(result.returncode, 0, result.stderr)
        merged = json.loads(target.read_text())
        for key in ("credsStore", "currentContext", "auths", "custom"):
            self.assertEqual(merged[key], original[key])
        self.assertEqual(merged["cliPluginsExtraDirs"], ["/my/plugins", "/fixture/homebrew/lib/docker/cli-plugins"])
        self.assertEqual(target.stat().st_mode & 0o777, 0o600)
        again = subprocess.run(command, text=True, capture_output=True, timeout=15)
        self.assertEqual(again.returncode, 0, again.stderr)
        self.assertEqual(json.loads(target.read_text()), merged)
        target.write_text("malformed")
        bad = subprocess.run(command, text=True, capture_output=True, timeout=15)
        self.assertNotEqual(bad.returncode, 0)
        self.assertEqual(target.read_text(), "malformed")



if __name__ == "__main__":
    unittest.main()
