#!/usr/bin/env bash
set -euo pipefail

# Prove the checksum policy against the real cask inventory, not a comment.
#
# Brewfile policy: NO cask in any rendered Brewfile may ship `sha256 :no_check`
# or `version :latest`. There is no allowlist. The Brewfile is installed under
# `--require-sha`, so an unchecked cask would fail the bundle and would put an
# unverified artifact on every new machine.
#
# Browser selection: every desktop Mac posture (current, preview, xcode, and
# a retired managed role) renders brave-browser and not Google Chrome. Headless renders
# no GUI browser. Brave is checksummed, so it lives in the main Brewfile.
# Sparkle owns later updates; this audit does not add an upgrade lane.
#
# Needs macOS, Homebrew, chezmoi, jq, and network access, so this is a receipt
# (and a required CI job), not part of the offline validator.
#
# Usage: scripts/audit-brew-casks

cd "$(dirname "$0")/.."

for tool in brew jq chezmoi; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "audit-brew-casks: needs $tool (run this on a Mac with Homebrew)." >&2
    exit 1
  }
done

status=0
declare -a all_casks=()

render_profile() {
  # Every conditional cask branch, not just the default one: password managers
  # (bitwarden / 1password) and the Unity game-dev set are gated on setup
  # answers, so auditing one profile would leave them unaudited.
  local work="$1" pw="$2" game="$3"
  chezmoi --source "$PWD" execute-template --init \
    --promptBool "work=$work,headless=false,reset_existing_configs=false,game_dev=$game,xcode=false" \
    --promptString 'name=x,email_personal=x@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name=' \
    --promptChoice "password_manager=$pw" \
    <home/dot_config/homebrew/Brewfile.tmpl \
    | sed -n 's/^cask "\([^"]*\)".*/\1/p'
}

for work in false true; do
  for pw in none bitwarden 1password; do
    for game in false true; do
      profile="work=$work pw=$pw game_dev=$game"
      # Capture BEFORE iterating: a `while read` fed by process substitution
      # keeps going when the renderer dies, so a broken template would "audit"
      # zero casks and report success. Fail loudly instead.
      if ! rendered="$(render_profile "$work" "$pw" "$game" 2>/dev/null)"; then
        echo "FAIL: Brewfile rendering failed for profile: $profile" >&2
        exit 1
      fi
      if [[ -z "$rendered" ]]; then
        echo "FAIL: profile rendered zero casks ($profile) — the audit would have proved nothing." >&2
        exit 1
      fi
      while IFS= read -r cask; do
        [[ -n "$cask" ]] || continue
        all_casks+=("$cask")
        if [[ "$cask" == "google-chrome" || "$cask" == "google-chrome@beta" ]]; then
          echo "VIOLATION $cask is in the Brewfile ($profile)." >&2
          echo "          Chrome is no longer Groundwork-managed." >&2
          status=1
        fi
      done <<<"$rendered"
    done
  done
done

render_browser_profile() {
  local posture="$1" role="$2" headless="$3" xcode="$4"
  chezmoi --source "$PWD" execute-template \
    --override-data "{\"headless\":$headless,\"xcode\":$xcode,\"release_posture\":\"$posture\",\"environment_role\":\"$role\",\"chezmoi\":{\"os\":\"darwin\",\"arch\":\"arm64\"}}" \
    <home/dot_config/homebrew/Brewfile.browser.tmpl \
    | sed -n 's/^cask "\([^"]*\)".*/\1/p'
}

expect_brave() {
  local label="$1" selected="$2"
  [[ "$selected" == "brave-browser" ]] || {
    printf 'FAIL: %s selected:\n%s\n' "$label" "$selected" >&2
    exit 1
  }
}

current_browser="$(render_browser_profile current personal false false)" \
  || {
    echo "FAIL: current browser profile did not render." >&2
    exit 1
  }
preview_browser="$(render_browser_profile preview personal false false)" \
  || {
    echo "FAIL: preview browser profile did not render." >&2
    exit 1
  }
xcode_browser="$(render_browser_profile current personal false true)" \
  || {
    echo "FAIL: xcode browser profile did not render." >&2
    exit 1
  }
managed_browser="$(render_browser_profile current managed false false)" \
  || {
    echo "FAIL: retired managed role browser profile did not render." >&2
    exit 1
  }
headless_browser="$(render_browser_profile current personal true false)" \
  || {
    echo "FAIL: headless browser profile did not render." >&2
    exit 1
  }
expect_brave "current" "$current_browser"
expect_brave "preview" "$preview_browser"
expect_brave "xcode" "$xcode_browser"
expect_brave "retired-managed-role" "$managed_browser"
[[ -z "$headless_browser" ]] || {
  printf 'FAIL: headless selected a GUI browser:\n%s\n' "$headless_browser" >&2
  exit 1
}

render_main_brewfile() {
  local headless="$1"
  chezmoi --source "$PWD" execute-template --init \
    --promptBool "work=false,headless=$headless,reset_existing_configs=false,game_dev=false,xcode=false" \
    --promptString 'name=x,email_personal=x@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name=' \
    --promptChoice "password_manager=bitwarden" \
    --override-data "{\"headless\":$headless,\"chezmoi\":{\"os\":\"darwin\",\"arch\":\"arm64\"}}" \
    <home/dot_config/homebrew/Brewfile.tmpl
}
desktop_main="$(render_main_brewfile false)" || {
  echo "FAIL: desktop Brewfile did not render." >&2
  exit 1
}
headless_main="$(render_main_brewfile true)" || {
  echo "FAIL: headless Brewfile did not render." >&2
  exit 1
}
grep -qx 'cask "brave-browser"' <<<"$desktop_main" || {
  echo "FAIL: desktop Brewfile did not select brave-browser." >&2
  exit 1
}
if grep -qE '^cask "google-chrome(@beta)?"' <<<"$desktop_main"; then
  echo "FAIL: desktop Brewfile still selects Google Chrome." >&2
  exit 1
fi
if grep -qE '^cask "(brave-browser|google-chrome(@beta)?)"' <<<"$headless_main"; then
  echo "FAIL: headless Brewfile selected a GUI browser." >&2
  exit 1
fi

# Deduplicate before querying metadata (profiles overlap heavily).
# NOT mapfile: macOS ships Bash 3.2, where mapfile does not exist — and it fails
# to an EMPTY array rather than an error, which would make this audit "pass" by
# checking nothing. Groundwork does not install Bash, so 3.2 is the contract.
unique_casks=()
while IFS= read -r cask; do
  [[ -n "$cask" ]] && unique_casks+=("$cask")
done < <(printf '%s\n' "${all_casks[@]}" | sort -u)
((${#unique_casks[@]} > 0)) || {
  echo "FAIL: no casks discovered across any profile." >&2
  exit 1
}

echo "== Brewfile policy: every cask must be versioned and checksummed =="
for cask in "${unique_casks[@]}"; do
  json="$(brew info --json=v2 --cask "$cask" 2>/dev/null || true)"
  # Validate the SHAPE once, and make a parse failure fatal. Without this, a
  # schema change or malformed payload leaves the variation query empty and the
  # audit reads that as "no unchecked variations" — the same fail-open class this
  # audit exists to kill.
  if ! printf '%s' "$json" | jq -e --arg token "$cask" '
        (.casks | type) == "array"
        and (.casks | length) == 1
        and (.casks[0].token == $token)
        and (.casks[0].version | type) == "string"
        and (.casks[0].sha256 | type) == "string"
        and (.casks[0].disabled | type) == "boolean"
        and ((.casks[0].variations // {}) | type) == "object"
      ' >/dev/null 2>&1; then
    echo "  UNKNOWN   $cask — unsupported or malformed cask metadata (network? schema change? renamed?)" >&2
    status=1
    continue
  fi
  version="$(printf '%s' "$json" | jq -r '.casks[0].version')"
  sha="$(printf '%s' "$json" | jq -r '.casks[0].sha256')"
  disabled="$(printf '%s' "$json" | jq -r '.casks[0].disabled')"
  # A disabled cask makes `brew bundle` fail before any later install lane.
  if [[ "$disabled" == "true" ]]; then
    echo "  VIOLATION $cask is disabled in Homebrew; a required Brewfile cask would fail brew bundle." >&2
    status=1
  fi
  # Architecture matters: a cask can carry per-variation hashes, and Groundwork
  # supports Intel and Apple Silicon. No `|| true` — a jq failure here is fatal.
  if ! bad_variation="$(printf '%s' "$json" | jq -r '
        [(.casks[0].variations // {}) | to_entries[]
         | select((.value.sha256? == "no_check") or (.value.version? == "latest"))
         | .key] | join(",")')"; then
    echo "  UNKNOWN   $cask — could not evaluate architecture variations" >&2
    status=1
    continue
  fi
  if [[ "$sha" == "no_check" || "$version" == "latest" ]]; then
    echo "  VIOLATION $cask (version=$version sha=$sha) — unchecked cask in the Brewfile" >&2
    status=1
  elif [[ -n "$bad_variation" ]]; then
    echo "  VIOLATION $cask — unchecked architecture variation(s): $bad_variation" >&2
    status=1
  fi
done

if ((status == 0)); then
  echo "ok: ${#unique_casks[@]} safe casks are versioned and checksummed; desktop profiles select brave-browser"
else
  echo "FAIL: the cask inventory violates Groundwork's checksum policy" >&2
fi
exit "$status"
