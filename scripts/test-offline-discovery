#!/usr/bin/env python3
"""Exercise cleanup's offline selection policy through its real process boundary."""
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile
import time
import unittest

REPO = Path(__file__).resolve().parents[1]
FIXTURE_PIN = '40.5.6'


class OfflineTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='groundwork-offline-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.home = self.root / 'home'
        self.bin = self.home / '.local/bin'
        self.bin.mkdir(parents=True)
        self.calls = self.root / 'calls'
        self.records = self.root / 'repositories'
        self.records.write_text('')
        self.stores = self.root / 'stores'
        self.stores.mkdir()
        lib = self.home / '.local/share/groundwork/lib'
        lib.mkdir(parents=True)
        shutil.copy(REPO / 'home/dot_local/share/groundwork/lib/maintenance-runner.sh', lib)
        locklib = self.home / '.local/lib/groundwork'
        locklib.mkdir(parents=True)
        shutil.copy(REPO / 'home/dot_local/lib/groundwork/update-lock.sh', locklib)
        config = self.home / '.config/groundwork'
        config.mkdir(parents=True)
        (config / 'repos.conf').write_text('trusted_pnpm_store_root = ' + str(self.stores) + '\n')
        (self.bin / 'jq').symlink_to(shutil.which('jq'))
        (self.bin / 'node').symlink_to('/usr/bin/true')
        self.script(self.bin / 'groundwork-repos', 'cat "$REVIEW_RECORDS"')
        self.script(self.bin / 'mise', 'exit 1')
        self.script(self.bin / 'brew', '''case "$1" in
--cache) printf '%s\\n' "$HOME/cache" ;;
*) printf 'brew %s\\n' "$*" >>"$REVIEW_CALLS" ;;
esac''')
        self.script(self.bin / 'npm', '''case "$1" in
config) printf '%s\\n' "$HOME/npm-cache" ;;
*) printf 'npm %s\\n' "$*" >>"$REVIEW_CALLS" ;;
esac''')
        proxy = self.root / 'corepack/dist/pnpm.js'
        self.script(proxy, '''printf 'pnpm %s at %s network=%s prompt=%s\\n' "$*" "$PWD" "${COREPACK_ENABLE_NETWORK:-unset}" "${COREPACK_ENABLE_DOWNLOAD_PROMPT:-unset}" >>"$REVIEW_CALLS"
if [[ -n "${REVIEW_ACTIVE:-}" ]]; then
  : >"$REVIEW_ACTIVE/$$"
  ls "$REVIEW_ACTIVE" | wc -l >>"$REVIEW_ACTIVE.log"
  sleep "$REVIEW_LATENCY"
  rm -f "$REVIEW_ACTIVE/$$"
fi
if [[ -f .hang ]]; then sleep 30; fi
if [[ -f .offline ]]; then
  echo '! Corepack is about to download https://example.invalid/pnpm.tgz' >&2
  echo "Network access disabled by the environment; can't reach https://example.invalid/pnpm.tgz" >&2
  exit 1
fi
if [[ "${1:-}" == --store-dir ]]; then shift 2; fi
case "$*" in
'store path') sed -n 's/^fixture-store=//p' .npmrc ;;
--version) jq -r '.packageManager | sub("^pnpm@"; "")' package.json ;;
'store prune'*) [[ ! -f .prune-fails ]] || exit 3 ;;
*) exit 64 ;;
esac''')
        (self.bin / 'pnpm').symlink_to(proxy)
        self.env = dict(os.environ, HOME=str(self.home), PATH='/usr/bin:/bin',
                        XDG_CONFIG_HOME=str(self.home / '.config'),
                        XDG_DATA_HOME=str(self.home / '.local/share'),
                        XDG_STATE_HOME=str(self.home / '.local/state'),
                        REVIEW_CALLS=str(self.calls), REVIEW_RECORDS=str(self.records),
                        COREPACK_ENV_FILE='0',
                        GROUNDWORK_MAINTENANCE_POLL_SECONDS='0.05',
                        GROUNDWORK_MAINTENANCE_CANCEL_GRACE_SECONDS='1')
        for name in ('GROUNDWORK_UPDATE_LOCK_HELD', 'GROUNDWORK_UPDATE_LOCK_TOKEN', 'COREPACK_HOME'):
            self.env.pop(name, None)

    def script(self, path, body):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text('#!/bin/bash\n' + body + '\n')
        path.chmod(0o755)

    def repository(self, name, offline=False, pin=FIXTURE_PIN, generation='v40'):
        repo = self.root / name
        repo.mkdir()
        (repo / 'package.json').write_text(json.dumps({'packageManager': 'pnpm@' + pin}))
        if offline:
            (repo / '.offline').touch()
        else:
            store = self.stores / generation
            store.mkdir(exist_ok=True)
            # The fixture pnpm reads its store from .npmrc, a store-selection
            # input that discovery fingerprints.
            (repo / '.npmrc').write_text('fixture-store=' + str(store) + '\n')
        with self.records.open('a') as records:
            records.write(str(repo) + '\tfixture\n')
        return repo

    def run_cleanup(self, *args):
        return subprocess.run(['/bin/bash', str(REPO / 'home/dot_local/bin/executable_groundwork-cleanup'), *args],
                              env=self.env, capture_output=True, text=True, timeout=20)

    def test_repeated_cache_miss_is_classified_once_and_independent_work_continues(self):
        self.repository('old-a', offline=True)
        old_b = self.repository('old-b', offline=True)
        (old_b / 'pnpm-lock.yaml').write_text('lockfileVersion: 9\n')
        self.repository('cached', pin='39.0.1', generation='v39')
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('intentionally offline, not a connectivity test', result.stdout)
        self.assertIn('2 store probes for 3 pinned records; 0 shared in this run, 0 from the result cache, '
                      '1 known misses reused', result.stdout)
        self.assertNotIn('about to download', result.stdout + result.stderr)
        calls = self.calls.read_text()
        self.assertEqual(calls.count('pnpm store path'), 2, calls)
        self.assertIn('brew cleanup --prune=all', calls)
        self.assertIn('npm cache verify', calls)
        self.assertIn(' store prune', calls)
        for line in calls.splitlines():
            if line.startswith('pnpm store path') or line.startswith('pnpm --version'):
                self.assertIn('network=0 prompt=0', line)
        logs = list((self.home / '.local/state/groundwork/logs').glob('pnpm-offline-probes.*'))
        self.assertEqual(len(logs), 1)
        self.assertIn('Network access disabled', logs[0].read_text())
        self.assertEqual(stat.S_IMODE(logs[0].stat().st_mode), 0o600)

    def test_same_cached_pin_still_observes_each_repository_store(self):
        self.repository('configured-a', generation='v40')
        self.repository('configured-b', generation='v41')
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        calls = self.calls.read_text()
        self.assertEqual(calls.count('pnpm store path'), 2, calls)
        self.assertEqual(calls.count(' store prune'), 2, calls)
        self.assertIn(str(self.stores / 'v40'), result.stdout)
        self.assertIn(str(self.stores / 'v41'), result.stdout)

    def test_repository_corepack_environment_prevents_cross_context_cache_reuse(self):
        self.env.pop('COREPACK_ENV_FILE')
        a = self.repository('env-a', offline=True)
        b = self.repository('env-b', offline=True)
        (a / '.corepack.env').write_text('COREPACK_HOME=/different-a\n')
        (b / '.corepack.env').write_text('COREPACK_HOME=/different-b\n')
        result = self.run_cleanup()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.calls.read_text().count('pnpm store path'), 2)
        self.assertIn('2 store probes for 2 pinned records; 0 shared in this run, 0 from the result cache, '
                      '0 known misses reused', result.stdout)
        self.assertFalse((self.home / '.local/state').exists())

    def test_mise_shims_use_each_repository_effective_corepack_cache_context(self):
        proxy = (self.bin / 'pnpm').resolve()
        (self.bin / 'pnpm').unlink()
        runtime = self.root / 'runtime/bin'
        runtime.mkdir(parents=True)
        (runtime / 'pnpm').symlink_to(proxy)
        shims = self.root / 'mise/shims'
        shims.mkdir(parents=True)
        self.script(shims / 'pnpm', 'exec "$HOME/.local/bin/mise" exec -- "$REVIEW_RUNTIME_BIN/pnpm" "$@"')
        self.script(self.bin / 'mise', """[[ "${1:-}" == exec && "${2:-}" == -- ]] || exit 1
printf 'mise exec offline=%s auto=%s exec=%s not-found=%s task=%s\\n' "${MISE_OFFLINE-unset}" \\
  "${MISE_AUTO_INSTALL-unset}" "${MISE_EXEC_AUTO_INSTALL-unset}" \\
  "${MISE_NOT_FOUND_AUTO_INSTALL-unset}" "${MISE_TASK_RUN_AUTO_INSTALL-unset}" >>"$REVIEW_CALLS"
shift 2
export COREPACK_HOME="$(cat .corepack-cache)"
export PATH="$REVIEW_RUNTIME_BIN:$PATH"
exec "$@"
""")
        self.env['PATH'] = str(shims) + ':/usr/bin:/bin'
        self.env['REVIEW_RUNTIME_BIN'] = str(runtime)
        for name, cache in (('context-a', 'cache-a'), ('context-b', 'cache-b'), ('context-a2', 'cache-a')):
            repo = self.repository(name, offline=True)
            (repo / '.corepack-cache').write_text(str(self.root / cache) + '\n')
        for variable in ('COREPACK_HOME', 'XDG_CACHE_HOME', 'LOCALAPPDATA'):
            with self.subTest(variable=variable):
                self.calls.unlink(missing_ok=True)
                script = (self.bin / 'mise').read_text()
                for previous in ('COREPACK_HOME', 'XDG_CACHE_HOME', 'LOCALAPPDATA'):
                    script = script.replace('export ' + previous + '=', 'export ' + variable + '=')
                (self.bin / 'mise').write_text(script)
                result = self.run_cleanup()
                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
                calls = self.calls.read_text()
                self.assertEqual(calls.count('pnpm store path'), 2)
                # context-a2 shares context-a's whole store context, so it reuses that observation.
                self.assertIn('2 store probes for 3 pinned records; 1 shared in this run', result.stdout)
                mise_calls = [line for line in calls.splitlines() if line.startswith('mise exec')]
                # Three Corepack-context probes plus two shimmed store probes that miss.
                self.assertEqual(len(mise_calls), 5, calls)
                for line in mise_calls:
                    self.assertEqual(line, 'mise exec offline=1 auto=0 exec=0 not-found=0 task=0')

    def test_explicit_environment_file_named_default_never_shares_misses(self):
        self.env['COREPACK_ENV_FILE'] = 'default'
        self.repository('custom-env-a', offline=True)
        self.repository('custom-env-b', offline=True)
        result = self.run_cleanup()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.calls.read_text().count('pnpm store path'), 2)
        self.assertIn('0 known misses reused', result.stdout)

    def cache(self):
        return self.home / '.local/state/groundwork/pnpm-discovery-cache.tsv'

    def worktrees(self, count, lockfile='lockfileVersion: 9\n', pin=FIXTURE_PIN, generation='v40'):
        repos = [self.repository(f'wt{number}', pin=pin, generation=generation) for number in range(count)]
        for repo in repos:
            (repo / 'pnpm-lock.yaml').write_text(lockfile)
        return repos

    def test_records_sharing_pin_lockfile_and_configuration_probe_once(self):
        repos = self.worktrees(5)
        result = self.run_cleanup()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.calls.read_text().count('pnpm store path'), 1)
        self.assertEqual(self.calls.read_text().count('pnpm --version'), 1)
        self.assertIn('1 store probes for 5 pinned records; 4 shared in this run', result.stdout)
        self.assertIn('Selectors: 5', result.stdout)
        for repo in repos:
            self.assertIn(str(repo), result.stdout)

    def test_a_changed_lockfile_or_configuration_gets_its_own_probe(self):
        repos = self.worktrees(4)
        (repos[1] / 'pnpm-lock.yaml').write_text('lockfileVersion: 9\n# changed\n')
        (repos[2] / '.npmrc').write_text('fixture-store=' + str(self.stores / 'v40') + '\n# changed\n')
        result = self.run_cleanup()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.calls.read_text().count('pnpm store path'), 3)
        self.assertIn('3 store probes for 4 pinned records; 1 shared in this run', result.stdout)

    def test_manifest_edits_share_but_a_manifest_store_setting_does_not(self):
        repos = self.worktrees(3)
        (repos[1] / 'package.json').write_text(json.dumps(
            {'packageManager': 'pnpm@' + FIXTURE_PIN, 'scripts': {'test': 'node --test'}}))
        (repos[2] / 'package.json').write_text(json.dumps(
            {'packageManager': 'pnpm@' + FIXTURE_PIN, 'pnpm': {'storeDir': '/absolute/store'}}))
        result = self.run_cleanup()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('2 store probes for 3 pinned records; 1 shared in this run', result.stdout)

    def test_relative_or_computed_store_dir_is_never_shared(self):
        for line in ('store-dir=../shared-store', 'store-dir=${PNPM_STORE}', 'storeDir: relative'):
            with self.subTest(line=line):
                for child in self.root.glob('wt*'):
                    shutil.rmtree(child)
                self.records.write_text('')
                self.calls.unlink(missing_ok=True)
                repos = self.worktrees(2)
                for repo in repos:
                    name = 'pnpm-workspace.yaml' if line.startswith('storeDir') else '.npmrc'
                    with (repo / name).open('a') as config:
                        config.write(line + '\n')
                result = self.run_cleanup()
                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
                self.assertEqual(self.calls.read_text().count('pnpm store path'), 2)
                self.assertIn('2 store probes for 2 pinned records; 0 shared in this run', result.stdout)
        for child in self.root.glob('wt*'):
            shutil.rmtree(child)
        self.records.write_text('')
        self.calls.unlink(missing_ok=True)
        for repo in self.worktrees(2):
            with (repo / '.npmrc').open('a') as config:
                config.write('store-dir = /absolute/store\n')
        result = self.run_cleanup()
        self.assertIn('1 store probes for 2 pinned records; 1 shared in this run', result.stdout)

    def test_store_dir_environment_must_be_absolute_to_share(self):
        self.worktrees(2)
        for value, probes in (('relative/store', 2), ('/absolute/store', 1)):
            with self.subTest(value=value):
                self.calls.unlink(missing_ok=True)
                self.env['npm_config_store_dir'] = value
                result = self.run_cleanup()
                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
                self.assertEqual(self.calls.read_text().count('pnpm store path'), probes)

    def test_result_cache_serves_later_runs_until_pin_or_lockfile_changes(self):
        repos = self.worktrees(3)
        report = self.run_cleanup()
        self.assertEqual(report.returncode, 0, report.stdout + report.stderr)
        self.assertFalse(self.cache().exists(), 'report mode must not write the cache')
        first = self.run_cleanup('--yes')
        self.assertEqual(first.returncode, 0, first.stdout + first.stderr)
        lines = self.cache().read_text().splitlines()
        self.assertEqual(lines[0], 'groundwork pnpm discovery cache v1')
        self.assertEqual(len(lines), 2, lines)
        self.assertTrue(lines[1].endswith('\t' + str(self.stores / 'v40') + '\t' + FIXTURE_PIN))
        self.calls.unlink()
        second = self.run_cleanup('--yes')
        self.assertEqual(second.returncode, 0, second.stdout + second.stderr)
        self.assertIn('0 store probes for 3 pinned records; 2 shared in this run, 1 from the result cache',
                      second.stdout)
        self.assertNotIn('pnpm store path', self.calls.read_text())
        report = self.run_cleanup()
        self.assertIn('Automatic candidates: 1', report.stdout)
        self.assertIn('Selectors: 3', report.stdout)
        for repo in repos:
            (repo / 'pnpm-lock.yaml').write_text('lockfileVersion: 9\n# upgraded\n')
        self.calls.unlink()
        third = self.run_cleanup('--yes')
        self.assertIn('1 store probes for 3 pinned records; 2 shared in this run, 0 from the result cache',
                      third.stdout)
        for repo in repos:
            (repo / 'package.json').write_text(json.dumps({'packageManager': 'pnpm@40.5.7'}))
        self.calls.unlink()
        fourth = self.run_cleanup('--yes')
        self.assertIn('1 store probes for 3 pinned records', fourth.stdout)
        self.assertIn('\t40.5.7', self.cache().read_text())
        self.assertNotIn('\t' + FIXTURE_PIN, self.cache().read_text())

    def test_result_cache_honors_xdg_state_home(self):
        self.worktrees(1)
        state = self.root / 'custom-state'
        self.env['XDG_STATE_HOME'] = str(state)
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertTrue((state / 'groundwork/pnpm-discovery-cache.tsv').exists())
        self.assertFalse(self.cache().exists())

    def test_corrupt_result_cache_is_treated_as_empty_and_replaced(self):
        self.worktrees(2)
        self.cache().parent.mkdir(parents=True)
        # A recent prune makes this a cache-reading run.
        (self.cache().parent / 'pnpm-prune-last-success').write_text(f'{int(time.time())} now\n')
        good = 'a' * 64 + '\t' + str(self.stores / 'v40') + '\t' + FIXTURE_PIN
        for content in ('garbage\n', 'groundwork pnpm discovery cache v1\nshort\t/x\t1.2.3\n',
                        'groundwork pnpm discovery cache v1\n' + good + '\textra\n', ''):
            with self.subTest(content=content):
                self.cache().write_text(content)
                self.calls.unlink(missing_ok=True)
                result = self.run_cleanup('--yes')
                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
                self.assertIn('ignored an unreadable result cache', result.stdout)
                self.assertEqual(self.calls.read_text().count('pnpm store path'), 1)
                self.assertTrue(self.cache().read_text().startswith('groundwork pnpm discovery cache v1\n'))

    def test_pending_pnpm_repair_re_probes_instead_of_trusting_the_cache(self):
        self.worktrees(2)
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.pending().parent.mkdir(parents=True, exist_ok=True)
        self.pending().write_text('2026-10-01T00:00:00Z pnpm store maintenance failed (exit 3)\n')
        self.calls.unlink()
        result = self.run_cleanup('--yes')
        self.assertIn('1 store probes for 2 pinned records; 1 shared in this run, 0 from the result cache',
                      result.stdout)

    def test_a_run_due_for_pnpm_maintenance_re_probes_instead_of_trusting_the_cache(self):
        self.worktrees(2)
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        success = self.home / '.local/state/groundwork/pnpm-prune-last-success'
        success.write_text(f'{int(time.time()) - 31 * 86400} 2026-09-30T00:00:00Z\n')
        self.calls.unlink()
        result = self.run_cleanup('--yes')
        self.assertIn('pnpm maintenance may run, so every store context is probed fresh', result.stdout)
        self.assertIn('1 store probes for 2 pinned records; 1 shared in this run, 0 from the result cache',
                      result.stdout)
        self.assertIn(' store prune', self.calls.read_text())
        self.calls.unlink()
        result = self.run_cleanup('--yes', '--force')
        self.assertIn('0 from the result cache', result.stdout)

    def pending(self):
        return self.home / '.local/state/groundwork/update-all-pending/pnpm'

    def test_discovery_timeout_warns_skips_pnpm_and_records_no_repair(self):
        self.repository('first-ready')
        slow = self.repository('second-hangs')
        (slow / '.hang').touch()
        # A distinct lockfile gives the hanging record its own store context.
        (slow / 'pnpm-lock.yaml').write_text('lockfileVersion: 9\n')
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('partial candidates discarded; pnpm store cleanup skipped', result.stdout)
        self.assertIn('Warning: pnpm store cleanup skipped this run because repository discovery '
                      'exceeded its 1s deadline.', result.stdout)
        self.assertIn('Package-manager maintenance completed.', result.stdout)
        calls = self.calls.read_text()
        self.assertIn('brew cleanup --prune=all', calls)
        self.assertIn('npm cache verify', calls)
        self.assertNotIn(' store prune', calls)
        self.assertFalse(self.pending().exists())
        state = self.home / '.local/state/groundwork'
        self.assertFalse(self.cache().exists())
        self.assertFalse((state / 'pnpm-prune-last-attempt').exists())
        self.assertFalse((state / 'pnpm-prune-last-success').exists())

    def test_incomplete_discovery_keeps_completed_notes_and_diagnostics(self):
        broken = self.root / 'broken-json'
        broken.mkdir()
        (broken / 'package.json').write_text('{not json')
        prerelease = self.root / 'prerelease'
        prerelease.mkdir()
        (prerelease / 'package.json').write_text(json.dumps({'packageManager': 'pnpm@10.0.0-rc.1'}))
        with self.records.open('a') as records:
            records.write(f'{broken}\tfixture\n{prerelease}\tfixture\n')
        self.repository('uncached', offline=True, pin='41.0.0')
        slow = self.repository('hangs')
        (slow / '.hang').touch()
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        review = result.stdout.split('Review recommended', 1)[1]
        self.assertIn('invalid or unreadable JSON', review)
        self.assertIn('prerelease pnpm pins are review-only', review)
        self.assertIn('pnpm@41.0.0 is uncached', review)
        self.assertIn("completed records' notes and diagnostics kept", review)
        self.assertNotIn(str(slow), review)
        logs = list((self.home / '.local/state/groundwork/logs').glob('pnpm-offline-probes.*'))
        self.assertEqual(len(logs), 1, result.stdout)
        self.assertIn('Network access disabled', logs[0].read_text())
        self.assertNotIn(' store prune', self.calls.read_text())

    def test_repeated_incomplete_discovery_names_its_limits_and_escalates(self):
        slow = self.repository('hangs')
        (slow / '.hang').touch()
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        self.env['GROUNDWORK_PNPM_DISCOVERY_JOBS'] = '3'
        counter = self.home / '.local/state/groundwork/pnpm-discovery-incomplete-runs'
        report = self.run_cleanup()
        self.assertEqual(report.returncode, 0, report.stdout + report.stderr)
        self.assertFalse(counter.exists())
        for run in (1, 2, 3):
            result = self.run_cleanup('--yes')
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
            self.assertIn('Discovery limits: GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS=1, '
                          'GROUNDWORK_PNPM_DISCOVERY_JOBS=3 (at most 16).', result.stdout)
            self.assertEqual(counter.read_text(), f'{run}\n')
            if run < 3:
                self.assertIn(f'Consecutive incomplete discoveries: {run} (owner review after 3).',
                              result.stdout)
                self.assertNotIn('have not been cleaned', result.stdout)
        self.assertIn('Warning: pnpm stores have not been cleaned for 3 runs', result.stdout)
        review = result.stdout.split('Review recommended', 1)[1]
        self.assertIn('pnpm stores have not been cleaned for 3 runs', review)
        self.assertIn('GROUNDWORK_PNPM_DISCOVERY_JOBS (now 3, at most 16)', review)
        self.assertIn('Package-manager maintenance completed.', result.stdout)
        counter.write_text('garbage\n')
        result = self.run_cleanup('--yes')
        self.assertEqual(counter.read_text(), '1\n')
        (slow / '.hang').unlink()
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('complete.', result.stdout)
        self.assertFalse(counter.exists())

    def test_discovery_timeout_reports_its_receipt_status(self):
        slow = self.repository('hangs')
        (slow / '.hang').touch()
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        receipt = self.root / 'receipt'
        # Stand in for the runner: it owns the transaction lock and lends fd 9.
        runner = ('. "$HOME/.local/lib/groundwork/update-lock.sh"\n'
                  'groundwork_lock_acquire update-all || exit\n'
                  'exec 9>"$1"\n'
                  'status=0\n'
                  'GROUNDWORK_CLEANUP_RECEIPT_FD=9 /bin/bash "$2" --yes || status=$?\n'
                  'groundwork_lock_release\n'
                  'exit "$status"\n')
        result = subprocess.run(['/bin/bash', '-c', runner, 'runner', str(receipt),
                                 str(REPO / 'home/dot_local/bin/executable_groundwork-cleanup')],
                                env=self.env, capture_output=True, text=True, timeout=20)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('pnpm\tdiscovery-incomplete\n', receipt.read_text())

    def test_discovery_timeout_keeps_a_real_pending_repair_failing(self):
        self.pending().parent.mkdir(parents=True)
        self.pending().write_text('2026-10-01T00:00:00Z pnpm store maintenance failed (exit 3)\n')
        slow = self.repository('hangs')
        (slow / '.hang').touch()
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        result = self.run_cleanup('--yes')
        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('an earlier pnpm repair is still pending', result.stderr)
        self.assertIn('pnpm store maintenance failed (exit 3)', self.pending().read_text())
        self.assertNotIn(' store prune', self.calls.read_text())

    def test_discovery_only_reminder_from_earlier_releases_is_retired(self):
        self.pending().parent.mkdir(parents=True)
        self.pending().write_text('2026-10-01T00:00:00Z exact repository discovery is unavailable; '
                                  'no pnpm store was touched\n')
        slow = self.repository('hangs')
        (slow / '.hang').touch()
        self.env['GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS'] = '1'
        result = self.run_cleanup('--yes')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('Retired an earlier pnpm reminder that recorded only incomplete discovery', result.stdout)
        self.assertFalse(self.pending().exists())

    def test_failed_prune_still_fails_and_records_a_repair(self):
        repo = self.repository('prune-fails')
        (repo / '.prune-fails').touch()
        result = self.run_cleanup('--yes')
        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('Store maintenance incomplete (exit 3)', result.stderr)
        self.assertIn('pnpm store maintenance failed (exit 3)', self.pending().read_text())

    def test_large_worktree_inventory_finishes_within_the_deadline_with_bounded_parallel_probes(self):
        # 25 repositories x 10 records (a main checkout plus nine linked
        # worktrees sharing its lockfile): exact pins, one uncached pin, npm
        # pins, records without package.json, and mostly no node_modules.
        # Serial probing at this simulated launch latency overruns the deadline.
        lines = []
        for number in range(25):
            kind = number % 10
            for worktree in range(10):
                repo = self.root / 'code' / f'repo{number:02d}' / ('main' if worktree == 0 else f'wt{worktree}')
                repo.mkdir(parents=True)
                lines.append(str(repo) + '\tfixture\n')
                if kind == 9:
                    continue
                if kind == 8:
                    (repo / 'package.json').write_text(json.dumps({'packageManager': 'npm@10.0.0'}))
                    continue
                pin, generation = {7: ('39.0.1', 'v39'), 6: ('41.0.0', None)}.get(kind, (FIXTURE_PIN, 'v40'))
                (repo / 'package.json').write_text(json.dumps({'packageManager': 'pnpm@' + pin}))
                (repo / 'pnpm-lock.yaml').write_text(f'lockfileVersion: 9\n# repo{number}\n')
                if generation is None:
                    (repo / '.offline').touch()
                else:
                    (self.stores / generation).mkdir(exist_ok=True)
                    (repo / '.npmrc').write_text('fixture-store=' + str(self.stores / generation) + '\n')
                if worktree % 3 == 0:
                    (repo / 'node_modules').mkdir()
        self.records.write_text(''.join(lines))
        active = self.root / 'active'
        active.mkdir()
        self.env.update(REVIEW_ACTIVE=str(active), REVIEW_LATENCY='0.1',
                        GROUNDWORK_PNPM_DISCOVERY_DEADLINE_SECONDS='40')
        started = time.monotonic()
        result = subprocess.run(['/bin/bash', str(REPO / 'home/dot_local/bin/executable_groundwork-cleanup')],
                                env=self.env, capture_output=True, text=True, timeout=90)
        elapsed = time.monotonic() - started
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        # Worktrees of one repository share its pin, lockfile, and configuration, so
        # each repository's store context is probed once.
        self.assertIn('inspected 250/250 repository records; 20 store probes for 210 pinned records; '
                      '189 shared in this run, 0 from the result cache, 1 known misses reused; complete.',
                      result.stdout)
        self.assertNotIn('hard deadline', result.stderr)
        self.assertIn('Automatic candidates: 2', result.stdout)
        overlap = [int(line) for line in Path(str(active) + '.log').read_text().split()]
        self.assertGreater(max(overlap), 1, 'probes never overlapped')
        self.assertLessEqual(max(overlap), 4, 'probe parallelism exceeded its bound')
        self.assertLess(elapsed, 40)

    def test_discovery_parallelism_is_a_validated_bound(self):
        for value in ('0', '17', 'many'):
            with self.subTest(value=value):
                self.env['GROUNDWORK_PNPM_DISCOVERY_JOBS'] = value
                result = self.run_cleanup()
                self.assertEqual(result.returncode, 64, result.stdout + result.stderr)
                self.assertFalse(self.calls.exists())

if __name__ == '__main__':
    unittest.main()
