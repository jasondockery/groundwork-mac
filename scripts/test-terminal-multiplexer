effective_key_owners = {}
for action, default in herdr_defaults.items():
    configured = keys[action] if action in keys else default
    bindings = [configured] if isinstance(configured, str) else configured
    for binding in bindings:
        assert binding not in effective_key_owners, (
            binding,
            effective_key_owners.get(binding),
            action,
        )
        effective_key_owners[binding] = action
for command in keys["command"]:
    binding = command["key"]
    assert binding not in effective_key_owners, (
        binding,
        effective_key_owners.get(binding),
        "command",
    )
    effective_key_owners[binding] = "command"
assert "swap_pane_up" not in effective_key_owners.values()
assert effective_key_owners["prefix+shift+h"] == "swap_pane_left"
assert effective_key_owners["prefix+shift+j"] == "swap_pane_down"
assert effective_key_owners["prefix+shift+k"] == "close_workspace"
assert effective_key_owners["prefix+shift+l"] == "swap_pane_right"

assert keys["command"] == [{
    "key": "prefix+g",
    "type": "popup",
    "command": 'if [ -n "${HERDR_ACTIVE_PANE_CWD:-}" ]; then cd "$HERDR_ACTIVE_PANE_CWD" || exit; fi; exec lazygit',
    "description": "open lazygit in the active pane directory when available",
    "width": "90%",
    "height": "90%",
}]
assert config["remote"] == {"manage_ssh_config": False}
assert "confirm_close" not in config["ui"]
assert "Workspace-close confirmation" in source_text
assert config["ui"] == {
    "accent": "blue",
