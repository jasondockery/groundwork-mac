#!/usr/bin/env bash
set -euo pipefail

# Isolate the fixtures from the developer's own terminal. These cases assert
# what a launcher does in a FRESH session; inheriting an ambient multiplexer
# makes them assert nesting instead, so running the validator the normal way —
# from inside tmux — failed on the environment rather than on the code. The
# nesting cases below set these variables explicitly where they are exercised.
unset TMUX TMUX_PANE HERDR_ENV

repo="$(cd "$(dirname "$0")/.." && pwd -P)"
tmp_parent=/tmp
[[ ! -d /private/tmp ]] || tmp_parent=/private/tmp
tmp="$(mktemp -d "$tmp_parent/groundwork-multiplexer.XXXXXX")"
trap 'rm -rf -- "$tmp"' EXIT

empty_config="$tmp/empty-config.toml"
: >"$empty_config"
base='"name":"CI User","email_personal":"ci@example.com","email_work":"","code_dir":"~/code","reset_existing_configs":false,"password_manager":"none","signingkey":"","obsidian_vault_name":"ci","game_dev":false,"profile_preset":"personal-current","environment_role":"personal","release_posture":"current","work":false,"headless":false,"xcode":false,"beta":false'

render() { # selection os source output [arch]
  local selection="$1" os="$2" source="$3" output="$4" arch="${5:-arm64}" os_release='{}'
  [[ "$os" != linux ]] || os_release='{"ID":"ubuntu"}'
  chezmoi --config "$empty_config" --source "$repo" --destination "$tmp/home" \
    --override-data "{${base},\"terminal_multiplexer\":\"$selection\",\"chezmoi\":{\"os\":\"$os\",\"arch\":\"$arch\",\"osRelease\":$os_release}}" \
    execute-template <"$source" >"$output"
}

assert_absent() { # literal file
  if grep -qF "$1" "$2"; then
    printf 'unexpected managed surface %s in %s\n' "$1" "$2" >&2
    exit 1
  fi
}

for os in darwin linux; do
  for selection in herdr tmux both none; do
    prefix="$tmp/$os-$selection"
    render "$selection" "$os" "$repo/home/dot_config/homebrew/Brewfile.tmpl" "$prefix.Brewfile"
    render "$selection" "$os" "$repo/home/run_after_20-tools.sh.tmpl" "$prefix.tools"
    render "$selection" "$os" "$repo/home/run_after_21-t3-code.sh.tmpl" "$prefix.t3"
    render "$selection" "$os" "$repo/home/run_after_09-herdr-config-ownership.sh.tmpl" "$prefix.herdr-hook"
    render "$selection" "$os" "$repo/home/dot_local/bin/executable_groundwork-mux.tmpl" "$prefix.launcher"
    render "$selection" "$os" "$repo/home/.chezmoiignore" "$prefix.ignore"
    bash -n "$prefix.tools"
    bash -n "$prefix.t3"
    bash -n "$prefix.herdr-hook"
    bash -n "$prefix.launcher"

    grep -qxF 'brew "herdr"' "$prefix.Brewfile"
    if [[ "$os" == darwin ]]; then
      grep -qF 'cask "t3-code@nightly"' "$prefix.Brewfile"
      grep -qF 'cask "vorssaint"' "$prefix.Brewfile"
    else
      assert_absent 'cask "t3-code@nightly"' "$prefix.Brewfile"
      assert_absent 'cask "vorssaint"' "$prefix.Brewfile"
    fi
    grep -qF 'groundwork_herdr_apply_owned' "$prefix.herdr-hook"
    grep -qF 'herdr completion zsh' "$prefix.tools"
    if [[ "$selection" == tmux || "$selection" == both ]]; then
      grep -qxF 'brew "tmux"' "$prefix.Brewfile"
      grep -qxF 'brew "sesh"' "$prefix.Brewfile"
      grep -qxF 'brew "tmuxp"' "$prefix.Brewfile"
      grep -qF 'tmux_plugin_dir=' "$prefix.tools"
      assert_absent '.config/tmux/**' "$prefix.ignore"
    else
      assert_absent 'brew "tmux"' "$prefix.Brewfile"
      assert_absent 'brew "sesh"' "$prefix.Brewfile"
      assert_absent 'brew "tmuxp"' "$prefix.Brewfile"
      assert_absent 'tmux_plugin_dir=' "$prefix.tools"
      grep -qxF '.config/tmux/**' "$prefix.ignore"
      grep -qxF '.config/sesh/**' "$prefix.ignore"
    fi
  done
done

render tmux linux "$repo/home/dot_config/homebrew/Brewfile.tmpl" "$tmp/linux-amd64.Brewfile" amd64
assert_absent 'cask "t3-code@nightly"' "$tmp/linux-amd64.Brewfile"
assert_absent 'cask "vorssaint"' "$tmp/linux-amd64.Brewfile"
render tmux darwin "$repo/home/dot_config/homebrew/Brewfile.tmpl" "$tmp/darwin-amd64.Brewfile" amd64
assert_absent 'cask "vorssaint"' "$tmp/darwin-amd64.Brewfile"
grep -qF 'cask "t3-code@nightly"' "$tmp/darwin-amd64.Brewfile"
render herdr linux "$repo/home/dot_config/homebrew/Brewfile.tmpl" "$tmp/linux-arm64.Brewfile" arm64
assert_absent 'cask "t3-code@nightly"' "$tmp/linux-arm64.Brewfile"
for arch in amd64 arm64; do
  render herdr linux "$repo/home/run_after_21-t3-code.sh.tmpl" "$tmp/linux-$arch.t3" "$arch"
  grep -qF 'https://t3.codes/install.sh' "$tmp/linux-$arch.t3"
done

grep -qF 'set -g prefix C-Space' "$repo/home/dot_config/tmux/tmux.conf.tmpl"
grep -qF 'set -g prefix2 C-b' "$repo/home/dot_config/tmux/tmux.conf.tmpl"
grep -qF 'bind C-b send-prefix -2' "$repo/home/dot_config/tmux/tmux.conf.tmpl"

python3 - "$repo/home/.chezmoitemplates/herdr.toml" <<'PY'
import sys, tomllib
from pathlib import Path
config_path = Path(sys.argv[1])
source_text = config_path.read_text()
assert "88de9ecc6c4717e349a21f9e8af3ffc0a9d25415" in source_text
assert "Herdr 0.9.5" in source_text
lines = source_text.splitlines()
for index, line in enumerate(lines):
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or stripped.startswith("["):
        continue
    if "=" not in stripped:
        continue
    previous = ""
    for earlier in range(index - 1, -1, -1):
        previous = lines[earlier].strip()
        if previous:
            break
    assert previous.startswith("#"), (stripped, previous)
with config_path.open("rb") as source:
    config = tomllib.load(source)
assert set(config) == {"onboarding", "theme", "keys", "remote", "ui"}
assert config["onboarding"] is False
assert config["theme"] == {
    "name": "terminal",
    "custom": {"panel_bg": "reset", "surface_dim": "black"},
}
assert "terminal" not in config
assert "session" not in config
assert "experimental" not in config
keys = config["keys"]
expected_keys = {'prefix': ['ctrl+space', 'ctrl+b'],
