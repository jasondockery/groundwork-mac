#!/usr/bin/env python3
"""Behavioral proof for the Brave offer, profile render, and browser helper."""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import tempfile
import unittest
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
BRAVE = REPO / "home/dot_local/bin/executable_groundwork-brave-browser"
EXTENSIONS = REPO / "home/dot_local/bin/executable_browser-extensions"
LIB = REPO / "home/dot_local/share/groundwork/lib/brave_browser.py"
SPEC = REPO / "core/browser/brave.json"
HOOK = REPO / "home/run_onchange_after_15-brave-browser.sh.tmpl"
CHROME_NOTICE = (
    "Chrome is no longer Groundwork-managed. Import with brave://settings/importData, "
    "then remove it by hand with: brew uninstall --cask google-chrome"
)
CHROME_BETA_NOTICE = (
    "Chrome Beta is still installed but is no longer Groundwork-managed. "
    "No app or browser data is removed. Remove it by hand with: "
    "brew uninstall --cask google-chrome@beta"
)
ADOPTION_NOTICE = (
    "Brave Browser.app is installed but Homebrew does not own it. "
    "Review interactively: groundwork-app-adopt brave-browser"
)
MANAGED_NOTICE = "This Mac is work-managed, so Groundwork did not write a Brave policy profile."


class BraveBrowserTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        self.home = self.root / "home"
        self.bin = self.root / "bin"
        self.logs = self.root / "logs"
        self.share = self.root / "share"
        self.ext = self.root / "ext"
        self.state = self.root / "state"
        self.apps = self.root / "Applications"
        for path in (self.home, self.bin, self.logs, self.apps):
            path.mkdir()
        self.profiles = self.root / "profiles.txt"
        self.profiles.write_text("no managed profiles\n")
        self._write_brew("")
        self._write_defaultbrowser("* chrome\n", 0)
        self._write_adopt(0)
        self.spec = json.loads(SPEC.read_text(encoding="utf-8"))

    def tearDown(self):
        self.tmp.cleanup()

    def _write_brew(self, installed: str) -> None:
        script = self.bin / "brew"
        script.write_text(
            "#!/bin/sh\n"
            f"printf '%s\\n' \"$*\" >> {self.logs / 'brew'}\n"
            'if [ "$1 $2" = "list --cask" ]; then\n'
            '  case " $INSTALLED_CASKS " in\n'
            '    *" $3 "*) exit 0 ;;\n'
            "    *) exit 1 ;;\n"
            "  esac\n"
            "fi\n"
            "exit 2\n"
        )
        script.chmod(0o755)

    def _write_defaultbrowser(self, listing: str, set_status: int) -> None:
        listing_path = self.root / "defaultbrowser-list"
        listing_path.write_text(listing)
        script = self.bin / "defaultbrowser"
        script.write_text(
            "#!/bin/sh\n"
            f"if [ $# -eq 0 ]; then printf 'list\\n' >> {self.logs / 'defaultbrowser'}; "
            f"cat {listing_path}; exit 0; fi\n"
            f"printf 'set %s\\n' \"$1\" >> {self.logs / 'defaultbrowser'}\n"
            f"exit {set_status}\n"
        )
        script.chmod(0o755)

    def _write_adopt(self, status: int) -> None:
        script = self.bin / "groundwork-app-adopt"
        script.write_text(
            "#!/bin/sh\n"
            f"printf '%s\\n' \"$*\" >> {self.logs / 'adopt'}\n"
            f"exit {status}\n"
        )
        script.chmod(0o755)

    def env(self, **extra: str) -> dict[str, str]:
        base = os.environ.copy()
        base.update(
            {
                "HOME": str(self.home),
                "INSTALLED_CASKS": extra.pop("INSTALLED_CASKS", ""),
                "GROUNDWORK_BRAVE_PLATFORM": "Darwin",
                "GROUNDWORK_BRAVE_HEADLESS": "false",
                "GROUNDWORK_BRAVE_ROLE": "personal",
                "GROUNDWORK_BRAVE_PASSWORD_MANAGER": "bitwarden",
                "GROUNDWORK_BRAVE_SPEC": str(SPEC),
                "GROUNDWORK_STATE_DIR": str(self.state),
                "GROUNDWORK_BRAVE_SHARE_DIR": str(self.share),
                "GROUNDWORK_BRAVE_EXTENSION_DIR": str(self.ext),
                "GROUNDWORK_APPLICATIONS_DIR": str(self.apps),
                "GROUNDWORK_BREW_BIN": str(self.bin / "brew"),
                "GROUNDWORK_BRAVE_DEFAULTBROWSER": str(self.bin / "defaultbrowser"),
                "GROUNDWORK_BRAVE_PROFILES_OUTPUT": str(self.profiles),
                "GROUNDWORK_BRAVE_OPEN_LOG": str(self.logs / "open"),
                "GROUNDWORK_BRAVE_ADOPT_BIN": str(self.bin / "groundwork-app-adopt"),
                "PATH": f"{self.bin}:{os.environ.get('PATH', '')}",
            }
        )
        for key in (
            "GROUNDWORK_UPDATE_SCOPE",
            "GROUNDWORK_BRAVE_NONINTERACTIVE",
            "GROUNDWORK_BRAVE_ANSWERS",
        ):
            base.pop(key, None)
        base.update(extra)
        return base

    def run_brave(self, *args: str, env: dict[str, str] | None = None, answers: str | None = None):
        environment = self.env() if env is None else env
        if answers is not None:
            answer_path = self.root / "answers"
            answer_path.write_text(answers)
            environment["GROUNDWORK_BRAVE_ANSWERS"] = str(answer_path)
        return subprocess.run(
            ["bash", str(BRAVE), *args],
            text=True,
            capture_output=True,
            env=environment,
            timeout=20,
            check=False,
        )

    def choice(self, name: str) -> str | None:
        path = self.state / "brave" / name
        if not path.exists():
            return None
        return path.read_text(encoding="utf-8").strip()

    def seed(self, name: str, value: str) -> None:
        directory = self.state / "brave"
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / name
        path.write_text(value + "\n")
        path.chmod(0o600)

    def log(self, name: str) -> str:
        path = self.logs / name
        return path.read_text(encoding="utf-8") if path.exists() else ""

    def render_python(self, password_manager: str, spec: Path | None = None) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            [
                "python3",
                str(LIB),
                "mobileconfig",
                "--spec",
                str(spec or SPEC),
                "--password-manager",
                password_manager,
            ],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )

    def test_help_and_bad_args_create_nothing(self):
        help_run = self.run_brave("--help")
        self.assertEqual(help_run.returncode, 0, help_run.stderr)
        self.assertIn("v0.7.0", help_run.stdout)
        self.assertFalse((self.state / "brave").exists())
        self.assertFalse(self.share.exists())
        bad = self.run_brave("--apply", "--notice")
        self.assertEqual(bad.returncode, 64, bad.stderr)
        missing = self.run_brave()
        self.assertEqual(missing.returncode, 64)

    def test_profile_renders_spec_policies_without_metadata(self):
        rendered = self.render_python("bitwarden")
        self.assertEqual(rendered.returncode, 0, rendered.stderr)
        profile = rendered.stdout
        self.assertIn("com.groundwork.brave.browser", profile)
        locked = {
            "BraveRewardsDisabled": True,
            "BraveWalletDisabled": True,
            "BraveVPNDisabled": True,
            "BraveAIChatEnabled": False,
            "BraveLocalAIEnabled": False,
            "BraveP3AEnabled": False,
            "BraveStatsPingEnabled": False,
            "PasswordManagerEnabled": False,
        }
        for policy in self.spec["policies"]:
            self.assertIn(f"<key>{policy['name']}</key>", profile)
            self.assertNotIn(policy["reason"], profile)
            if policy.get("when") not in (None, "Bitwarden is the password manager."):
                continue
            token = "true" if policy["value"] else "false"
            self.assertIn(
                f"      <key>{policy['name']}</key>\n      <{token}/>",
                profile,
            )
            if policy["name"] in locked:
                self.assertEqual(policy["value"], locked[policy["name"]])
        for name, value in locked.items():
            token = "true" if value else "false"
            self.assertIn(f"      <key>{name}</key>\n      <{token}/>", profile)
        self.assertNotIn("upstreamDefault", profile)
        self.assertNotIn("<key>when</key>", profile)
        self.assertNotIn("<key>reason</key>", profile)
        self.assertNotIn("Ads-for-crypto", profile)
        without = self.render_python("1password")
        self.assertEqual(without.returncode, 0, without.stderr)
        self.assertNotIn("PasswordManagerEnabled", without.stdout)
        none = self.render_python("none")
        self.assertNotIn("PasswordManagerEnabled", none.stdout)
        handler = subprocess.run(
            ["python3", str(LIB), "handler", "--spec", str(SPEC)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(handler.stdout.strip(), "browser")

    def test_unknown_when_fails_closed(self):
        broken = self.root / "brave.json"
        spec = json.loads(SPEC.read_text(encoding="utf-8"))
        spec["policies"][0]["when"] = "always"
        broken.write_text(json.dumps(spec))
        environment = self.env(GROUNDWORK_BRAVE_SPEC=str(broken), INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertIn("unknown Brave policy condition", result.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

    def test_upstream_default_value_fails_closed(self):
        broken = self.root / "brave.json"
        spec = json.loads(SPEC.read_text(encoding="utf-8"))
        entry = spec["policies"][0]
        self.assertIn("upstreamDefault", entry)
        self.assertNotEqual(entry["value"], entry["upstreamDefault"])
        entry["value"] = entry["upstreamDefault"]
        broken.write_text(json.dumps(spec))
        environment = self.env(GROUNDWORK_BRAVE_SPEC=str(broken), INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertIn("restates the upstream default", result.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

    def test_accept_default_browser_uses_handler_from_spec(self):
        self.profiles.write_text("com.groundwork.brave.browser\n")
        self.seed("extension-offer", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("set browser\n", self.log("defaultbrowser"))
        self.assertEqual(self.choice("default-browser"), "accepted")
        self.assertNotIn("uninstall", self.log("brew"))

    def test_decline_is_sticky(self):
        self.profiles.write_text("com.groundwork.brave.browser\n")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        self.assertEqual(self.choice("default-browser"), "declined")

    def test_noninteractive_notices_without_saving_or_setting(self):
        environment = self.env(
            INSTALLED_CASKS="brave-browser",
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
        )
        result = self.run_brave("--apply", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("defaultbrowser browser", result.stdout)
        self.assertIsNone(self.choice("default-browser"))
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        self.assertIn("list\n", self.log("defaultbrowser"))

    def test_chrome_notice_does_not_uninstall(self):
        environment = self.env(
            INSTALLED_CASKS="google-chrome",
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
        )
        result = self.run_brave("--notice", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn(CHROME_NOTICE, result.stdout)
        self.assertNotIn("uninstall", self.log("brew"))
        app = self.apps / "Google Chrome.app"
        app.mkdir()
        environment = self.env(INSTALLED_CASKS="", GROUNDWORK_BRAVE_NONINTERACTIVE="1")
        app_only = self.run_brave("--notice", env=environment)
        self.assertIn(CHROME_NOTICE, app_only.stdout)
        self.assertNotIn("uninstall", self.log("brew"))
        app.rmdir()
        beta = self.env(
            INSTALLED_CASKS="google-chrome@beta",
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
        )
        beta_notice = self.run_brave("--notice", env=beta)
        self.assertEqual(beta_notice.returncode, 0, beta_notice.stderr)
        self.assertIn(CHROME_BETA_NOTICE, beta_notice.stdout)
        self.assertNotIn(CHROME_NOTICE, beta_notice.stdout)
        self.assertNotIn("uninstall", self.log("brew"))
        beta_apply = self.run_brave("--apply", env=beta)
        self.assertEqual(beta_apply.returncode, 0, beta_apply.stderr)
        self.assertIn(CHROME_BETA_NOTICE, beta_apply.stdout)
        self.assertNotIn("uninstall", self.log("brew"))
        (self.apps / "Google Chrome Beta.app").mkdir()
        beta_app = self.env(INSTALLED_CASKS="", GROUNDWORK_BRAVE_NONINTERACTIVE="1")
        beta_app_notice = self.run_brave("--notice", env=beta_app)
        self.assertIn(CHROME_BETA_NOTICE, beta_app_notice.stdout)
        self.assertNotIn(CHROME_NOTICE, beta_app_notice.stdout)
        doctor = self.run_brave("--doctor", env=beta_app)
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn(CHROME_BETA_NOTICE, doctor.stdout)
        self.assertNotIn("uninstall", self.log("brew"))

    def test_adoption_respects_yes_no_and_noninteractive(self):
        (self.apps / "Brave Browser.app").mkdir()
        self.profiles.write_text("com.groundwork.brave.browser\n")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        yes = self.run_brave("--apply", answers="y\n")
        self.assertEqual(yes.returncode, 0, yes.stderr)
        self.assertIn("--yes brave-browser", self.log("adopt"))
        self.assertEqual(self.choice("adoption"), "accepted")

        shutil.rmtree(self.state)
        (self.logs / "adopt").unlink()
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        no = self.run_brave("--apply", answers="n\n")
        self.assertEqual(no.returncode, 0, no.stderr)
        self.assertEqual(self.log("adopt"), "")
        self.assertEqual(self.choice("adoption"), "declined")

        shutil.rmtree(self.state)
        quiet = self.run_brave("--apply", env=self.env(GROUNDWORK_BRAVE_NONINTERACTIVE="1"))
        self.assertEqual(quiet.returncode, 0, quiet.stderr)
        self.assertIn(ADOPTION_NOTICE, quiet.stdout)
        self.assertEqual(self.log("adopt"), "")
        self.assertIsNone(self.choice("adoption"))

    def test_extension_offer_writes_spec_url_only_after_yes(self):
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        extension_id = self.spec["extensions"][0]["id"]
        update_url = self.spec["extensions"][0]["updateUrl"]
        yes = self.run_brave("--apply", answers="y\n")
        self.assertEqual(yes.returncode, 0, yes.stderr)
        written = json.loads((self.ext / f"{extension_id}.json").read_text(encoding="utf-8"))
        self.assertEqual(written, {"external_update_url": update_url})
        self.assertEqual(self.choice("extension-offer"), "accepted")

        shutil.rmtree(self.ext)
        shutil.rmtree(self.state)
        no = self.run_brave("--apply", answers="n\n")
        self.assertEqual(no.returncode, 0, no.stderr)
        self.assertFalse(self.ext.exists())
        self.assertEqual(self.choice("extension-offer"), "declined")

    def test_work_managed_does_not_write_a_profile(self):
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(GROUNDWORK_BRAVE_ROLE="managed", INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn(MANAGED_NOTICE, result.stdout)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

    def test_replaced_profile_is_offered_again(self):
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n")
        self.seed("policy-open", "accepted")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        result = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(INSTALLED_CASKS="brave-browser"),
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        profile_path = self.share / "Brave-Browser.mobileconfig"
        self.assertIn(str(profile_path), self.log("open"))
        profile = profile_path.read_text(encoding="utf-8")
        self.assertNotIn("old profile", profile)
        self.assertIn("PasswordManagerEnabled", profile)
        self.assertNotIn("upstreamDefault", profile)
        self.assertEqual(self.choice("policy-open"), "accepted")
        digest = hashlib.sha256(profile.encode()).hexdigest()
        self.assertEqual(self.choice("policy-render"), digest)

    def test_unchanged_installed_profile_is_not_reopened(self):
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        first = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertIn("Brave-Browser.mobileconfig", self.log("open"))
        (self.logs / "open").unlink()
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        second = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertEqual(self.log("open"), "")
        self.assertIsNone(self.choice("policy-open"))

    def test_noninteractive_profile_change_does_not_save_a_decline(self):
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n")
        self.seed("policy-open", "accepted")
        environment = self.env(
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
            INSTALLED_CASKS="brave-browser",
        )
        result = self.run_brave("--apply", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("The Brave policy profile changed.", result.stdout)
        self.assertIsNone(self.choice("policy-open"))
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertIn("The Brave policy profile changed.", notice.stdout)
        doctor = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn("does not match the current Groundwork spec", doctor.stdout)
        self.assertNotIn("ok    Brave policy profile is installed", doctor.stdout)

    def test_update_scope_profile_change_stays_quiet(self):
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n")
        result = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(
                GROUNDWORK_UPDATE_SCOPE="maintenance",
                INSTALLED_CASKS="brave-browser",
            ),
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")
        self.assertIsNone(self.choice("policy-open"))
        self.assertNotIn("old profile", (self.share / "Brave-Browser.mobileconfig").read_text())
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        follow = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(INSTALLED_CASKS="brave-browser"),
        )
        self.assertEqual(follow.returncode, 0, follow.stderr)
        profile_path = self.share / "Brave-Browser.mobileconfig"
        self.assertIn(str(profile_path), self.log("open"))
        self.assertEqual(self.choice("policy-open"), "accepted")
        digest = hashlib.sha256(profile_path.read_bytes()).hexdigest()
        self.assertEqual(self.choice("policy-render"), digest)

    def test_failed_adoption_is_not_saved(self):
        (self.apps / "Brave Browser.app").mkdir()
        self.profiles.write_text("attribute: com.groundwork.brave.browser\n")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        self._write_adopt(1)
        first = self.run_brave("--apply", answers="y\n")
        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertIn("--yes brave-browser", self.log("adopt"))
        self.assertIsNone(self.choice("adoption"))
        (self.logs / "adopt").unlink()
        second = self.run_brave("--apply", answers="y\n")
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertIn("--yes brave-browser", self.log("adopt"))
        self.assertIsNone(self.choice("adoption"))

    def test_update_scope_writes_policy_without_notices_or_commands(self):
        environment = self.env(INSTALLED_CASKS="brave-browser", GROUNDWORK_UPDATE_SCOPE="maintenance")
        result = self.run_brave("--apply", env=environment, answers="y\n")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")
        profile = (self.share / "Brave-Browser.mobileconfig").read_text(encoding="utf-8")
        self.assertIn("PasswordManagerEnabled", profile)
        self.assertNotIn("upstreamDefault", profile)
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        self.assertIsNone(self.choice("default-browser"))

    def test_browser_extensions_reads_the_spec(self):
        environment = self.env()
        listed = subprocess.run(
            ["bash", str(EXTENSIONS)],
            text=True,
            capture_output=True,
            env=environment,
            timeout=15,
            check=False,
        )
        self.assertEqual(listed.returncode, 0, listed.stderr)
        self.assertIn("brave", listed.stdout)
        self.assertIn(self.spec["extensions"][0]["id"], listed.stdout)
        rejected = subprocess.run(
            ["bash", str(EXTENSIONS), "--browser", "chrome"],
            text=True,
            capture_output=True,
            env=environment,
            timeout=15,
            check=False,
        )
        self.assertEqual(rejected.returncode, 2)

    def test_hook_renders_apply_on_desktop_and_exit_on_headless(self):
        chezmoi = shutil.which("chezmoi") or str(Path.home() / ".local/bin/chezmoi")
        self.assertTrue(Path(chezmoi).is_file(), "chezmoi is required to render the Brave hook")
        config = self.root / "empty.toml"
        config.write_text("")

        def render(os_name: str, headless: bool) -> str:
            data = {
                "name": "CI User",
                "email_personal": "ci@example.com",
                "email_work": "",
                "code_dir": "~/code",
                "reset_existing_configs": False,
                "password_manager": "bitwarden",
                "signingkey": "",
                "obsidian_vault_name": "ci",
                "game_dev": False,
                "profile_preset": "personal-current",
                "environment_role": "personal",
                "release_posture": "current",
                "headless": headless,
                "work": False,
                "xcode": False,
                "beta": False,
                "chezmoi": {"os": os_name, "arch": "arm64"},
            }
            result = subprocess.run(
                [
                    chezmoi,
                    "--config",
                    str(config),
                    "--source",
                    str(REPO),
                    "--override-data",
                    json.dumps(data),
                    "execute-template",
                ],
                input=HOOK.read_text(encoding="utf-8"),
                text=True,
                capture_output=True,
                timeout=20,
                check=False,
            )
            self.assertEqual(result.returncode, 0, result.stderr)
            return result.stdout

        desktop = render("darwin", False)
        self.assertIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', desktop)
        self.assertIn("Brave spec hash:", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_SPEC=", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_PASSWORD_MANAGER=", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_ROLE=", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_HEADLESS=false", desktop)
        self.assertIn("checkout-core.sh", desktop)
        self.assertIn("submodule update --init -- core", (REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh").read_text(encoding="utf-8"))
        for line in desktop.splitlines():
            stripped = line.strip()
            self.assertFalse(stripped.startswith("chezmoi"))
            self.assertNotIn("$(chezmoi", line)
            self.assertNotIn("`chezmoi", line)
        headless = render("darwin", True)
        self.assertNotIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', headless)
        self.assertNotIn("Brave spec hash:", headless)
        self.assertNotIn("checkout-core.sh", headless)
        self.assertIn("exit 0", headless)
        linux = render("linux", False)
        self.assertNotIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', linux)
        self.assertNotIn("Brave spec hash:", linux)
        self.assertNotIn("checkout-core.sh", linux)
        self.assertIn("exit 0", linux)
        for script in (desktop, headless, linux):
            syntax = subprocess.run(
                ["bash", "-n"],
                input=script,
                text=True,
                capture_output=True,
                timeout=15,
                check=False,
            )
            self.assertEqual(syntax.returncode, 0, syntax.stderr + script)
            self.assertTrue(script.startswith("#!/usr/bin/env bash\n"))

        missing = self.root / "spec-missing"
        (missing / "home").mkdir(parents=True)
        (missing / ".chezmoiroot").write_text("home\n")
        missing_template = HOOK.read_text(encoding="utf-8")

        def render_missing(
            os_name: str, headless_value: bool, *, include_role: bool = True
        ) -> subprocess.CompletedProcess[str]:
            data = {
                "name": "CI User",
                "email_personal": "ci@example.com",
                "email_work": "",
                "code_dir": "~/code",
                "reset_existing_configs": False,
                "password_manager": "bitwarden",
                "signingkey": "",
                "obsidian_vault_name": "ci",
                "game_dev": False,
                "profile_preset": "personal-current",
                "release_posture": "current",
                "headless": headless_value,
                "work": False,
                "xcode": False,
                "beta": False,
                "chezmoi": {"os": os_name, "arch": "arm64"},
            }
            if include_role:
                data["environment_role"] = "personal"
            return subprocess.run(
                [
                    chezmoi,
                    "--config",
                    str(config),
                    "--source",
                    str(missing),
                    "--override-data",
                    json.dumps(data),
                    "execute-template",
                ],
                input=missing_template,
                text=True,
                capture_output=True,
                timeout=20,
                check=False,
            )

        linux_missing = render_missing("linux", True)
        self.assertEqual(linux_missing.returncode, 0, linux_missing.stderr)
        self.assertIn("exit 0", linux_missing.stdout)
        self.assertNotIn("brave.json", linux_missing.stderr)
        self.assertNotIn("checkout-core.sh", linux_missing.stdout)
        darwin_missing = render_missing("darwin", False)
        self.assertEqual(darwin_missing.returncode, 0, darwin_missing.stderr)
        self.assertNotIn("brave.json", darwin_missing.stderr)
        self.assertNotIn("cat:", darwin_missing.stderr)
        self.assertNotIn("Brave spec hash:", darwin_missing.stdout)
        self.assertIn("checkout-core.sh", darwin_missing.stdout)
        self.assertIn("so Brave was not offered.", darwin_missing.stdout)
        self.assertIn("export GROUNDWORK_BRAVE_SPEC=", darwin_missing.stdout)
        darwin_headless_missing = render_missing("darwin", True)
        self.assertEqual(darwin_headless_missing.returncode, 0, darwin_headless_missing.stderr)
        self.assertIn("exit 0", darwin_headless_missing.stdout)
        self.assertNotIn("brave.json", darwin_headless_missing.stderr)
        self.assertNotIn("checkout-core.sh", darwin_headless_missing.stdout)
        # The container config has password_manager and headless, and no
        # environment_role. Headless apply must still succeed.
        linux_container = render_missing("linux", True, include_role=False)
        self.assertEqual(linux_container.returncode, 0, linux_container.stderr)
        self.assertIn("exit 0", linux_container.stdout)
        darwin_container = render_missing("darwin", True, include_role=False)
        self.assertEqual(darwin_container.returncode, 0, darwin_container.stderr)
        self.assertIn("exit 0", darwin_container.stdout)
        for rendered in (linux_container, darwin_container):
            self.assertNotIn("checkout-core.sh", rendered.stdout)
            syntax = subprocess.run(
                ["bash", "-n"],
                input=rendered.stdout,
                text=True,
                capture_output=True,
                timeout=15,
                check=False,
            )
            self.assertEqual(syntax.returncode, 0, syntax.stderr + rendered.stdout)
        spec_dest = missing / "core" / "browser"
        spec_dest.mkdir(parents=True)
        shutil.copy(SPEC, spec_dest / "brave.json")
        followed = render_missing("darwin", False)
        self.assertEqual(followed.returncode, 0, followed.stderr)
        self.assertIn("Brave spec hash:", followed.stdout)
        self.assertIn(hashlib.sha256(SPEC.read_bytes()).hexdigest(), followed.stdout)

    def test_apply_reads_spec_from_working_tree_without_calling_chezmoi(self):
        installed = self.root / "installed"
        bin_dir = installed / ".local/bin"
        lib_dir = installed / ".local/share/groundwork/lib"
        bin_dir.mkdir(parents=True)
        lib_dir.mkdir(parents=True)
        shutil.copy(BRAVE, bin_dir / "groundwork-brave-browser")
        shutil.copy(LIB, lib_dir / "brave_browser.py")
        work = self.root / "work"
        spec_dir = work / "core/browser"
        spec_dir.mkdir(parents=True)
        (spec_dir / "brave.json").symlink_to(SPEC)
        chezmoi = self.bin / "chezmoi"
        chezmoi.write_text(
            "#!/bin/sh\n"
            f"printf '%s\\n' \"$*\" >> {self.logs / 'chezmoi'}\n"
            "exit 1\n"
        )
        chezmoi.chmod(0o755)
        environment = self.env(
            INSTALLED_CASKS="brave-browser",
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
        )
        environment.pop("GROUNDWORK_BRAVE_SPEC")
        environment["CHEZMOI_WORKING_TREE"] = str(work)
        environment["PATH"] = f"{self.bin}:{environment['PATH']}"
        result = subprocess.run(
            ["bash", str(bin_dir / "groundwork-brave-browser"), "--apply"],
            text=True,
            capture_output=True,
            env=environment,
            timeout=20,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        profile = self.share / "Brave-Browser.mobileconfig"
        self.assertTrue(profile.is_file())
        self.assertIn("PasswordManagerEnabled", profile.read_text(encoding="utf-8"))
        self.assertEqual(self.log("chezmoi"), "")

    def test_open_without_an_installed_profile_is_offered_again(self):
        self.seed("policy-open", "accepted")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        first = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertIn("Brave-Browser.mobileconfig", self.log("open"))
        self.assertIsNone(self.choice("policy-open"))
        (self.logs / "open").unlink()
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertIn("Approve the Brave policy profile", notice.stdout)
        doctor = self.run_brave("--doctor", env=environment)
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn(
            "Brave policy profile is not installed. The next interactive apply will offer it again.",
            doctor.stdout,
        )
        second = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertIn("Brave-Browser.mobileconfig", self.log("open"))
        self.assertIsNone(self.choice("policy-open"))

    def test_missing_profile_keeps_a_decline(self):
        self.seed("policy-open", "declined")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.log("open"), "")
        self.assertEqual(self.choice("policy-open"), "declined")
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertNotIn("Approve the Brave policy profile", notice.stdout)
        self.assertNotIn("An interactive apply writes", notice.stdout)

    def _chezmoi_data(self, payload: str) -> None:
        data_path = self.root / "chezmoi-data.json"
        data_path.write_text(payload, encoding="utf-8")
        script = self.bin / "chezmoi"
        script.write_text(
            "#!/bin/sh\n"
            'if [ "$1" = data ]; then\n'
            f"  cat {data_path}\n"
            "  exit 0\n"
            "fi\n"
            "exit 1\n"
        )
        script.chmod(0o755)

    def _env_without_profile(self) -> dict[str, str]:
        environment = self.env(INSTALLED_CASKS="brave-browser", GROUNDWORK_BRAVE_NONINTERACTIVE="1")
        for key in (
            "GROUNDWORK_BRAVE_ROLE",
            "GROUNDWORK_BRAVE_PASSWORD_MANAGER",
            "GROUNDWORK_BRAVE_HEADLESS",
        ):
            environment.pop(key, None)
        environment["PATH"] = f"{self.bin}:{environment['PATH']}"
        return environment

    def test_direct_run_without_profile_data_writes_nothing(self):
        script = self.bin / "chezmoi"
        script.write_text("#!/bin/sh\nexit 1\n")
        script.chmod(0o755)
        result = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertIn("profile data is missing", result.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

        self._chezmoi_data('{"environment_role":"personal","headless":false}')
        incomplete = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(incomplete.returncode, 1, incomplete.stderr)
        self.assertIn("profile data is incomplete", incomplete.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

        self._chezmoi_data("[]")
        not_object = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(not_object.returncode, 1, not_object.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

    def test_direct_run_reads_a_complete_profile_without_defaults(self):
        self._chezmoi_data(
            '{"environment_role":"personal","password_manager":"bitwarden","headless":false}'
        )
        result = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(result.returncode, 0, result.stderr)
        profile = (self.share / "Brave-Browser.mobileconfig").read_text(encoding="utf-8")
        self.assertIn("PasswordManagerEnabled", profile)

        self._chezmoi_data(
            '{"environment_role":"personal","password_manager":"bitwarden","headless":true}'
        )
        profile_path = self.share / "Brave-Browser.mobileconfig"
        profile_path.unlink()
        headless = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(headless.returncode, 0, headless.stderr)
        self.assertFalse(profile_path.exists())

    def test_checkout_core_rejects_bad_arguments_before_git(self):
        helper = REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh"
        text = helper.read_text(encoding="utf-8")
        self.assertIn("submodule update --init -- core", text)
        self.assertNotRegex(text, r"submodule update[^\n]*--remote")
        missing_args = subprocess.run(
            ["bash", str(helper)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(missing_args.returncode, 64, missing_args.stderr)
        empty = self.root / "not-a-checkout"
        empty.mkdir()
        skipped = subprocess.run(
            ["bash", str(helper), str(empty)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(skipped.returncode, 0, skipped.stderr)
        repo = self.root / "deadline-repo"
        repo.mkdir()
        subprocess.run(["git", "init", "-q", str(repo)], check=True, timeout=15)
        (repo / ".gitmodules").write_text(
            '[submodule "core"]\n\tpath = core\n\turl = file:///nowhere\n',
            encoding="utf-8",
        )
        bad_deadline = subprocess.run(
            ["bash", str(helper), str(repo)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
            env={**os.environ, "GROUNDWORK_CORE_CHECKOUT_DEADLINE_SECONDS": "0", "GIT_TERMINAL_PROMPT": "0"},
        )
        self.assertEqual(bad_deadline.returncode, 64, bad_deadline.stderr)
        self.assertIn("deadline", bad_deadline.stderr)

        def sleepers() -> set[str]:
            listed = subprocess.run(
                ["ps", "-eo", "pid,args"],
                text=True,
                capture_output=True,
                timeout=15,
                check=True,
            )
            return {
                line.strip()
                for line in listed.stdout.splitlines()
                if " sleep " in f" {line} "
            }

        before_sleepers = sleepers()
        checkout = subprocess.run(
            ["bash", str(helper), str(REPO)],
            text=True,
            capture_output=True,
            timeout=30,
            check=False,
        )
        self.assertEqual(checkout.returncode, 0, checkout.stderr)
        self.assertEqual(sleepers(), before_sleepers)

    def test_old_update_all_checks_out_core_before_the_spec_is_read(self):
        main = "78b4e2509d684f41022d63ee7999e68c9bc7dcd9"
        old_core = "bc21e6297136be3f04b190fd22c517ce7d5f15eb"
        new_core = "0395895c86ed24d942c3803c521cf2131cfa52c7"
        core_head = subprocess.run(
            ["git", "-C", str(REPO / "core"), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        bare = self.root / "core.git"
        subprocess.run(["git", "init", "--bare", "-q", str(bare)], check=True, timeout=15)
        for sha in (old_core, new_core):
            listed = subprocess.run(
                ["git", "-C", str(REPO / "core"), "rev-list", "--objects", sha],
                capture_output=True,
                check=True,
                timeout=30,
            )
            ids = b"\n".join(line.split()[0] for line in listed.stdout.splitlines() if line.strip()) + b"\n"
            packed = subprocess.run(
                ["git", "-C", str(REPO / "core"), "pack-objects", str(self.root / "pack")],
                input=ids,
                capture_output=True,
                check=True,
                timeout=30,
            )
            pack_id = packed.stdout.decode().strip().splitlines()[-1]
            pack_dir = bare / "objects" / "pack"
            for suffix in (".pack", ".idx"):
                shutil.copy(self.root / f"pack-{pack_id}{suffix}", pack_dir / f"pack-{pack_id}{suffix}")
        subprocess.run(
            ["git", "--git-dir", str(bare), "update-ref", "refs/heads/old", old_core],
            check=True,
            timeout=15,
        )
        subprocess.run(
            ["git", "--git-dir", str(bare), "update-ref", "refs/heads/new", new_core],
            check=True,
            timeout=15,
        )
        # The source submodule is shallow, so these commits have no parents in
        # the pack. Mark the bare repo shallow or upload-pack refuses the clone.
        (bare / "shallow").write_text(f"{old_core}\n{new_core}\n", encoding="utf-8")
        parent = self.root / "parent"
        parent.mkdir()
        git_env = os.environ.copy()
        git_env.update(
            {
                "GIT_AUTHOR_NAME": "CI",
                "GIT_AUTHOR_EMAIL": "ci@example.com",
                "GIT_COMMITTER_NAME": "CI",
                "GIT_COMMITTER_EMAIL": "ci@example.com",
                "GIT_TERMINAL_PROMPT": "0",
                # A file submodule URL is refused unless this process allows it.
                # The setting stays on this run; it is not written into Git config.
                "GIT_CONFIG_COUNT": "1",
                "GIT_CONFIG_KEY_0": "protocol.file.allow",
                "GIT_CONFIG_VALUE_0": "always",
            }
        )

        def git(*args: str) -> None:
            completed = subprocess.run(
                ["git", "-C", str(parent), *args],
                check=False,
                capture_output=True,
                text=True,
                timeout=60,
                env=git_env,
            )
            if completed.returncode != 0:
                raise AssertionError(
                    f"git {' '.join(args)} failed ({completed.returncode})\n"
                    f"{completed.stdout}\n{completed.stderr}"
                )

        git("init", "-q", "-b", "main")
        git("config", "user.name", "CI")
        git("config", "user.email", "ci@example.com")
        git("config", "protocol.file.allow", "always")
        git("config", "submodule.recurse", "false")
        git("config", "pull.recurseSubmodules", "false")
        (parent / ".gitmodules").write_text(
            f'[submodule "core"]\n\tpath = core\n\turl = {bare.as_uri()}\n',
            encoding="utf-8",
        )
        (parent / ".chezmoiroot").write_text("home\n", encoding="utf-8")
        (parent / "home").mkdir()
        git("add", ".gitmodules", ".chezmoiroot", "home")
        git("update-index", "--add", "--cacheinfo", f"160000,{old_core},core")
        git("commit", "-q", "-m", "old pin")
        old_commit = subprocess.check_output(
            ["git", "-C", str(parent), "rev-parse", "HEAD"], text=True, timeout=15
        ).strip()
        git("submodule", "update", "--init", "--", "core")
        self.assertFalse((parent / "core" / "browser" / "brave.json").exists())
        git("update-index", "--cacheinfo", f"160000,{new_core},core")
        git("commit", "-q", "-m", "new pin")
        new_commit = subprocess.check_output(
            ["git", "-C", str(parent), "rev-parse", "HEAD"], text=True, timeout=15
        ).strip()
        git("reset", "--hard", "-q", old_commit)
        self.assertFalse((parent / "core" / "browser" / "brave.json").exists())

        home = self.root / "update-home"
        bin_dir = home / ".local" / "bin"
        lib_dir = home / ".local" / "lib" / "groundwork"
        bin_dir.mkdir(parents=True)
        lib_dir.mkdir(parents=True)
        shutil.copy(REPO / "home/dot_local/lib/groundwork/update-lock.sh", lib_dir / "update-lock.sh")
        platform = bin_dir / "groundwork-platform"
        platform.write_text("#!/bin/sh\nprintf '%s\\n' darwin\n", encoding="utf-8")
        platform.chmod(0o755)
        launcher = self.root / "old-update-all"
        launcher.write_bytes(
            subprocess.check_output(
                ["git", "show", f"{main}:home/dot_local/bin/executable_update-all"],
                timeout=15,
            )
        )
        launcher.chmod(0o755)
        real_chezmoi = shutil.which("chezmoi") or str(Path.home() / ".local/bin/chezmoi")
        self.assertTrue(Path(real_chezmoi).is_file())
        helper = REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh"
        runner = self.root / "fresh-runner"
        runner.write_text(
            "#!/usr/bin/env bash\n"
            "set -euo pipefail\n"
            f"bash {helper} {parent}\n"
            "exec chezmoi apply\n",
            encoding="utf-8",
        )
        runner.chmod(0o755)
        status_log = self.root / "status-render"
        apply_log = self.root / "apply-render"
        data = json.dumps(
            {
                "password_manager": "bitwarden",
                "environment_role": "personal",
                "headless": False,
                "chezmoi": {"os": "darwin", "arch": "arm64"},
            }
        )
        chezmoi = bin_dir / "chezmoi"
        chezmoi.write_text(
            f"""#!/usr/bin/env bash
set -euo pipefail
printf '%s\\n' "$*" >> {self.root / "chezmoi-invocations"}
if [[ "${{1:-}}" == update ]]; then
  git -C {parent} merge --ff-only {new_commit}
  exit 0
fi
if [[ "${{1:-}}" == init ]]; then
  exit 0
fi
if [[ "${{1:-}}" == status ]]; then
  if [[ -f {parent}/core/browser/brave.json ]]; then
    echo "spec was present during chezmoi status" >&2
    exit 1
  fi
  {real_chezmoi} --config {self.root / "empty.toml"} --source {parent} \\
    --override-data {json.dumps(data)} execute-template < {HOOK} > {status_log}
  if grep -q 'Brave spec hash:' {status_log}; then
    echo "status render hashed a missing spec" >&2
    exit 1
  fi
  exit 0
fi
if [[ "${{1:-}}" == verify ]]; then
  exit 0
fi
if [[ "${{1:-}}" == apply && $# -eq 1 ]]; then
  test -f {parent}/core/browser/brave.json
  {real_chezmoi} --config {self.root / "empty.toml"} --source {parent} \\
    --override-data {json.dumps(data)} execute-template < {HOOK} > {apply_log}
  grep -q 'Brave spec hash:' {apply_log}
  exit 0
fi
if [[ "${{1:-}}" == apply ]]; then
  cp {runner} "$HOME/.local/bin/groundwork-update-run"
  chmod +x "$HOME/.local/bin/groundwork-update-run"
  exit 0
fi
echo "unexpected chezmoi invocation: $*" >&2
exit 1
""",
            encoding="utf-8",
        )
        chezmoi.chmod(0o755)
        (self.root / "empty.toml").write_text("", encoding="utf-8")
        environment = os.environ.copy()
        environment.update(
            {
                "HOME": str(home),
                "PATH": f"{bin_dir}:{environment.get('PATH', '')}",
                "GIT_TERMINAL_PROMPT": "0",
                "GIT_CONFIG_COUNT": "1",
                "GIT_CONFIG_KEY_0": "protocol.file.allow",
                "GIT_CONFIG_VALUE_0": "always",
                "GROUNDWORK_CORE_CHECKOUT_DEADLINE_SECONDS": "15",
            }
        )
        for key in ("XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"):
            environment.pop(key, None)
        result = subprocess.run(
            [str(launcher)],
            text=True,
            capture_output=True,
            timeout=60,
            check=False,
            env=environment,
        )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertTrue((parent / "core" / "browser" / "brave.json").is_file())
        apply_text = apply_log.read_text(encoding="utf-8")
        self.assertIn(
            hashlib.sha256((parent / "core" / "browser" / "brave.json").read_bytes()).hexdigest(),
            apply_text,
        )
        self.assertIn("submodule update --init -- core", helper.read_text(encoding="utf-8"))
        headed = subprocess.run(
            ["git", "-C", str(parent), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        self.assertEqual(headed, new_commit)
        core_after = subprocess.run(
            ["git", "-C", str(REPO / "core"), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        self.assertEqual(core_after, core_head)

        launcher_text = (REPO / "home/dot_local/bin/executable_update-all").read_text(encoding="utf-8")
        runner_text = (REPO / "home/dot_local/bin/executable_groundwork-update-run.tmpl").read_text(encoding="utf-8")
        bootstrap_text = (REPO / "bootstrap-mac.sh").read_text(encoding="utf-8")
        self.assertLess(
            launcher_text.find("checkout-core.sh"),
            launcher_text.find('status_output="$(chezmoi status)"'),
        )
        scope_at = runner_text.find("export GROUNDWORK_UPDATE_SCOPE=maintenance")
        self.assertLess(
            runner_text.find("checkout-core.sh", scope_at),
            runner_text.find("\nchezmoi apply\n", scope_at),
        )
        self.assertLess(
            bootstrap_text.find("checkout-core.sh"),
            bootstrap_text.find('chezmoi --source "$groundwork_dir" init --apply'),
        )


if __name__ == "__main__":
    unittest.main()
