    def test_malformed_profiles_output_is_unknown(self):
        self.profiles.write_text("this is not xml\n", encoding="utf-8")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        doctor = self.run_brave("--doctor", env=environment)
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn("could not be read", doctor.stdout)
        self.assertIn("could not be read", doctor.stderr)
        self.assertNotIn("Brave policy profile is not installed", doctor.stdout)
        self.assertNotIn("Traceback", doctor.stdout)
        self.assertNotIn("Traceback", doctor.stderr)
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n", encoding="utf-8")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        result = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIsNone(self.choice("policy-open"))
        self.assertNotIn("Traceback", result.stderr)
        truncated = '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0">\n<dict>\n'
        matched = subprocess.run(
            ["python3", str(LIB), "payload-matches"],
            input=truncated,
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(matched.returncode, 2, matched.stderr)
        self.assertIn("could not be read", matched.stderr)
        self.assertNotIn("Traceback", matched.stderr)

    def test_empty_profile_plist_with_status_line_is_not_installed(self):
        document = plistlib.dumps({}, fmt=plistlib.FMT_XML).decode("utf-8")
        self.write_profiles_stdout(document, "There are no configuration profiles installed")
        doctor = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn(
            "Brave policy profile is not installed. The next interactive apply will offer it again.",
            doctor.stdout,
        )
        self.assertNotIn("profiles is not available", doctor.stdout)
        self.assertNotIn("profiles returned nothing", doctor.stdout)
        self.assertNotIn("Traceback", doctor.stdout)
        self.assertNotIn("Traceback", doctor.stderr)

    def test_config_only_update_prints_the_brave_notice(self):
        runner = (REPO / "home/dot_local/bin/executable_groundwork-update-run.tmpl").read_text(encoding="utf-8")
        apply_at = runner.find("\nchezmoi apply\n")
        config_at = runner.find("append_maintenance_receipt configuration applied")
        self.assertGreater(apply_at, 0)
        self.assertGreater(config_at, apply_at)
        block = runner[config_at : runner.find("\n  exit 0\n", config_at)]
        self.assertIn('"$HOME/.local/bin/groundwork-brave-browser" --notice', block)
        self.assertIn('eq .chezmoi.os "darwin"', block)
        self.assertLess(block.find("--notice"), block.find('echo "Groundwork configuration applied'))

    def test_noninteractive_profile_change_does_not_save_a_decline(self):
        self.write_installed_profile({})
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n")
        self.seed("policy-open", "accepted")
        environment = self.env(
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
            INSTALLED_CASKS="brave-browser",
        )
        result = self.run_brave("--apply", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("The Brave policy profile changed.", result.stdout)
        self.assertIsNone(self.choice("policy-open"))
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertIn("The Brave policy profile changed.", notice.stdout)
        doctor = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn("does not match the current Groundwork spec", doctor.stdout)
        self.assertNotIn("ok    Brave policy profile is installed", doctor.stdout)

    def test_update_scope_profile_change_stays_quiet(self):
        self.write_installed_profile({})
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n")
        result = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(
                GROUNDWORK_UPDATE_SCOPE="maintenance",
                INSTALLED_CASKS="brave-browser",
            ),
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")
        self.assertIsNone(self.choice("policy-open"))
        self.assertNotIn("old profile", (self.share / "Brave-Browser.mobileconfig").read_text())
        self.assertNotIn("set browser", self.log("defaultbrowser"))
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        follow = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(INSTALLED_CASKS="brave-browser"),
        )
        self.assertEqual(follow.returncode, 0, follow.stderr)
        profile_path = self.share / "Brave-Browser.mobileconfig"
        self.assertIn(str(profile_path), self.log("open"))
        self.assertIsNone(self.choice("policy-open"))
        previous = hashlib.sha256(b"old profile\n").hexdigest()
        self.assertEqual(self.choice("policy-render"), previous)
        self.assertNotEqual(previous, hashlib.sha256(profile_path.read_bytes()).hexdigest())

    def test_failed_adoption_is_not_saved(self):
