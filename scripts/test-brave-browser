    def test_browser_extensions_reads_the_spec(self):
        environment = self.env()
        listed = subprocess.run(
            ["bash", str(EXTENSIONS)],
            text=True,
            capture_output=True,
            env=environment,
            timeout=15,
            check=False,
        )
        self.assertEqual(listed.returncode, 0, listed.stderr)
        self.assertIn("brave", listed.stdout)
        self.assertIn(self.spec["extensions"][0]["id"], listed.stdout)
        rejected = subprocess.run(
            ["bash", str(EXTENSIONS), "--browser", "chrome"],
            text=True,
            capture_output=True,
            env=environment,
            timeout=15,
            check=False,
        )
        self.assertEqual(rejected.returncode, 2)

    def test_hook_renders_apply_on_desktop_and_exit_on_headless(self):
        chezmoi = shutil.which("chezmoi") or str(Path.home() / ".local/bin/chezmoi")
        self.assertTrue(Path(chezmoi).is_file(), "chezmoi is required to render the Brave hook")
        config = self.root / "empty.toml"
        config.write_text("")

        def render(os_name: str, headless: bool) -> str:
            data = {
                "name": "CI User",
                "email_personal": "ci@example.com",
                "email_work": "",
                "code_dir": "~/code",
                "reset_existing_configs": False,
                "password_manager": "bitwarden",
                "signingkey": "",
                "obsidian_vault_name": "ci",
                "game_dev": False,
                "profile_preset": "personal-current",
                "environment_role": "personal",
                "release_posture": "current",
                "headless": headless,
                "work": False,
                "xcode": False,
                "beta": False,
                "chezmoi": {"os": os_name, "arch": "arm64"},
            }
            result = subprocess.run(
                [
                    chezmoi,
                    "--config",
                    str(config),
                    "--source",
                    str(REPO),
                    "--override-data",
                    json.dumps(data),
                    "execute-template",
                ],
                input=HOOK.read_text(encoding="utf-8"),
                text=True,
                capture_output=True,
                timeout=20,
                check=False,
            )
            self.assertEqual(result.returncode, 0, result.stderr)
            return result.stdout

        desktop = render("darwin", False)
        self.assertIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', desktop)
        self.assertIn("Brave spec hash:", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_SPEC=", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_PASSWORD_MANAGER=", desktop)
        self.assertIn("export GROUNDWORK_BRAVE_HEADLESS=false", desktop)
        self.assertIn("checkout-core.sh", desktop)
        self.assertIn("submodule update --init -- core", (REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh").read_text(encoding="utf-8"))
        for line in desktop.splitlines():
            stripped = line.strip()
            self.assertFalse(stripped.startswith("chezmoi"))
            self.assertNotIn("$(chezmoi", line)
            self.assertNotIn("`chezmoi", line)
        headless = render("darwin", True)
        self.assertNotIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', headless)
        self.assertNotIn("Brave spec hash:", headless)
        self.assertNotIn("checkout-core.sh", headless)
        self.assertIn("exit 0", headless)
        linux = render("linux", False)
        self.assertNotIn('exec "$HOME/.local/bin/groundwork-brave-browser" --apply', linux)
        self.assertNotIn("Brave spec hash:", linux)
        self.assertNotIn("checkout-core.sh", linux)
        self.assertIn("exit 0", linux)
        for script in (desktop, headless, linux):
            syntax = subprocess.run(
                ["bash", "-n"],
                input=script,
                text=True,
                capture_output=True,
                timeout=15,
                check=False,
            )
            self.assertEqual(syntax.returncode, 0, syntax.stderr + script)
            self.assertTrue(script.startswith("#!/usr/bin/env bash\n"))

        missing = self.root / "spec-missing"
        (missing / "home").mkdir(parents=True)
        (missing / ".chezmoiroot").write_text("home\n")
        missing_template = HOOK.read_text(encoding="utf-8")

        def render_missing(
            os_name: str, headless_value: bool, *, include_role: bool = True
        ) -> subprocess.CompletedProcess[str]:
            data = {
                "name": "CI User",
                "email_personal": "ci@example.com",
                "email_work": "",
                "code_dir": "~/code",
                "reset_existing_configs": False,
                "password_manager": "bitwarden",
                "signingkey": "",
                "obsidian_vault_name": "ci",
                "game_dev": False,
                "profile_preset": "personal-current",
                "release_posture": "current",
                "headless": headless_value,
                "work": False,
                "xcode": False,
                "beta": False,
                "chezmoi": {"os": os_name, "arch": "arm64"},
            }
            if include_role:
                data["environment_role"] = "personal"
            return subprocess.run(
                [
                    chezmoi,
                    "--config",
                    str(config),
                    "--source",
                    str(missing),
                    "--override-data",
                    json.dumps(data),
                    "execute-template",
                ],
                input=missing_template,
                text=True,
                capture_output=True,
                timeout=20,
                check=False,
            )

        linux_missing = render_missing("linux", True)
        self.assertEqual(linux_missing.returncode, 0, linux_missing.stderr)
        self.assertIn("exit 0", linux_missing.stdout)
        self.assertNotIn("brave.json", linux_missing.stderr)
        self.assertNotIn("checkout-core.sh", linux_missing.stdout)
        darwin_missing = render_missing("darwin", False)
        self.assertEqual(darwin_missing.returncode, 0, darwin_missing.stderr)
        self.assertNotIn("brave.json", darwin_missing.stderr)
        self.assertNotIn("cat:", darwin_missing.stderr)
        self.assertNotIn("Brave spec hash:", darwin_missing.stdout)
        self.assertIn("checkout-core.sh", darwin_missing.stdout)
        self.assertIn("so Brave was not offered.", darwin_missing.stdout)
        self.assertIn("export GROUNDWORK_BRAVE_SPEC=", darwin_missing.stdout)
        darwin_headless_missing = render_missing("darwin", True)
        self.assertEqual(darwin_headless_missing.returncode, 0, darwin_headless_missing.stderr)
        self.assertIn("exit 0", darwin_headless_missing.stdout)
        self.assertNotIn("brave.json", darwin_headless_missing.stderr)
        self.assertNotIn("checkout-core.sh", darwin_headless_missing.stdout)
        # The container config has password_manager and headless only.
        # Headless apply must still succeed.
        linux_container = render_missing("linux", True, include_role=False)
        self.assertEqual(linux_container.returncode, 0, linux_container.stderr)
        self.assertIn("exit 0", linux_container.stdout)
        darwin_container = render_missing("darwin", True, include_role=False)
        self.assertEqual(darwin_container.returncode, 0, darwin_container.stderr)
        self.assertIn("exit 0", darwin_container.stdout)
        for rendered in (linux_container, darwin_container):
            self.assertNotIn("checkout-core.sh", rendered.stdout)
            syntax = subprocess.run(
                ["bash", "-n"],
                input=rendered.stdout,
                text=True,
                capture_output=True,
                timeout=15,
                check=False,
            )
            self.assertEqual(syntax.returncode, 0, syntax.stderr + rendered.stdout)
        spec_dest = missing / "core" / "browser"
        spec_dest.mkdir(parents=True)
        shutil.copy(SPEC, spec_dest / "brave.json")
        followed = render_missing("darwin", False)
        self.assertEqual(followed.returncode, 0, followed.stderr)
        self.assertIn("Brave spec hash:", followed.stdout)
        self.assertIn(hashlib.sha256(SPEC.read_bytes()).hexdigest(), followed.stdout)

    def test_apply_reads_spec_from_working_tree_without_calling_chezmoi(self):
        installed = self.root / "installed"
        bin_dir = installed / ".local/bin"
        lib_dir = installed / ".local/share/groundwork/lib"
        bin_dir.mkdir(parents=True)
        lib_dir.mkdir(parents=True)
        shutil.copy(BRAVE, bin_dir / "groundwork-brave-browser")
        shutil.copy(LIB, lib_dir / "brave_browser.py")
        work = self.root / "work"
        spec_dir = work / "core/browser"
        spec_dir.mkdir(parents=True)
        (spec_dir / "brave.json").symlink_to(SPEC)
        chezmoi = self.bin / "chezmoi"
        chezmoi.write_text(
            "#!/bin/sh\n"
            f"printf '%s\\n' \"$*\" >> {self.logs / 'chezmoi'}\n"
            "exit 1\n"
        )
        chezmoi.chmod(0o755)
        environment = self.env(
            INSTALLED_CASKS="brave-browser",
            GROUNDWORK_BRAVE_NONINTERACTIVE="1",
        )
        environment.pop("GROUNDWORK_BRAVE_SPEC")
        environment["CHEZMOI_WORKING_TREE"] = str(work)
        environment["PATH"] = f"{self.bin}:{environment['PATH']}"
        result = subprocess.run(
            ["bash", str(bin_dir / "groundwork-brave-browser"), "--apply"],
            text=True,
            capture_output=True,
            env=environment,
            timeout=20,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        profile = self.share / "Brave-Browser.mobileconfig"
        self.assertTrue(profile.is_file())
        self.assertIn("PasswordManagerEnabled", profile.read_text(encoding="utf-8"))
        self.assertEqual(self.log("chezmoi"), "")

    def test_open_without_an_installed_profile_is_offered_again(self):
        self.seed("policy-open", "accepted")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        first = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertIn("Brave-Browser.mobileconfig", self.log("open"))
        self.assertIsNone(self.choice("policy-open"))
        (self.logs / "open").unlink()
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertIn("Approve the Brave policy profile", notice.stdout)
        doctor = self.run_brave("--doctor", env=environment)
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn(
            "Brave policy profile is not installed. The next interactive apply will offer it again.",
            doctor.stdout,
        )
        second = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertIn("Brave-Browser.mobileconfig", self.log("open"))
        self.assertIsNone(self.choice("policy-open"))

    def test_missing_profile_keeps_a_decline(self):
        self.seed("policy-open", "declined")
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(INSTALLED_CASKS="brave-browser")
        result = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.log("open"), "")
        self.assertEqual(self.choice("policy-open"), "declined")
        notice = self.run_brave("--notice", env=environment)
        self.assertEqual(notice.returncode, 0, notice.stderr)
        self.assertNotIn("Approve the Brave policy profile", notice.stdout)
        self.assertNotIn("An interactive apply writes", notice.stdout)

    def _chezmoi_data(self, payload: str) -> None:
        data_path = self.root / "chezmoi-data.json"
        data_path.write_text(payload, encoding="utf-8")
        script = self.bin / "chezmoi"
        script.write_text(
            "#!/bin/sh\n"
            'if [ "$1" = data ]; then\n'
            f"  cat {data_path}\n"
            "  exit 0\n"
            "fi\n"
            "exit 1\n"
        )
        script.chmod(0o755)

    def _env_without_profile(self) -> dict[str, str]:
        environment = self.env(INSTALLED_CASKS="brave-browser", GROUNDWORK_BRAVE_NONINTERACTIVE="1")
        for key in (
            "GROUNDWORK_BRAVE_PASSWORD_MANAGER",
            "GROUNDWORK_BRAVE_HEADLESS",
        ):
            environment.pop(key, None)
        environment["PATH"] = f"{self.bin}:{environment['PATH']}"
        return environment

    def test_direct_run_without_profile_data_writes_nothing(self):
        script = self.bin / "chezmoi"
        script.write_text("#!/bin/sh\nexit 1\n")
        script.chmod(0o755)
        result = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertIn("profile data is missing", result.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

        self._chezmoi_data('{"headless":false}')
        incomplete = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(incomplete.returncode, 1, incomplete.stderr)
        self.assertIn("profile data is incomplete", incomplete.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

        self._chezmoi_data("[]")
        not_object = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(not_object.returncode, 1, not_object.stderr)
        self.assertFalse((self.share / "Brave-Browser.mobileconfig").exists())

    def test_direct_run_reads_a_complete_profile_without_defaults(self):
        self._chezmoi_data(
            '{"password_manager":"bitwarden","headless":false}'
        )
        result = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(result.returncode, 0, result.stderr)
        profile = (self.share / "Brave-Browser.mobileconfig").read_text(encoding="utf-8")
        self.assertIn("PasswordManagerEnabled", profile)

        self._chezmoi_data(
            '{"password_manager":"bitwarden","headless":true}'
        )
        profile_path = self.share / "Brave-Browser.mobileconfig"
        profile_path.unlink()
        headless = self.run_brave("--apply", env=self._env_without_profile())
        self.assertEqual(headless.returncode, 0, headless.stderr)
        self.assertFalse(profile_path.exists())

    def test_checkout_core_rejects_bad_arguments_before_git(self):
        helper = REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh"
        text = helper.read_text(encoding="utf-8")
        self.assertIn("submodule update --init -- core", text)
        self.assertNotRegex(text, r"submodule update[^\n]*--remote")
        missing_args = subprocess.run(
            ["bash", str(helper)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(missing_args.returncode, 64, missing_args.stderr)
        empty = self.root / "not-a-checkout"
        empty.mkdir()
        skipped = subprocess.run(
            ["bash", str(helper), str(empty)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
        self.assertEqual(skipped.returncode, 0, skipped.stderr)
        repo = self.root / "deadline-repo"
        repo.mkdir()
        subprocess.run(["git", "init", "-q", str(repo)], check=True, timeout=15)
        (repo / ".gitmodules").write_text(
            '[submodule "core"]\n\tpath = core\n\turl = file:///nowhere\n',
            encoding="utf-8",
        )
        bad_deadline = subprocess.run(
            ["bash", str(helper), str(repo)],
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
            env={**os.environ, "GROUNDWORK_CORE_CHECKOUT_DEADLINE_SECONDS": "0", "GIT_TERMINAL_PROMPT": "0"},
        )
        self.assertEqual(bad_deadline.returncode, 64, bad_deadline.stderr)
        self.assertIn("deadline", bad_deadline.stderr)
        checkout = subprocess.run(
            ["bash", str(helper), str(REPO)],
            text=True,
            capture_output=True,
            timeout=30,
            check=False,
        )
        self.assertEqual(checkout.returncode, 0, checkout.stderr)
        self.assertEqual(checkout.stdout, "")

    def test_old_update_all_checks_out_core_before_the_spec_is_read(self):
        # Protects the first update after this merge. The installed update-all
        # is still main's launcher, and chezmoi status must render the desktop
        # hook while core/browser/brave.json is absent. The new runner then
        # checks out the pinned core, and the following render hashes the spec.
        # The old and new core commits are built here. CI checks out only the
        # pinned submodule commit, so the previous pin is not an object this
        # test can pack out of core/.
        main = "78b4e2509d684f41022d63ee7999e68c9bc7dcd9"
        spec_bytes = SPEC.read_bytes()
        self.assertGreater(len(spec_bytes), 0)
        core_head = subprocess.run(
            ["git", "-C", str(REPO / "core"), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        git_env = os.environ.copy()
        git_env.update(
            {
                "GIT_AUTHOR_NAME": "CI",
                "GIT_AUTHOR_EMAIL": "ci@example.com",
                "GIT_COMMITTER_NAME": "CI",
                "GIT_COMMITTER_EMAIL": "ci@example.com",
                "GIT_TERMINAL_PROMPT": "0",
                # A file submodule URL is refused unless this process allows it.
                # The setting stays on this run; it is not written into Git config.
                "GIT_CONFIG_COUNT": "1",
                "GIT_CONFIG_KEY_0": "protocol.file.allow",
                "GIT_CONFIG_VALUE_0": "always",
            }
        )

        def git_at(repo: Path, *args: str) -> str:
            completed = subprocess.run(
                ["git", "-C", str(repo), *args],
                check=False,
                capture_output=True,
                text=True,
                timeout=60,
                env=git_env,
            )
            if completed.returncode != 0:
                raise AssertionError(
                    f"git -C {repo} {' '.join(args)} failed ({completed.returncode})\n"
                    f"{completed.stdout}\n{completed.stderr}"
                )
            return completed.stdout.strip()

        synthetic = self.root / "synthetic-core"
        synthetic.mkdir()
        git_at(synthetic, "init", "-q", "-b", "main")
        git_at(synthetic, "config", "user.name", "CI")
        git_at(synthetic, "config", "user.email", "ci@example.com")
        (synthetic / "README").write_text("old core has no browser spec\n", encoding="utf-8")
        git_at(synthetic, "add", "README")
        git_at(synthetic, "commit", "-q", "-m", "old core")
        old_core = git_at(synthetic, "rev-parse", "HEAD")
        old_names = git_at(synthetic, "ls-tree", "-r", "--name-only", old_core)
        self.assertNotIn("browser/brave.json", old_names.splitlines())
        (synthetic / "browser").mkdir()
        (synthetic / "browser" / "brave.json").write_bytes(spec_bytes)
        git_at(synthetic, "add", "browser/brave.json")
        git_at(synthetic, "commit", "-q", "-m", "new core")
        new_core = git_at(synthetic, "rev-parse", "HEAD")
        self.assertNotEqual(old_core, new_core)
        self.assertIn(
            "browser/brave.json",
            git_at(synthetic, "ls-tree", "-r", "--name-only", new_core).splitlines(),
        )
        bare = self.root / "core.git"
        cloned = subprocess.run(
            ["git", "clone", "--bare", "-q", str(synthetic), str(bare)],
            check=False,
            capture_output=True,
            text=True,
            timeout=60,
            env=git_env,
        )
        if cloned.returncode != 0:
            raise AssertionError(f"bare clone failed ({cloned.returncode})\n{cloned.stdout}\n{cloned.stderr}")
        parent = self.root / "parent"
        parent.mkdir()

        def git(*args: str) -> None:
            completed = subprocess.run(
                ["git", "-C", str(parent), *args],
                check=False,
                capture_output=True,
                text=True,
                timeout=60,
                env=git_env,
            )
            if completed.returncode != 0:
                raise AssertionError(
                    f"git {' '.join(args)} failed ({completed.returncode})\n"
                    f"{completed.stdout}\n{completed.stderr}"
                )

        git("init", "-q", "-b", "main")
        git("config", "user.name", "CI")
        git("config", "user.email", "ci@example.com")
        git("config", "protocol.file.allow", "always")
        git("config", "submodule.recurse", "false")
        git("config", "pull.recurseSubmodules", "false")
        (parent / ".gitmodules").write_text(
            f'[submodule "core"]\n\tpath = core\n\turl = {bare.as_uri()}\n',
            encoding="utf-8",
        )
        (parent / ".chezmoiroot").write_text("home\n", encoding="utf-8")
        (parent / "home").mkdir()
        git("add", ".gitmodules", ".chezmoiroot", "home")
        git("update-index", "--add", "--cacheinfo", f"160000,{old_core},core")
        git("commit", "-q", "-m", "old pin")
        old_commit = subprocess.check_output(
            ["git", "-C", str(parent), "rev-parse", "HEAD"], text=True, timeout=15
        ).strip()
        git("submodule", "update", "--init", "--", "core")
        self.assertFalse((parent / "core" / "browser" / "brave.json").exists())
        git("update-index", "--cacheinfo", f"160000,{new_core},core")
        git("commit", "-q", "-m", "new pin")
        new_commit = subprocess.check_output(
            ["git", "-C", str(parent), "rev-parse", "HEAD"], text=True, timeout=15
        ).strip()
        git("reset", "--hard", "-q", old_commit)
        self.assertFalse((parent / "core" / "browser" / "brave.json").exists())

        home = self.root / "update-home"
        bin_dir = home / ".local" / "bin"
        lib_dir = home / ".local" / "lib" / "groundwork"
        bin_dir.mkdir(parents=True)
        lib_dir.mkdir(parents=True)
        shutil.copy(REPO / "home/dot_local/lib/groundwork/update-lock.sh", lib_dir / "update-lock.sh")
        platform = bin_dir / "groundwork-platform"
        platform.write_text("#!/bin/sh\nprintf '%s\\n' darwin\n", encoding="utf-8")
        platform.chmod(0o755)
        launcher = self.root / "old-update-all"
        launcher.write_bytes(
            subprocess.check_output(
                ["git", "show", f"{main}:home/dot_local/bin/executable_update-all"],
                timeout=15,
            )
        )
        launcher.chmod(0o755)
        real_chezmoi = shutil.which("chezmoi") or str(Path.home() / ".local/bin/chezmoi")
        self.assertTrue(Path(real_chezmoi).is_file())
        helper = REPO / "home/dot_local/share/groundwork/lib/checkout-core.sh"
        runner = self.root / "fresh-runner"
        runner.write_text(
            "#!/usr/bin/env bash\n"
            "set -euo pipefail\n"
            f"bash {helper} {parent}\n"
            "exec chezmoi apply\n",
            encoding="utf-8",
        )
        runner.chmod(0o755)
        status_log = self.root / "status-render"
        apply_log = self.root / "apply-render"
        data = json.dumps(
            {
                "password_manager": "bitwarden",
                "environment_role": "personal",
                "headless": False,
                "chezmoi": {"os": "darwin", "arch": "arm64"},
            }
        )
        chezmoi = bin_dir / "chezmoi"
        chezmoi.write_text(
            f"""#!/usr/bin/env bash
set -euo pipefail
printf '%s\\n' "$*" >> {self.root / "chezmoi-invocations"}
if [[ "${{1:-}}" == update ]]; then
  git -C {parent} merge --ff-only {new_commit}
  exit 0
fi
if [[ "${{1:-}}" == init ]]; then
  exit 0
fi
if [[ "${{1:-}}" == status ]]; then
  if [[ -f {parent}/core/browser/brave.json ]]; then
    echo "spec was present during chezmoi status" >&2
    exit 1
  fi
  {real_chezmoi} --config {self.root / "empty.toml"} --source {parent} \\
    --override-data {json.dumps(data)} execute-template < {HOOK} > {status_log}
  if grep -q 'Brave spec hash:' {status_log}; then
    echo "status render hashed a missing spec" >&2
    exit 1
  fi
  exit 0
fi
if [[ "${{1:-}}" == verify ]]; then
  exit 0
fi
if [[ "${{1:-}}" == apply && $# -eq 1 ]]; then
  test -f {parent}/core/browser/brave.json
  {real_chezmoi} --config {self.root / "empty.toml"} --source {parent} \\
    --override-data {json.dumps(data)} execute-template < {HOOK} > {apply_log}
  grep -q 'Brave spec hash:' {apply_log}
  exit 0
fi
if [[ "${{1:-}}" == apply ]]; then
  cp {runner} "$HOME/.local/bin/groundwork-update-run"
  chmod +x "$HOME/.local/bin/groundwork-update-run"
  exit 0
fi
echo "unexpected chezmoi invocation: $*" >&2
exit 1
""",
            encoding="utf-8",
        )
        chezmoi.chmod(0o755)
        (self.root / "empty.toml").write_text("", encoding="utf-8")
        environment = os.environ.copy()
        environment.update(
            {
                "HOME": str(home),
                "PATH": f"{bin_dir}:{environment.get('PATH', '')}",
                "GIT_TERMINAL_PROMPT": "0",
                "GIT_CONFIG_COUNT": "1",
                "GIT_CONFIG_KEY_0": "protocol.file.allow",
                "GIT_CONFIG_VALUE_0": "always",
                "GROUNDWORK_CORE_CHECKOUT_DEADLINE_SECONDS": "15",
            }
        )
        for key in ("XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"):
            environment.pop(key, None)
        result = subprocess.run(
            [str(launcher)],
            text=True,
            capture_output=True,
            timeout=60,
            check=False,
            env=environment,
        )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        checked_out = parent / "core" / "browser" / "brave.json"
        self.assertTrue(checked_out.is_file())
        self.assertEqual(checked_out.read_bytes(), spec_bytes)
        apply_text = apply_log.read_text(encoding="utf-8")
        self.assertIn(hashlib.sha256(spec_bytes).hexdigest(), apply_text)
        self.assertIn("submodule update --init -- core", helper.read_text(encoding="utf-8"))
        headed = subprocess.run(
            ["git", "-C", str(parent), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        self.assertEqual(headed, new_commit)
        core_after = subprocess.run(
            ["git", "-C", str(REPO / "core"), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=True,
            timeout=15,
        ).stdout.strip()
        self.assertEqual(core_after, core_head)

        launcher_text = (REPO / "home/dot_local/bin/executable_update-all").read_text(encoding="utf-8")
        runner_text = (REPO / "home/dot_local/bin/executable_groundwork-update-run.tmpl").read_text(encoding="utf-8")
        bootstrap_text = (REPO / "bootstrap-mac.sh").read_text(encoding="utf-8")
        self.assertLess(
            launcher_text.find("checkout-core.sh"),
            launcher_text.find('status_output="$(chezmoi status)"'),
        )
        scope_at = runner_text.find("export GROUNDWORK_UPDATE_SCOPE=maintenance")
        self.assertLess(
            runner_text.find("checkout-core.sh", scope_at),
            runner_text.find("\nchezmoi apply\n", scope_at),
        )
        self.assertLess(
            bootstrap_text.find("checkout-core.sh"),
            bootstrap_text.find('chezmoi --source "$groundwork_dir" init --apply'),
        )


if __name__ == "__main__":
    unittest.main()
