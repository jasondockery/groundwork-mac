    def test_stale_superset_payload_is_not_accepted(self):
        bitwarden = self.render_python("bitwarden")
        none_render = self.render_python("none")
        self.assertEqual(bitwarden.returncode, 0, bitwarden.stderr)
        self.assertEqual(none_render.returncode, 0, none_render.stderr)
        installed = self.policies_from_mobileconfig(bitwarden.stdout)
        current = self.policies_from_mobileconfig(none_render.stdout)
        self.assertIn("PasswordManagerEnabled", installed)
        self.assertNotIn("PasswordManagerEnabled", current)
        self.assertTrue(set(current.items()).issubset(installed.items()))
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n", encoding="utf-8")
        self.write_installed_profile(installed)
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        environment = self.env(
            INSTALLED_CASKS="brave-browser",
            GROUNDWORK_BRAVE_PASSWORD_MANAGER="none",
        )
        result = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(result.returncode, 0, result.stderr)
        profile_path = self.share / "Brave-Browser.mobileconfig"
        self.assertNotIn("PasswordManagerEnabled", profile_path.read_text(encoding="utf-8"))
        self.assertIn(str(profile_path), self.log("open"))
        self.assertIsNone(self.choice("policy-open"))
        doctor = self.run_brave("--doctor", env=environment)
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertNotIn("ok    Brave policy profile is installed", doctor.stdout)
        self.assertIn("does not match the current Groundwork spec", doctor.stdout)
        (self.logs / "open").unlink()
        again = self.run_brave("--apply", answers="y\n", env=environment)
        self.assertEqual(again.returncode, 0, again.stderr)
        self.assertIn(str(profile_path), self.log("open"))
        self.assertIsNone(self.choice("policy-open"))

    def test_other_profiles_do_not_change_an_exact_match(self):
        rendered = self.render_python("bitwarden")
        self.assertEqual(rendered.returncode, 0, rendered.stderr)
        policies = self.policies_from_mobileconfig(rendered.stdout)
        self.share.mkdir()
        (self.share / "Brave-Browser.mobileconfig").write_text("old profile\n", encoding="utf-8")
        document = self.write_installed_profile(
            policies,
            others=[
                ("com.example.airdrop-on", {"DisableAirDrop": True}),
                ("com.example.airdrop-off", {"DisableAirDrop": False}),
            ],
        )
        self.assertIn("<string>com.example.airdrop-on</string>", document)
        self.assertIn("<string>com.example.airdrop-off</string>", document)
        self.seed("extension-offer", "declined")
        self.seed("default-browser", "declined")
        result = self.run_brave(
            "--apply",
            answers="y\n",
            env=self.env(INSTALLED_CASKS="brave-browser"),
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.choice("policy-open"), "accepted")
        doctor = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn("ok    Brave policy profile is installed", doctor.stdout)

    def test_empty_profiles_output_is_not_a_missing_command(self):
        self.profiles.write_text("", encoding="utf-8")
        doctor = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(doctor.returncode, 0, doctor.stderr)
        self.assertIn("profiles returned nothing", doctor.stdout)
        self.assertNotIn("profiles is not available", doctor.stdout)
        self.profiles.unlink()
        missing = self.run_brave("--doctor", env=self.env(INSTALLED_CASKS="brave-browser"))
        self.assertEqual(missing.returncode, 0, missing.stderr)
        self.assertIn("profiles is not available", missing.stdout)
        self.assertNotIn("profiles returned nothing", missing.stdout)

