#!/usr/bin/env bash
# Foreground Mac App Store authorization deadline.
#
# The watchdog lives in the update runner, not in maintenance-runner.sh. It
# uses the same whole-second date +%s rule: a 1s bound must not end at
# start+1. A real hang still returns 124.
#
# Bash 3.2+ (Apple Bash at bootstrap). Run: /bin/bash scripts/test-mas-auth-deadline
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd)"
template="$self_dir/../home/dot_local/bin/executable_groundwork-update-run.tmpl"
root="$(mktemp -d "${TMPDIR:-/tmp}/mas-auth-deadline.XXXXXX")"
owned_pid_file=""
cleanup() {
  local pid
  if [[ -n "$owned_pid_file" && -f "$owned_pid_file" ]]; then
    pid="$(cat "$owned_pid_file" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -rf -- "$root"
}
trap cleanup EXIT

extract_function() {
  awk '
    /^  run_foreground_mas_authorization\(\) \{/ { capture = 1 }
    capture && /^  select_mas_installed_items\(\)/ { exit }
    capture { sub(/^  /, ""); print }
  ' "$template" >"$root/function.sh"
  grep -q 'run_foreground_mas_authorization()' "$root/function.sh"
  grep -F 'started + seconds' "$root/function.sh" | grep -F -- '-gt' >/dev/null \
    || {
      echo "mas auth watchdog does not use the strict whole-second comparison" >&2
      exit 1
    }
  if grep -F 'started + seconds' "$root/function.sh" | grep -F -- '-ge' >/dev/null; then
    echo "mas auth watchdog still expires on the whole-second boundary" >&2
    exit 1
  fi
  if ! grep -F -- '-ne 0' "$root/function.sh" | grep -F 'deadline_file' >/dev/null; then
    echo "mas auth watchdog treats a zero sudo exit as a timeout" >&2
    exit 1
  fi
}

write_helpers() {
  local date_mode="$1" sudo_mode="$2"
  cat >"$root/bin/date" <<'SH'
#!/usr/bin/env bash
set -eu
if [[ "${1:-}" != "+%s" ]]; then
  echo "fixture date: unsupported arguments: $*" >&2
  exit 64
fi
receipt="${MAS_AUTH_RECEIPT:?}"
mode="${MAS_AUTH_DATE_MODE:?}"
base=1700000000
stamp="$receipt/date.count"
count=0
if [[ -f "$stamp" ]]; then
  count="$(cat "$stamp")"
fi
count=$((count + 1))
printf '%s\n' "$count" >"$stamp"
if [[ "$count" -eq 1 ]]; then
  printf '%s\n' "$base"
  exit 0
fi
ready=0
for candidate in "$receipt"/mas-auth-pid.*; do
  [[ -e "$candidate" ]] || continue
  case "$candidate" in
    *.deadline | *.done) continue ;;
  esac
  if [[ -s "$candidate" ]]; then
    ready=1
  fi
done
if [[ "$ready" -eq 0 ]]; then
  printf '%s\n' "$base"
  exit 0
fi
case "$mode" in
  boundary) printf '%s\n' "$((base + 1))" ;;
  expired) printf '%s\n' "$((base + 10))" ;;
  *) echo "fixture date: unknown mode" >&2; exit 64 ;;
esac
SH
  cat >"$root/bin/sudo" <<'SH'
#!/usr/bin/env bash
set -eu
mode="${MAS_AUTH_SUDO_MODE:?}"
owned="${MAS_AUTH_OWNED:?}"
case "${1:-}" in
  -v) ;;
  *) echo "fixture sudo: unexpected arguments: $*" >&2; exit 64 ;;
esac
if [[ "$mode" == hang ]]; then
  sleep 30 &
  printf '%s\n' "$!" >"$owned"
  wait || true
  exit 0
fi
sleep 0.4
exit 0
SH
  chmod +x "$root/bin/date" "$root/bin/sudo"
  printf '%s\n' "$date_mode" >"$root/date-mode"
  printf '%s\n' "$sudo_mode" >"$root/sudo-mode"
}

run_case() {
  local name="$1" date_mode="$2" sudo_mode="$3" expected="$4"
  local status=0
  rm -rf -- "$root/receipt" "$root/owned-pid"
  mkdir -p "$root/receipt" "$root/bin"
  : >"$root/term.out"
  owned_pid_file="$root/owned-pid"
  write_helpers "$date_mode" "$sudo_mode"
  MAS_AUTH_RECEIPT="$root/receipt" \
    MAS_AUTH_DATE_MODE="$date_mode" \
    MAS_AUTH_SUDO_MODE="$sudo_mode" \
    MAS_AUTH_OWNED="$root/owned-pid" \
    PATH="$root/bin:/usr/bin:/bin" \
    runner_receipt_dir="$root/receipt" \
    mas_auth_kill_grace=0.1 \
    /bin/bash -c '
      set -euo pipefail
      source "$1"
      exec 6>"$2" 7</dev/null
      run_foreground_mas_authorization "fixture authorization" 1
    ' _ "$root/function.sh" "$root/term.out" || status=$?
  if [[ "$status" -ne "$expected" ]]; then
    echo "$name: exit $status, expected $expected" >&2
    cat "$root/term.out" >&2 || true
    exit 1
  fi
  if [[ "$sudo_mode" == hang ]]; then
    local pid
    pid="$(cat "$root/owned-pid")"
    if kill -0 "$pid" 2>/dev/null; then
      echo "$name: owned sleep $pid still running" >&2
      exit 1
    fi
  fi
  printf 'ok: %s\n' "$name"
}

extract_function
run_case "boundary does not cancel a finishing sudo" boundary finish 0
run_case "a real hang still times out" expired hang 124
printf 'ok: mas auth deadline\n'
